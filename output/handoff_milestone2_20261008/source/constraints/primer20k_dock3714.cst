// Tang Primer 20K + Dock 3714 first bring-up pins.
IO_LOC "clk_27m" H11;
IO_PORT "clk_27m" IO_TYPE=LVCMOS33;

IO_LOC "hp_bck" N15;
IO_PORT "hp_bck" IO_TYPE=LVCMOS33;

IO_LOC "hp_ws" P16;
IO_PORT "hp_ws" IO_TYPE=LVCMOS33;

IO_LOC "hp_din" P15;
IO_PORT "hp_din" IO_TYPE=LVCMOS33;

IO_LOC "pa_en" R16;
IO_PORT "pa_en" IO_TYPE=LVCMOS33;

IO_LOC "led" N16;
IO_PORT "led" IO_TYPE=LVCMOS33;

// First two non-reset user keys. S0/T10 is FPGA reset and must not be used here.
IO_LOC "key_s1" T3;
IO_PORT "key_s1" IO_TYPE=LVCMOS15;

IO_LOC "key_s2" T2;
IO_PORT "key_s2" IO_TYPE=LVCMOS15;
