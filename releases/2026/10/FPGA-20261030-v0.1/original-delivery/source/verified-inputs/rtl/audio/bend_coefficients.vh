// Generated by tools/generate_bend_coefficients.py; ADC boundaries 0..4096.
// The final boundary is virtual; the highest actual ADC code is 4095.
function [26:0] fine_coefficient_from_adc;
    input [11:0] code;
    begin
        case(code[11:7])
            5'd0: fine_coefficient_from_adc={17'd58386,10'd423};
            5'd1: fine_coefficient_from_adc={17'd58809,10'd426};
            5'd2: fine_coefficient_from_adc={17'd59235,10'd429};
            5'd3: fine_coefficient_from_adc={17'd59664,10'd433};
            5'd4: fine_coefficient_from_adc={17'd60097,10'd435};
            5'd5: fine_coefficient_from_adc={17'd60532,10'd439};
            5'd6: fine_coefficient_from_adc={17'd60971,10'd442};
            5'd7: fine_coefficient_from_adc={17'd61413,10'd445};
            5'd8: fine_coefficient_from_adc={17'd61858,10'd448};
            5'd9: fine_coefficient_from_adc={17'd62306,10'd451};
            5'd10: fine_coefficient_from_adc={17'd62757,10'd455};
            5'd11: fine_coefficient_from_adc={17'd63212,10'd458};
            5'd12: fine_coefficient_from_adc={17'd63670,10'd462};
            5'd13: fine_coefficient_from_adc={17'd64132,10'd464};
            5'd14: fine_coefficient_from_adc={17'd64596,10'd469};
            5'd15: fine_coefficient_from_adc={17'd65065,10'd471};
            5'd16: fine_coefficient_from_adc={17'd65536,10'd475};
            5'd17: fine_coefficient_from_adc={17'd66011,10'd479};
            5'd18: fine_coefficient_from_adc={17'd66490,10'd482};
            5'd19: fine_coefficient_from_adc={17'd66972,10'd485};
            5'd20: fine_coefficient_from_adc={17'd67457,10'd489};
            5'd21: fine_coefficient_from_adc={17'd67946,10'd493};
            5'd22: fine_coefficient_from_adc={17'd68439,10'd496};
            5'd23: fine_coefficient_from_adc={17'd68935,10'd500};
            5'd24: fine_coefficient_from_adc={17'd69435,10'd503};
            5'd25: fine_coefficient_from_adc={17'd69938,10'd507};
            5'd26: fine_coefficient_from_adc={17'd70445,10'd511};
            5'd27: fine_coefficient_from_adc={17'd70956,10'd515};
            5'd28: fine_coefficient_from_adc={17'd71471,10'd518};
            5'd29: fine_coefficient_from_adc={17'd71989,10'd522};
            5'd30: fine_coefficient_from_adc={17'd72511,10'd525};
            5'd31: fine_coefficient_from_adc={17'd73036,10'd530};
            default: fine_coefficient_from_adc={17'd65536,10'd0};
        endcase
    end
endfunction
function [16:0] fine_ratio_from_adc;
    input [11:0] code;
    reg [26:0] coefficient;
    reg [16:0] product;
    integer bit_index;
    begin
        coefficient=fine_coefficient_from_adc(code);
        product=17'd64; // Round the interpolation product once.
        for(bit_index=0;bit_index<7;bit_index=bit_index+1)
            if(code[bit_index]) product=product+({7'd0,coefficient[9:0]}<<bit_index);
        fine_ratio_from_adc=coefficient[26:10]+(product>>7);
    end
endfunction
