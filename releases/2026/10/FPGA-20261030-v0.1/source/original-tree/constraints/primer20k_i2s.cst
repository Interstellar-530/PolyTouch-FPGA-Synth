// Tang Primer 20K + Dock 3714 pins —— 标准 I2S 档（构建入口 build/isolated/top_std_build.v）。
//
// 本档只驱动外置 PCM5102A 路径：16 路 GPIO 键、UART 调试口、4 个用户 LED、MCP3208 SPI
// 与 I2S/XSMT/12.288 MHz 时钟。板载 PT8211 三线、pa_en 与 clip_fold 不在本档的端口表里
// （由封装在内部消化），所以这里没有它们的引脚定义，也不存在未约束端口。
//
// 引脚来源：docs/hardware/FPGA-pinplan-20261013-v0.1.csv 与同目录硬件连接文档。
// J5/J6/J14 每个排针只有 8 个信号脚（5..12），本档用满 J6 与 J14 的相应位置。
// 标准档与调试档点流互斥：两档的音频接口接线不能同时插在板子上。

// 外置 12.288 MHz 有源晶振（3.3 V CMOS，源端串约 33 ohm），走 GCLKT_3。
IO_LOC "clk_12m288" T7;
IO_PORT "clk_12m288" IO_TYPE=LVCMOS33;

// 标准 I2S（Philips）三线到 PCM5102A，按 3.072 MHz BCK 规划，驱动 8 mA。
IO_LOC "i2s_bck" B12;
IO_PORT "i2s_bck" IO_TYPE=LVCMOS33 DRIVE=8;

IO_LOC "i2s_lrck" C12;
IO_PORT "i2s_lrck" IO_TYPE=LVCMOS33 DRIVE=8;

IO_LOC "i2s_din" B13;
IO_PORT "i2s_din" IO_TYPE=LVCMOS33 DRIVE=8;

// PCM5102A 软静音：本档恒为高（解除静音）。静态电平，取 4 mA 降低边沿耦合。
IO_LOC "dac_xsmt" P6;
IO_PORT "dac_xsmt" IO_TYPE=LVCMOS33 DRIVE=4;

// S3 / D7 是同步设计复位。T10（S0）是配置 SSPI 保留脚、S4/B10 是 RECONFIG_N，都不能用。
IO_LOC "key_rst" D7;
IO_PORT "key_rst" IO_TYPE=LVCMOS15;

// S1 与 S2 用户键，底板上拉到 +1V5。
IO_LOC "key_s1" T3;
IO_PORT "key_s1" IO_TYPE=LVCMOS15;

IO_LOC "key_s2" T2;
IO_PORT "key_s2" IO_TYPE=LVCMOS15;

// BL702 USB-UART 桥（底板 3714 原理图第 1 页）：M11 -> BL702_UART1_RX，T13 <- BL702_UART1_TX。
// 两脚都在 Bank 2，该 Bank 因同时承载 JTAG 而被底板锁定在 3.3 V。
IO_LOC "uart_tx" M11;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 DRIVE=4;

IO_LOC "uart_rx" T13;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33;

// 用户 LED，低有效。N16 = 曲目循环标记；N14 = 伴奏集；L14/L16 = 速度档位二进制。
IO_LOC "led" N16;
IO_PORT "led" IO_TYPE=LVCMOS33 DRIVE=4;

IO_LOC "led_chord" N14;
IO_PORT "led_chord" IO_TYPE=LVCMOS33 DRIVE=4;

IO_LOC "led_t0" L14;
IO_PORT "led_t0" IO_TYPE=LVCMOS33 DRIVE=4;

IO_LOC "led_t1" L16;
IO_PORT "led_t1" IO_TYPE=LVCMOS33 DRIVE=4;

// 12 路 GPIO 琴键。低有效、外部 10 kΩ 上拉到 3.3 V，按下接地。
// Bank 3 固定 3.3 V；Bank 1/7 按核心板默认 R5/R9 配置为 3.3 V，因此统一 LVCMOS33。
// 这些约束仍属草稿：上板前先确认 Bank 电压并跑一遍综合/布局，报冲突就先删掉本段。
IO_LOC "gpio_key_n[0]" L9;      // J5-5   C4
IO_PORT "gpio_key_n[0]" IO_TYPE=LVCMOS33;
IO_LOC "gpio_key_n[1]" N8;      // J5-6   C#4
IO_PORT "gpio_key_n[1]" IO_TYPE=LVCMOS33;
IO_LOC "gpio_key_n[2]" P9;      // J14-5  D4
IO_PORT "gpio_key_n[2]" IO_TYPE=LVCMOS33;
IO_LOC "gpio_key_n[3]" N7;      // J5-8   D#4
IO_PORT "gpio_key_n[3]" IO_TYPE=LVCMOS33;
IO_LOC "gpio_key_n[4]" A14;     // J6-8   E4
IO_PORT "gpio_key_n[4]" IO_TYPE=LVCMOS33;
IO_LOC "gpio_key_n[5]" B14;     // J6-9   F4
IO_PORT "gpio_key_n[5]" IO_TYPE=LVCMOS33;
IO_LOC "gpio_key_n[6]" A15;     // J6-10  F#4
IO_PORT "gpio_key_n[6]" IO_TYPE=LVCMOS33;
IO_LOC "gpio_key_n[7]" D14;     // J6-11  G4
IO_PORT "gpio_key_n[7]" IO_TYPE=LVCMOS33;
IO_LOC "gpio_key_n[8]" E15;     // J6-12  G#4
IO_PORT "gpio_key_n[8]" IO_TYPE=LVCMOS33;
IO_LOC "gpio_key_n[9]" T8;      // J14-7  A4
IO_PORT "gpio_key_n[9]" IO_TYPE=LVCMOS33;
IO_LOC "gpio_key_n[10]" P8;     // J14-8  A#4
IO_PORT "gpio_key_n[10]" IO_TYPE=LVCMOS33;
IO_LOC "gpio_key_n[11]" R8;     // J14-9  B4
IO_PORT "gpio_key_n[11]" IO_TYPE=LVCMOS33;

// MCP3208 SPI：CH0 = 压力 FSR，CH1 = 弯音电位器。Bank 3/7 均按 3.3 V 规划。
// 仍属草稿：上板前按到货验收流程核对接线与 Bank 电压。
IO_LOC "adc_cs_n" N6;
IO_PORT "adc_cs_n" IO_TYPE=LVCMOS33 DRIVE=4;
IO_LOC "adc_sck" D11;
IO_PORT "adc_sck" IO_TYPE=LVCMOS33 DRIVE=4;
IO_LOC "adc_mosi" A11;
IO_PORT "adc_mosi" IO_TYPE=LVCMOS33 DRIVE=4;
IO_LOC "adc_miso" B11;
IO_PORT "adc_miso" IO_TYPE=LVCMOS33;
