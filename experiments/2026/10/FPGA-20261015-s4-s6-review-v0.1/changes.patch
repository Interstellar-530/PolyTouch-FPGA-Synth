diff --git a/archive/FPGA-20261015-v0.10/source/rtl/audio/wavetable_osc_dual_s6.v b/archive/FPGA-20261015-v0.10/source/rtl/audio/wavetable_osc_dual_s6.v
new file mode 100644
index 0000000..9250337
--- /dev/null
+++ b/archive/FPGA-20261015-v0.10/source/rtl/audio/wavetable_osc_dual_s6.v
@@ -0,0 +1,81 @@
+// S6 synchronous dual-table phase reader with linear interpolation.
+//
+// `phase` uses the same split as dds_osc.v: bits [31:23] address a 512-point
+// table and bits [22:14] are a 9-bit interpolation fraction.  Both adjacent
+// entries of both tables are sampled on a clock edge.  sample_q is produced
+// from the previously sampled entries, so the model has an explicit one-clock
+// ROM/output latency.  The two array ports map to true dual-port Gowin ROM
+// IPs in hardware; this behavioral form keeps the simulation deterministic.
+module wavetable_osc_dual_s6 #(
+    parameter integer DEPTH = 512,
+    parameter SINE_INIT = "rtl/audio/wave_sine.hex",
+    parameter BRIGHT_INIT = "rtl/audio/wave_bright.hex"
+) (
+    input  wire               clk,
+    input  wire               rst,
+    input  wire               en,
+    input  wire [31:0]        phase,
+    input  wire               mix_enable,
+    input  wire [7:0]         mix_weight,
+    output reg signed [15:0]  sample_q
+);
+
+    reg signed [15:0] sine_rom [0:DEPTH-1];
+    reg signed [15:0] bright_rom [0:DEPTH-1];
+    reg signed [15:0] sine_a_q, sine_b_q, bright_a_q, bright_b_q;
+
+    wire [8:0] idx_a = phase[31:23];
+    wire [8:0] idx_b = idx_a + 9'd1;
+    wire [8:0] frac = phase[22:14];
+
+    initial begin
+        $readmemh(SINE_INIT, sine_rom);
+        $readmemh(BRIGHT_INIT, bright_rom);
+    end
+
+    wire signed [16:0] sine_diff = $signed(sine_b_q) - $signed(sine_a_q);
+    wire signed [16:0] bright_diff = $signed(bright_b_q) - $signed(bright_a_q);
+    wire signed [9:0] frac_ext = $signed({1'b0, frac});
+    wire signed [26:0] sine_diff_ext = {{10{sine_diff[16]}}, sine_diff};
+    wire signed [26:0] bright_diff_ext = {{10{bright_diff[16]}}, bright_diff};
+    wire signed [26:0] frac_wide = {{17{frac_ext[9]}}, frac_ext};
+    wire signed [53:0] sine_prod_full = sine_diff_ext * frac_wide;
+    wire signed [53:0] bright_prod_full = bright_diff_ext * frac_wide;
+    wire signed [26:0] sine_prod = sine_prod_full[26:0];
+    wire signed [26:0] bright_prod = bright_prod_full[26:0];
+    wire signed [17:0] sine_interp = $signed(sine_a_q) + ((sine_prod + 27'sd256) >>> 9);
+    wire signed [17:0] bright_interp = $signed(bright_a_q) + ((bright_prod + 27'sd256) >>> 9);
+
+    wire signed [24:0] sine_ext = {{7{sine_interp[17]}}, sine_interp};
+    wire signed [24:0] bright_ext = {{7{bright_interp[17]}}, bright_interp};
+    wire signed [24:0] sine_weight = {17'd0, (8'hff - mix_weight)};
+    wire signed [24:0] bright_weight = {17'd0, mix_weight};
+    wire signed [49:0] sine_mix_prod = sine_ext * sine_weight;
+    wire signed [49:0] bright_mix_prod = bright_ext * bright_weight;
+    wire signed [25:0] blend_sum = sine_mix_prod[25:0] + bright_mix_prod[25:0] + 26'sd127;
+    wire signed [25:0] blend = blend_sum >>> 8;
+    wire signed [17:0] selected = mix_enable ? blend[17:0] :
+                                   (mix_weight[7] ? bright_interp : sine_interp);
+    wire selected_clip_hi = selected > 18'sd32767;
+    wire selected_clip_lo = selected < -18'sd32768;
+    wire signed [15:0] selected_sat =
+        selected_clip_hi ? 16'sd32767 :
+        selected_clip_lo ? -16'sd32768 : selected[15:0];
+
+    always @(posedge clk) begin
+        if (rst) begin
+            sine_a_q   <= 16'sd0;
+            sine_b_q   <= 16'sd0;
+            bright_a_q <= 16'sd0;
+            bright_b_q <= 16'sd0;
+            sample_q   <= 16'sd0;
+        end else if (en) begin
+            sample_q   <= selected_sat;
+            sine_a_q   <= sine_rom[idx_a];
+            sine_b_q   <= sine_rom[idx_b];
+            bright_a_q <= bright_rom[idx_a];
+            bright_b_q <= bright_rom[idx_b];
+        end
+    end
+
+endmodule
diff --git a/archive/FPGA-20261015-v0.10/source/rtl/audio/wavetable_rom_dual.v b/archive/FPGA-20261015-v0.10/source/rtl/audio/wavetable_rom_dual.v
new file mode 100644
index 0000000..c738a04
--- /dev/null
+++ b/archive/FPGA-20261015-v0.10/source/rtl/audio/wavetable_rom_dual.v
@@ -0,0 +1,75 @@
+// S6 dual 512-point wavetable wrapper.
+//
+// The generic model below has the same contract as a Gowin BSRAM ROM wrapper:
+// both memories are read synchronously, so an address presented before a
+// rising edge appears at sine_q/bright_q after that edge.  A production Gowin
+// build can replace the two array declarations/always block with generated
+// pROM/BSRAM instances without changing the module interface.  The behavioral
+// model is deliberately kept here for deterministic RTL simulation.
+//
+// `mix_weight` is an unsigned 8-bit cross-fade (0 = sine, 8'hff = bright).
+// With `mix_enable=0`, its high bit selects a table exactly; with
+// `mix_enable=1`, the full 8-bit value blends the registered outputs.  The
+// output is saturated before it is exposed as a signed sample.
+module wavetable_rom_dual #(
+    parameter integer DEPTH = 512,
+    parameter integer ADDR_WIDTH = 9,
+    parameter SINE_INIT = "rtl/audio/wave_sine.hex",
+    parameter BRIGHT_INIT = "rtl/audio/wave_bright.hex"
+) (
+    input  wire                    clk,
+    input  wire                    en,
+    input  wire [ADDR_WIDTH-1:0]   addr,
+    input  wire                    mix_enable,
+    input  wire [7:0]              mix_weight,
+    output reg  signed [15:0]      sine_q,
+    output reg  signed [15:0]      bright_q,
+    output wire signed [15:0]      sample_q
+);
+
+    // The exact dimensions are part of the S6 acceptance contract.  Do not
+    // replace these arrays with a large case statement: Gowin BSRAM inference
+    // or generated ROM IP is required for hardware.
+    reg signed [15:0] sine_rom [0:DEPTH-1];
+    reg signed [15:0] bright_rom [0:DEPTH-1];
+
+    initial begin
+        $readmemh(SINE_INIT, sine_rom);
+        $readmemh(BRIGHT_INIT, bright_rom);
+    end
+
+    always @(posedge clk) begin
+        if (en) begin
+            sine_q   <= sine_rom[addr];
+            bright_q <= bright_rom[addr];
+        end
+    end
+
+    // Registered ROM samples are sign-extended before blending.  Explicitly
+    // wide operands avoid Verilog's context-dependent multiplication width.
+    // The 25-bit products and 26-bit sum cover both weighted 16-bit samples.
+    wire signed [24:0] sine_ext = {{9{sine_q[15]}}, sine_q};
+    wire signed [24:0] bright_ext = {{9{bright_q[15]}}, bright_q};
+    wire signed [24:0] sine_weight = {17'd0, (8'hff - mix_weight)};
+    wire signed [24:0] bright_weight = {17'd0, mix_weight};
+    wire signed [49:0] sine_prod_full = sine_ext * sine_weight;
+    wire signed [49:0] bright_prod_full = bright_ext * bright_weight;
+    wire signed [25:0] blend_sum = sine_prod_full[25:0] + bright_prod_full[25:0] + 26'sd127;
+    wire signed [25:0] blend_value = blend_sum >>> 8;
+    wire signed [15:0] blend_value_sat =
+        (blend_value > 26'sd32767)  ? 16'sd32767 :
+        (blend_value < -26'sd32768) ? -16'sd32768 : blend_value[15:0];
+    reg signed [15:0] selected_table;
+    always @* begin
+        if (mix_weight[7])
+            selected_table = bright_q;
+        else
+            selected_table = sine_q;
+        // synthesis translate_off
+        // synthesis translate_on
+    end
+
+    assign sample_q = mix_enable ? blend_value_sat : selected_table;
+
+endmodule
+
diff --git a/archive/FPGA-20261015-v0.10/source/sim/run_simulation.ps1 b/archive/FPGA-20261015-v0.10/source/sim/run_simulation.ps1
new file mode 100644
index 0000000..651442b
--- /dev/null
+++ b/archive/FPGA-20261015-v0.10/source/sim/run_simulation.ps1
@@ -0,0 +1,138 @@
+<#
+    RTL 仿真门禁。
+
+    编译并运行全部测试台，任何一个失败都以退出码 1 结束。烧录脚本在调用
+    programmer_cli 之前必须先跑这个脚本，仿真不过就拒绝烧录。
+
+    测试台各管一段：
+      tb_tick_rate    量 PT8211 的采样节拍周期，只有 576 个 27 MHz 时钟才算对
+      tb_song_timing  量一遍曲子实际占多少采样节拍、发了多少个音符事件
+      tb_poly         量顶层连线：复位、默认速度档位、两个按键
+      tb_adsr         覆盖各阶段松键、释放归零与快速重按
+      tb_voice_retrigger  覆盖同音重按、满声部窃取与释放声部复用
+      tb_voice_order  覆盖长时间演奏后的最老声部判断
+      tb_event_fifo   覆盖空满保护、满队列同拍读写和顺序
+      tb_song_backpressure 覆盖播放器保持未被接收的事件
+      tb_mode_uart   覆盖串口到顶层模式/事件路径；强制加速采样，非真实音频捕获
+      tb_mcp3208_spi 覆盖 MCP3208 完整 19 拍 DS21298E 事务、边界码、双通道、固定种子随机值和帧内复位恢复
+      tb_mcp3208_i2s_coexist 覆盖 ADC 事务与 PT8211 音频节拍并行、tick 仍为 576 拍
+      tb_mcp3208_params 覆盖 27 MHz/250 kHz 生产参数、分频钳位和 SPI_HZ=0 的守护
+      tb_pressure_bend 与 Python 参考逐值对照（640 个压力 tick、4096 个弯音 ADC 码）并覆盖 t90、弯音边界和持音不重启
+      tb_s6_audio    覆盖双同步 ROM、相位插值/环绕、交叉混音、FIR 和削波计数
+#>
+param(
+    [string]$Iverilog = '',
+    [string]$Vvp = ''
+)
+
+$ErrorActionPreference = 'Stop'
+$sourceRoot = (Resolve-Path -LiteralPath (Join-Path $PSScriptRoot '..')).Path
+
+function Find-Tool {
+    param([string]$Name, [string]$FromEnv, [string[]]$Candidates)
+    if ($FromEnv) { return $FromEnv }
+    foreach ($c in $Candidates) {
+        if (Test-Path -LiteralPath $c -PathType Leaf) { return $c }
+    }
+    $found = Get-Command $Name -ErrorAction SilentlyContinue
+    if ($found) { return $found.Source }
+    return ''
+}
+
+$iverilogCandidates = @('C:\iverilog\bin\iverilog.exe')
+$vvpCandidates = @('C:\iverilog\bin\vvp.exe')
+foreach ($pf in @($env:ProgramFiles, ${env:ProgramFiles(x86)})) {
+    if ($pf) {
+        $iverilogCandidates += (Join-Path $pf 'iverilog\bin\iverilog.exe')
+        $vvpCandidates += (Join-Path $pf 'iverilog\bin\vvp.exe')
+    }
+}
+
+if (-not $Iverilog) { $Iverilog = Find-Tool -Name 'iverilog' -FromEnv $env:IVERILOG -Candidates $iverilogCandidates }
+if (-not $Vvp)      { $Vvp      = Find-Tool -Name 'vvp'      -FromEnv $env:VVP      -Candidates $vvpCandidates }
+
+if (-not $Iverilog -or -not (Test-Path -LiteralPath $Iverilog -PathType Leaf)) {
+    Write-Error "找不到 iverilog。安装 Icarus Verilog，或用 -Iverilog 指定路径。仿真门禁无法跳过。"
+    exit 1
+}
+if (-not $Vvp -or -not (Test-Path -LiteralPath $Vvp -PathType Leaf)) {
+    Write-Error "找不到 vvp。安装 Icarus Verilog，或用 -Vvp 指定路径。仿真门禁无法跳过。"
+    exit 1
+}
+
+Push-Location $sourceRoot
+try {
+    $suite = @(
+        @{ Name = 'tb_tick_rate';   Top = 'sim\tb_tick_rate.v';   Src = @('rtl\audio\pt8211_tx.v') },
+        @{ Name = 'tb_song_timing'; Top = 'sim\tb_song_timing.v'; Src = @('rtl\audio\song_player.v') },
+        @{ Name = 'tb_adsr';        Top = 'sim\tb_adsr.v';        Src = @('rtl\audio\adsr.v') },
+        @{ Name = 'tb_voice_retrigger'; Top = 'sim\tb_voice_retrigger.v'; Src = @(
+                'rtl\audio\voice_alloc.v', 'rtl\audio\poly_voice.v',
+                'rtl\audio\adsr.v', 'rtl\audio\dds_osc.v', 'rtl\audio\note_phase_inc.v') },
+        @{ Name = 'tb_voice_order'; Top = 'sim\tb_voice_order.v'; Src = @('rtl\audio\voice_alloc.v') },
+        @{ Name = 'tb_event_fifo'; Top = 'sim\tb_event_fifo.v'; Src = @('rtl\audio\event_fifo.v') },
+        @{ Name = 'tb_song_backpressure'; Top = 'sim\tb_song_backpressure.v'; Src = @('rtl\audio\song_player.v') },
+        @{ Name = 'tb_mode_uart'; Top = 'sim\tb_mode_uart.v'; Src = @(
+                'rtl\top.v',
+                'rtl\audio\dds_osc.v', 'rtl\audio\adsr.v', 'rtl\audio\poly_voice.v',
+                'rtl\audio\note_phase_inc.v', 'rtl\audio\event_fifo.v',
+                'rtl\audio\voice_alloc.v', 'rtl\audio\song_player.v',
+                'rtl\audio\mixer.v', 'rtl\audio\pt8211_tx.v', 'rtl\audio\uart_ctrl.v') },
+        @{ Name = 'tb_poly';        Top = 'sim\tb_poly.v';        Src = @(
+                'rtl\top.v',
+                'rtl\audio\dds_osc.v', 'rtl\audio\adsr.v', 'rtl\audio\poly_voice.v',
+                'rtl\audio\note_phase_inc.v', 'rtl\audio\event_fifo.v',
+                'rtl\audio\voice_alloc.v', 'rtl\audio\song_player.v',
+                'rtl\audio\mixer.v', 'rtl\audio\pt8211_tx.v', 'rtl\audio\uart_ctrl.v') },
+        @{ Name = 'tb_mcp3208_spi'; Top = 'sim\tb_mcp3208_spi.v'; Src = @(
+                'rtl\audio\mcp3208_spi.v', 'sim\mcp3208_model.v') },
+        @{ Name = 'tb_mcp3208_i2s_coexist'; Top = 'sim\tb_mcp3208_i2s_coexist.v'; Src = @(
+                'rtl\audio\mcp3208_spi.v', 'rtl\audio\pt8211_tx.v',
+                'sim\mcp3208_model.v') },
+        @{ Name = 'tb_mcp3208_params'; Top = 'sim\tb_mcp3208_params.v'; Src = @(
+                'rtl\audio\mcp3208_spi.v', 'sim\mcp3208_model.v') },
+        @{ Name = 'tb_pressure_bend'; Top = 'sim\tb_pressure_bend.v'; Src = @(
+                'rtl\audio\pressure_bend.v', 'rtl\audio\adsr.v') },
+        @{ Name = 'tb_s6_audio'; Top = 'sim\tb_s6_audio.v'; Src = @(
+                'rtl\audio\wavetable_rom_dual.v', 'rtl\audio\wavetable_osc_dual_s6.v',
+                'rtl\audio\mixer_s6.v') }
+    )
+
+    $failed = 0
+    foreach ($test in $suite) {
+        $out = Join-Path $sourceRoot ("sim\{0}.vvp" -f $test.Name)
+        Write-Output ("=== {0} ===" -f $test.Name)
+
+        $compileArgs = @('-g2012', '-I', '.', '-o', $out, $test.Top) + $test.Src
+        & $Iverilog @compileArgs
+        if ($LASTEXITCODE -ne 0) {
+            Write-Output ("编译失败：{0}" -f $test.Name)
+            $failed++
+            Remove-Item -LiteralPath $out -Force -ErrorAction SilentlyContinue
+            continue
+        }
+
+        try {
+            & $Vvp $out
+            if ($LASTEXITCODE -ne 0) {
+                Write-Output ("仿真失败：{0}" -f $test.Name)
+                $failed++
+            }
+        }
+        finally {
+            # .vvp files are reproducible build temporaries; keep the source
+            # tree clean after both PASS and failure.
+            Remove-Item -LiteralPath $out -Force -ErrorAction SilentlyContinue
+        }
+    }
+
+    if ($failed -ne 0) {
+        Write-Output ("仿真门禁未通过，{0} 个测试台失败，禁止烧录。" -f $failed)
+        exit 1
+    }
+    Write-Output "全部测试台通过，允许烧录。"
+    exit 0
+}
+finally {
+    Pop-Location
+}
diff --git a/archive/FPGA-20261015-v0.10/source/sim/tb_s6_audio.v b/archive/FPGA-20261015-v0.10/source/sim/tb_s6_audio.v
new file mode 100644
index 0000000..45158ec
--- /dev/null
+++ b/archive/FPGA-20261015-v0.10/source/sim/tb_s6_audio.v
@@ -0,0 +1,341 @@
+`timescale 1ns/1ps
+// S6 self-checking testbench, independent review revision (2026-10-15).
+//
+// The delivered checks (synchronous ROM read, table select, 50/50 blend,
+// saturation without wrap, clip count/clear, FIR register boundary) are kept.
+// On top of them every datapath is now compared value by value against
+// tools/s6_reference.py vectors:
+//   * 2560 phases (all 512 addresses x 5 interpolation fractions, including
+//     the 511 -> 0 wrap seam) through the interpolating reader,
+//   * 1024 ROM cross-fade points (4 addresses x all 256 weights) and 256
+//     interpolated cross-fade points,
+//   * 510 mixer samples across VOLUME_SHIFT 0/1/2 and FIR on/off, checking the
+//     saturated output, the per-frame clip_event and the running clip count,
+//   * a 32-sample small-amplitude FIR sequence that pins unity DC gain (the
+//     delivered revision used a centre tap of 8, i.e. 18/16 gain, which the
+//     old full-scale-only check could not see).
+//
+// Regenerate the vectors with:
+//   python tools/s6_reference.py --vectors output/handoff_milestone2_20261008/source/sim/vectors
+module tb_s6_audio;
+    localparam integer OSC_VECTORS       = 3584;
+    localparam integer BLEND_VECTORS     = 768;
+    localparam integer ROM_BLEND_VECTORS = 1024;
+    localparam integer OSC_BLEND_VECTORS = 256;
+    localparam integer MIX_VECTORS       = 510;
+    localparam integer FIR_VECTORS       = 32;
+
+    reg clk = 1'b0;
+    always #5 clk = ~clk;
+    reg rst = 1'b1;
+
+    reg en = 1'b0;
+    reg [8:0] addr = 9'd0;
+    reg mix_enable = 1'b0;
+    reg [7:0] mix_weight = 8'd0;
+    wire signed [15:0] sine_q, bright_q, sample_q;
+
+    wavetable_rom_dual dut_rom (
+        .clk(clk), .en(en), .addr(addr), .mix_enable(mix_enable),
+        .mix_weight(mix_weight), .sine_q(sine_q), .bright_q(bright_q),
+        .sample_q(sample_q)
+    );
+
+    reg osc_en = 1'b0;
+    reg [31:0] phase = 32'd0;
+    reg osc_mix_enable = 1'b0;
+    reg [7:0] osc_mix_weight = 8'd0;
+    wire signed [15:0] osc_sample;
+    wavetable_osc_dual_s6 dut_osc (
+        .clk(clk), .rst(rst), .en(osc_en), .phase(phase),
+        .mix_enable(osc_mix_enable), .mix_weight(osc_mix_weight),
+        .sample_q(osc_sample)
+    );
+
+    reg sample_tick = 1'b0;
+    reg clear_clip = 1'b0;
+    reg signed [15:0] v0 = 0, v1 = 0, v2 = 0, v3 = 0;
+
+    wire signed [15:0] m_s0_off, m_s1_off, m_s2_off, m_s0_on, m_s1_on, m_s2_on;
+    wire [7:0] c_s0_off, c_s1_off, c_s2_off, c_s0_on, c_s1_on, c_s2_on;
+    wire e_s0_off, e_s1_off, e_s2_off, e_s0_on, e_s1_on, e_s2_on;
+
+    mixer_s6 #(.VOLUME_SHIFT(0), .FIR_ENABLE(0), .CLIP_COUNTER_WIDTH(8)) u_m_s0_off (
+        .clk(clk), .rst(rst), .sample_tick(sample_tick), .clear_clip(clear_clip),
+        .v0(v0), .v1(v1), .v2(v2), .v3(v3), .sample_out(m_s0_off),
+        .clip_count(c_s0_off), .clip_event(e_s0_off));
+    mixer_s6 #(.VOLUME_SHIFT(1), .FIR_ENABLE(0), .CLIP_COUNTER_WIDTH(8)) u_m_s1_off (
+        .clk(clk), .rst(rst), .sample_tick(sample_tick), .clear_clip(clear_clip),
+        .v0(v0), .v1(v1), .v2(v2), .v3(v3), .sample_out(m_s1_off),
+        .clip_count(c_s1_off), .clip_event(e_s1_off));
+    mixer_s6 #(.VOLUME_SHIFT(2), .FIR_ENABLE(0), .CLIP_COUNTER_WIDTH(8)) u_m_s2_off (
+        .clk(clk), .rst(rst), .sample_tick(sample_tick), .clear_clip(clear_clip),
+        .v0(v0), .v1(v1), .v2(v2), .v3(v3), .sample_out(m_s2_off),
+        .clip_count(c_s2_off), .clip_event(e_s2_off));
+    mixer_s6 #(.VOLUME_SHIFT(0), .FIR_ENABLE(1), .CLIP_COUNTER_WIDTH(8)) u_m_s0_on (
+        .clk(clk), .rst(rst), .sample_tick(sample_tick), .clear_clip(clear_clip),
+        .v0(v0), .v1(v1), .v2(v2), .v3(v3), .sample_out(m_s0_on),
+        .clip_count(c_s0_on), .clip_event(e_s0_on));
+    mixer_s6 #(.VOLUME_SHIFT(1), .FIR_ENABLE(1), .CLIP_COUNTER_WIDTH(8)) u_m_s1_on (
+        .clk(clk), .rst(rst), .sample_tick(sample_tick), .clear_clip(clear_clip),
+        .v0(v0), .v1(v1), .v2(v2), .v3(v3), .sample_out(m_s1_on),
+        .clip_count(c_s1_on), .clip_event(e_s1_on));
+    mixer_s6 #(.VOLUME_SHIFT(2), .FIR_ENABLE(1), .CLIP_COUNTER_WIDTH(8)) u_m_s2_on (
+        .clk(clk), .rst(rst), .sample_tick(sample_tick), .clear_clip(clear_clip),
+        .v0(v0), .v1(v1), .v2(v2), .v3(v3), .sample_out(m_s2_on),
+        .clip_count(c_s2_on), .clip_event(e_s2_on));
+
+    // ---- vectors ---------------------------------------------------------
+    reg [31:0] osc_phase [0:OSC_VECTORS-1];
+    reg [15:0] osc_sine_exp [0:OSC_VECTORS-1];
+    reg [15:0] osc_bright_exp [0:OSC_VECTORS-1];
+    reg [15:0] bl_a [0:BLEND_VECTORS-1];
+    reg [15:0] bl_b [0:BLEND_VECTORS-1];
+    reg [7:0]  bl_w [0:BLEND_VECTORS-1];
+    reg [15:0] bl_exp [0:BLEND_VECTORS-1];
+    reg [8:0]  rb_addr [0:ROM_BLEND_VECTORS-1];
+    reg [7:0]  rb_w [0:ROM_BLEND_VECTORS-1];
+    reg [15:0] rb_exp [0:ROM_BLEND_VECTORS-1];
+    reg [31:0] ob_phase [0:OSC_BLEND_VECTORS-1];
+    reg [7:0]  ob_w [0:OSC_BLEND_VECTORS-1];
+    reg [15:0] ob_exp [0:OSC_BLEND_VECTORS-1];
+    reg [15:0] mx_v0 [0:MIX_VECTORS-1], mx_v1 [0:MIX_VECTORS-1];
+    reg [15:0] mx_v2 [0:MIX_VECTORS-1], mx_v3 [0:MIX_VECTORS-1];
+    reg [3:0]  mx_shift [0:MIX_VECTORS-1];
+    reg [3:0]  mx_fir [0:MIX_VECTORS-1];
+    reg [15:0] mx_exp [0:MIX_VECTORS-1];
+    reg [3:0]  mx_rawclip [0:MIX_VECTORS-1];
+    reg [3:0]  mx_firclip [0:MIX_VECTORS-1];
+    reg [7:0]  mx_count [0:MIX_VECTORS-1];
+    reg [15:0] fir_in [0:FIR_VECTORS-1];
+    reg [15:0] fir_exp [0:FIR_VECTORS-1];
+
+    integer failures;
+    integer i, k, idx;
+    reg signed [15:0] cur_out;
+    reg cur_ev;
+    reg [7:0] cur_cnt;
+
+    task tick;
+        begin
+            sample_tick = 1'b1;
+            @(posedge clk);
+            #1 sample_tick = 1'b0;
+        end
+    endtask
+
+    initial begin
+        $readmemh("sim/vectors/osc_phase.hex", osc_phase);
+        $readmemh("sim/vectors/osc_sine_expected.hex", osc_sine_exp);
+        $readmemh("sim/vectors/osc_bright_expected.hex", osc_bright_exp);
+        $readmemh("sim/vectors/blend_a.hex", bl_a);
+        $readmemh("sim/vectors/blend_b.hex", bl_b);
+        $readmemh("sim/vectors/blend_weight.hex", bl_w);
+        $readmemh("sim/vectors/blend_expected.hex", bl_exp);
+        $readmemh("sim/vectors/rom_blend_addr.hex", rb_addr);
+        $readmemh("sim/vectors/rom_blend_weight.hex", rb_w);
+        $readmemh("sim/vectors/rom_blend_expected.hex", rb_exp);
+        $readmemh("sim/vectors/osc_blend_phase.hex", ob_phase);
+        $readmemh("sim/vectors/osc_blend_weight.hex", ob_w);
+        $readmemh("sim/vectors/osc_blend_expected.hex", ob_exp);
+        $readmemh("sim/vectors/mix_v0.hex", mx_v0);
+        $readmemh("sim/vectors/mix_v1.hex", mx_v1);
+        $readmemh("sim/vectors/mix_v2.hex", mx_v2);
+        $readmemh("sim/vectors/mix_v3.hex", mx_v3);
+        $readmemh("sim/vectors/mix_shift.hex", mx_shift);
+        $readmemh("sim/vectors/mix_fir.hex", mx_fir);
+        $readmemh("sim/vectors/mix_expected.hex", mx_exp);
+        $readmemh("sim/vectors/mix_rawclip.hex", mx_rawclip);
+        $readmemh("sim/vectors/mix_firclip.hex", mx_firclip);
+        $readmemh("sim/vectors/mix_count.hex", mx_count);
+        $readmemh("sim/vectors/fir_input.hex", fir_in);
+        $readmemh("sim/vectors/fir_expected.hex", fir_exp);
+    end
+
+    initial begin
+        failures = 0;
+        repeat (2) @(posedge clk);
+        rst = 1'b0;
+
+        // ---- delivered qualitative checks --------------------------------
+        en = 1'b1;
+        addr = 9'd0;
+        @(posedge clk); #1;
+        if (sine_q !== 16'sh0000 || bright_q !== 16'sh0000) begin
+            $display("FAIL ROM address 0 mismatch: sine=%h bright=%h", sine_q, bright_q);
+            failures = failures + 1;
+        end
+        addr = 9'd128;
+        if (sine_q !== 16'sh0000) begin
+            $display("FAIL ROM changed before synchronous edge");
+            failures = failures + 1;
+        end
+        @(posedge clk); #1;
+        if (sine_q !== 16'sh7fff || bright_q !== 16'sh36e6) begin
+            $display("FAIL ROM address 128 mismatch: sine=%h bright=%h", sine_q, bright_q);
+            failures = failures + 1;
+        end
+        mix_enable = 1'b0;
+        mix_weight = 8'hff;
+        #1;
+        if (sample_q !== bright_q) begin
+            $display("FAIL bright table selection mismatch sample=%h bright=%h", sample_q, bright_q);
+            failures = failures + 1;
+        end
+        mix_enable = 1'b1;
+        mix_weight = 8'd128;
+        #1;
+        if ((sample_q > 16'sh5af4) || (sample_q < 16'sh5af2)) begin
+            $display("FAIL 50/50 blend mismatch: %0d", sample_q);
+            failures = failures + 1;
+        end
+
+        // ---- ROM cross-fade: 4 addresses x all 256 weights ---------------
+        mix_enable = 1'b1;
+        for (i = 0; i < ROM_BLEND_VECTORS; i = i + 1) begin
+            if ((i == 0) || (rb_addr[i] !== rb_addr[i-1])) begin
+                addr = rb_addr[i];
+                @(posedge clk); #1;
+            end
+            mix_weight = rb_w[i];
+            #1;
+            if (sample_q !== $signed(rb_exp[i])) begin
+                $display("FAIL rom blend addr=%0d w=%0d: dut=%0d ref=%0d",
+                         rb_addr[i], rb_w[i], sample_q, $signed(rb_exp[i]));
+                failures = failures + 1;
+            end
+        end
+        mix_enable = 1'b0;
+        mix_weight = 8'd0;
+
+        // ---- interpolating reader: every address x five fractions --------
+        osc_en = 1'b1;
+        mix_enable = 1'b0;
+        for (i = 0; i < OSC_VECTORS; i = i + 1) begin
+            phase = osc_phase[i];
+            osc_mix_enable = 1'b0;
+            osc_mix_weight = 8'd0;
+            @(posedge clk);              // request the adjacent entries
+            @(posedge clk); #1;          // expose the interpolated sample
+            if (osc_sample !== $signed(osc_sine_exp[i])) begin
+                $display("FAIL osc sine phase=%h: dut=%0d ref=%0d",
+                         osc_phase[i], osc_sample, $signed(osc_sine_exp[i]));
+                failures = failures + 1;
+            end
+            osc_mix_weight = 8'hff;
+            @(posedge clk); #1;
+            if (osc_sample !== $signed(osc_bright_exp[i])) begin
+                $display("FAIL osc bright phase=%h: dut=%0d ref=%0d",
+                         osc_phase[i], osc_sample, $signed(osc_bright_exp[i]));
+                failures = failures + 1;
+            end
+            osc_mix_weight = 8'd0;
+        end
+
+        // ---- interpolated cross-fade: one phase, all 256 weights ---------
+        phase = ob_phase[0];
+        osc_mix_enable = 1'b1;
+        osc_mix_weight = 8'd0;
+        @(posedge clk);
+        @(posedge clk); #1;
+        for (i = 0; i < OSC_BLEND_VECTORS; i = i + 1) begin
+            osc_mix_weight = ob_w[i];
+            @(posedge clk); #1;
+            if (osc_sample !== $signed(ob_exp[i])) begin
+                $display("FAIL osc blend w=%0d: dut=%0d ref=%0d",
+                         ob_w[i], osc_sample, $signed(ob_exp[i]));
+                failures = failures + 1;
+            end
+        end
+        osc_mix_enable = 1'b0;
+
+        // ---- mixer: 510 vectors over volume shift and FIR path ------------
+        for (i = 0; i < MIX_VECTORS; i = i + 1) begin
+            v0 = mx_v0[i]; v1 = mx_v1[i]; v2 = mx_v2[i]; v3 = mx_v3[i];
+            tick();
+            // the registered output is only valid after the sample tick
+            idx = (mx_shift[i] * 2) + mx_fir[i];
+            case (idx)
+                0: begin cur_out = m_s0_off; cur_ev = e_s0_off; cur_cnt = c_s0_off; end
+                1: begin cur_out = m_s0_on;  cur_ev = e_s0_on;  cur_cnt = c_s0_on;  end
+                2: begin cur_out = m_s1_off; cur_ev = e_s1_off; cur_cnt = c_s1_off; end
+                3: begin cur_out = m_s1_on;  cur_ev = e_s1_on;  cur_cnt = c_s1_on;  end
+                4: begin cur_out = m_s2_off; cur_ev = e_s2_off; cur_cnt = c_s2_off; end
+                default: begin cur_out = m_s2_on; cur_ev = e_s2_on; cur_cnt = c_s2_on; end
+            endcase
+            if (cur_out !== $signed(mx_exp[i])) begin
+                $display("FAIL mixer vec %0d shift=%0d fir=%0d: dut=%0d ref=%0d",
+                         i, mx_shift[i], mx_fir[i], cur_out, $signed(mx_exp[i]));
+                failures = failures + 1;
+            end
+            if (cur_ev !== (mx_rawclip[i] != 0)) begin
+                $display("FAIL mixer vec %0d clip_event=%b raw_clip=%0d",
+                         i, cur_ev, mx_rawclip[i]);
+                failures = failures + 1;
+            end
+            if (cur_cnt !== mx_count[i]) begin
+                $display("FAIL mixer vec %0d clip_count=%0d expected=%0d", i, cur_cnt, mx_count[i]);
+                failures = failures + 1;
+            end
+        end
+
+        // ---- small amplitude FIR sequence: unity gain ---------------------
+        v0 = 0; v1 = 0; v2 = 0; v3 = 0;
+        repeat (4) tick();
+        for (i = 0; i < FIR_VECTORS; i = i + 1) begin
+            v0 = fir_in[i];
+            tick();
+            if (m_s0_on !== $signed(fir_exp[i])) begin
+                $display("FAIL fir vec %0d in=%0d: dut=%0d ref=%0d",
+                         i, $signed(fir_in[i]), m_s0_on, $signed(fir_exp[i]));
+                failures = failures + 1;
+            end
+        end
+        v0 = 0; v1 = 0; v2 = 0; v3 = 0;
+
+        // ---- delivered clip/extrema and FIR boundary checks ---------------
+        v0 = 16'sh7fff; v1 = 16'sh7fff; v2 = 16'sh7fff; v3 = 16'sh7fff;
+        tick();
+        if (m_s1_off !== 16'sh7fff || !e_s1_off) begin
+            $display("FAIL positive saturation sample=%h event=%b", m_s1_off, e_s1_off);
+            failures = failures + 1;
+        end
+        v0 = -16'sh8000; v1 = -16'sh8000; v2 = -16'sh8000; v3 = -16'sh8000;
+        tick();
+        if (m_s1_off !== -16'sh8000 || !e_s1_off) begin
+            $display("FAIL negative saturation sample=%h event=%b", m_s1_off, e_s1_off);
+            failures = failures + 1;
+        end
+        clear_clip = 1'b1;
+        tick();
+        clear_clip = 1'b0;
+        if (c_s1_off !== 8'd0 || c_s1_on !== 8'd0) begin
+            $display("FAIL clip counter did not clear: off=%0d on=%0d", c_s1_off, c_s1_on);
+            failures = failures + 1;
+        end
+
+        v0 = 16'sd0; v1 = 16'sd0; v2 = 16'sd0; v3 = 16'sd0;
+        repeat (4) tick();
+        v0 = 16'sh7fff; v1 = 16'sh7fff; v2 = 16'sh7fff; v3 = 16'sh7fff;
+        tick();
+        if (m_s1_on !== 16'sd2047) begin
+            $display("FAIL FIR first-sample latency/weight mismatch: %0d", m_s1_on);
+            failures = failures + 1;
+        end
+        repeat (4) tick();
+        if (m_s1_on !== 16'sh7fff) begin
+            $display("FAIL FIR steady-state saturation mismatch: %h", m_s1_on);
+            failures = failures + 1;
+        end
+
+        if (failures != 0) $fatal(1, "tb_s6_audio failures=%0d", failures);
+        $display("PASS tb_s6_audio: ROM sync/select, %0d osc vectors, %0d+%0d blend points, %0d mixer vectors, %0d FIR samples",
+                 OSC_VECTORS, ROM_BLEND_VECTORS, OSC_BLEND_VECTORS, MIX_VECTORS, FIR_VECTORS);
+        $finish;
+    end
+
+    initial begin
+        #2_000_000;
+        $fatal(1, "FAIL tb_s6_audio: timeout");
+    end
+endmodule
