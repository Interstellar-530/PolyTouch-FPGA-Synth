+<#
+    RTL 仿真门禁。
+
+    编译并运行全部测试台，任何一个失败都以退出码 1 结束。烧录脚本在调用
+    programmer_cli 之前必须先跑这个脚本，仿真不过就拒绝烧录。
+
+    测试台各管一段：
+      tb_tick_rate    量 PT8211 的采样节拍周期，只有 576 个 27 MHz 时钟才算对
+      tb_song_timing  量一遍曲子实际占多少采样节拍、发了多少个音符事件
+      tb_poly         量顶层连线：复位、默认速度档位、两个按键
+      tb_adsr         覆盖各阶段松键、释放归零与快速重按
+      tb_voice_retrigger  覆盖同音重按、满声部窃取与释放声部复用
+      tb_voice_order  覆盖长时间演奏后的最老声部判断
+      tb_event_fifo   覆盖空满保护、满队列同拍读写和顺序
+      tb_song_backpressure 覆盖播放器保持未被接收的事件
+      tb_mode_uart   覆盖串口到顶层模式/事件路径；强制加速采样，非真实音频捕获
+      tb_mcp3208_spi 覆盖 MCP3208 完整 19 拍 DS21298E 事务、边界码、双通道、固定种子随机值和帧内复位恢复
+      tb_mcp3208_i2s_coexist 覆盖 ADC 事务与 PT8211 音频节拍并行、tick 仍为 576 拍
+      tb_mcp3208_params 覆盖 27 MHz/250 kHz 生产参数、分频钳位和 SPI_HZ=0 的守护
+      tb_pressure_bend 与 Python 参考逐值对照（640 个压力 tick、4096 个弯音 ADC 码）并覆盖 t90、弯音边界和持音不重启
+      tb_s6_audio    覆盖双同步 ROM、相位插值/环绕、交叉混音、FIR 和削波计数
+#>
+param(
+    [string]$Iverilog = '',
+    [string]$Vvp = ''
+)
+
+$ErrorActionPreference = 'Stop'
+$sourceRoot = (Resolve-Path -LiteralPath (Join-Path $PSScriptRoot '..')).Path
+
+function Find-Tool {
+    param([string]$Name, [string]$FromEnv, [string[]]$Candidates)
+    if ($FromEnv) { return $FromEnv }
+    foreach ($c in $Candidates) {
+        if (Test-Path -LiteralPath $c -PathType Leaf) { return $c }
+    }
+    $found = Get-Command $Name -ErrorAction SilentlyContinue
+    if ($found) { return $found.Source }
+    return ''
+}
+
+$iverilogCandidates = @('C:\iverilog\bin\iverilog.exe')
+$vvpCandidates = @('C:\iverilog\bin\vvp.exe')
+foreach ($pf in @($env:ProgramFiles, ${env:ProgramFiles(x86)})) {
+    if ($pf) {
+        $iverilogCandidates += (Join-Path $pf 'iverilog\bin\iverilog.exe')
+        $vvpCandidates += (Join-Path $pf 'iverilog\bin\vvp.exe')
+    }
+}
+
+if (-not $Iverilog) { $Iverilog = Find-Tool -Name 'iverilog' -FromEnv $env:IVERILOG -Candidates $iverilogCandidates }
+if (-not $Vvp)      { $Vvp      = Find-Tool -Name 'vvp'      -FromEnv $env:VVP      -Candidates $vvpCandidates }
+
+if (-not $Iverilog -or -not (Test-Path -LiteralPath $Iverilog -PathType Leaf)) {
+    Write-Error "找不到 iverilog。安装 Icarus Verilog，或用 -Iverilog 指定路径。仿真门禁无法跳过。"
+    exit 1
+}
+if (-not $Vvp -or -not (Test-Path -LiteralPath $Vvp -PathType Leaf)) {
+    Write-Error "找不到 vvp。安装 Icarus Verilog，或用 -Vvp 指定路径。仿真门禁无法跳过。"
+    exit 1
+}
+
+Push-Location $sourceRoot
+try {
+    $suite = @(
+        @{ Name = 'tb_tick_rate';   Top = 'sim\tb_tick_rate.v';   Src = @('rtl\audio\pt8211_tx.v') },
+        @{ Name = 'tb_song_timing'; Top = 'sim\tb_song_timing.v'; Src = @('rtl\audio\song_player.v') },
+        @{ Name = 'tb_adsr';        Top = 'sim\tb_adsr.v';        Src = @('rtl\audio\adsr.v') },
+        @{ Name = 'tb_voice_retrigger'; Top = 'sim\tb_voice_retrigger.v'; Src = @(
+                'rtl\audio\voice_alloc.v', 'rtl\audio\poly_voice.v',
+                'rtl\audio\adsr.v', 'rtl\audio\dds_osc.v', 'rtl\audio\note_phase_inc.v') },
+        @{ Name = 'tb_voice_order'; Top = 'sim\tb_voice_order.v'; Src = @('rtl\audio\voice_alloc.v') },
+        @{ Name = 'tb_event_fifo'; Top = 'sim\tb_event_fifo.v'; Src = @('rtl\audio\event_fifo.v') },
+        @{ Name = 'tb_song_backpressure'; Top = 'sim\tb_song_backpressure.v'; Src = @('rtl\audio\song_player.v') },
+        @{ Name = 'tb_mode_uart'; Top = 'sim\tb_mode_uart.v'; Src = @(
+                'rtl\top.v',
+                'rtl\audio\dds_osc.v', 'rtl\audio\adsr.v', 'rtl\audio\poly_voice.v',
+                'rtl\audio\note_phase_inc.v', 'rtl\audio\event_fifo.v',
+                'rtl\audio\voice_alloc.v', 'rtl\audio\song_player.v',
+                'rtl\audio\mixer.v', 'rtl\audio\pt8211_tx.v', 'rtl\audio\uart_ctrl.v') },
+        @{ Name = 'tb_poly';        Top = 'sim\tb_poly.v';        Src = @(
+                'rtl\top.v',
+                'rtl\audio\dds_osc.v', 'rtl\audio\adsr.v', 'rtl\audio\poly_voice.v',
+                'rtl\audio\note_phase_inc.v', 'rtl\audio\event_fifo.v',
+                'rtl\audio\voice_alloc.v', 'rtl\audio\song_player.v',
+                'rtl\audio\mixer.v', 'rtl\audio\pt8211_tx.v', 'rtl\audio\uart_ctrl.v') },
+        @{ Name = 'tb_mcp3208_spi'; Top = 'sim\tb_mcp3208_spi.v'; Src = @(
+                'rtl\audio\mcp3208_spi.v', 'sim\mcp3208_model.v') },
+        @{ Name = 'tb_mcp3208_i2s_coexist'; Top = 'sim\tb_mcp3208_i2s_coexist.v'; Src = @(
+                'rtl\audio\mcp3208_spi.v', 'rtl\audio\pt8211_tx.v',
+                'sim\mcp3208_model.v') },
+        @{ Name = 'tb_mcp3208_params'; Top = 'sim\tb_mcp3208_params.v'; Src = @(
+                'rtl\audio\mcp3208_spi.v', 'sim\mcp3208_model.v') },
+        @{ Name = 'tb_pressure_bend'; Top = 'sim\tb_pressure_bend.v'; Src = @(
+                'rtl\audio\pressure_bend.v', 'rtl\audio\adsr.v') },
+        @{ Name = 'tb_s6_audio'; Top = 'sim\tb_s6_audio.v'; Src = @(
+                'rtl\audio\wavetable_rom_dual.v', 'rtl\audio\wavetable_osc_dual_s6.v',
+                'rtl\audio\mixer_s6.v') }
+    )
+
+    $failed = 0
+    foreach ($test in $suite) {
+        $out = Join-Path $sourceRoot ("sim\{0}.vvp" -f $test.Name)
+        Write-Output ("=== {0} ===" -f $test.Name)
+
+        $compileArgs = @('-g2012', '-I', '.', '-o', $out, $test.Top) + $test.Src
+        & $Iverilog @compileArgs
+        if ($LASTEXITCODE -ne 0) {
+            Write-Output ("编译失败：{0}" -f $test.Name)
+            $failed++
+            Remove-Item -LiteralPath $out -Force -ErrorAction SilentlyContinue
+            continue
+        }
+
+        try {
+            & $Vvp $out
+            if ($LASTEXITCODE -ne 0) {
+                Write-Output ("仿真失败：{0}" -f $test.Name)
+                $failed++
+            }
+        }
+        finally {
+            # .vvp files are reproducible build temporaries; keep the source
+            # tree clean after both PASS and failure.
+            Remove-Item -LiteralPath $out -Force -ErrorAction SilentlyContinue
+        }
+    }
+
+    if ($failed -ne 0) {
+        Write-Output ("仿真门禁未通过，{0} 个测试台失败，禁止烧录。" -f $failed)
+        exit 1
+    }
+    Write-Output "全部测试台通过，允许烧录。"
+    exit 0
+}
+finally {
+    Pop-Location
+}
diff --git a/output/handoff_milestone2_20261008/source/sim/tb_adsr.v b/output/handoff_milestone2_20261008/source/sim/tb_adsr.v
new file mode 100644
index 0000000..5880fde
--- /dev/null
+++ b/output/handoff_milestone2_20261008/source/sim/tb_adsr.v
@@ -0,0 +1,100 @@
+`timescale 1ns/1ps
+
+// Release must advance on every sample tick, including after an early note-off.
+module tb_adsr;
+    reg clk = 1'b0;
+    reg rst = 1'b1;
+    reg sample_tick = 1'b0;
+    reg gate = 1'b0;
+    reg retrigger = 1'b0;
+    wire [15:0] env;
+    wire idle;
+    reg [15:0] previous;
+    integer n;
+
+    always #5 clk = ~clk;
+
+    adsr #(
+        .ATTACK_STEP(16'd16000),
+        .DECAY_STEP(16'd8192),
+        .RELEASE_STEP(16'd4096),
+        .SUSTAIN_LEVEL(16'd32767)
+    ) dut (
+        .clk(clk), .rst(rst), .sample_tick(sample_tick),
+        .gate(gate), .retrigger(retrigger), .env(env), .idle(idle)
+    );
+
+    task step;
+        input next_gate;
+        input next_retrigger;
+        begin
+            @(negedge clk);
+            gate = next_gate;
+            retrigger = next_retrigger;
+            sample_tick = 1'b1;
+            @(posedge clk);
+            #1 sample_tick = 1'b0;
+        end
+    endtask
+
+    task drain_release;
+        begin
+            for (n = 0; n < 20 && !idle; n = n + 1) begin
+                previous = env;
+                step(1'b0, 1'b0);
+                if (env > previous)
+                    $fatal(1, "release rose from %0d to %0d", previous, env);
+            end
+            if (!idle || env !== 16'd0)
+                $fatal(1, "release did not reach idle and zero: env=%0d state=%0d", env, dut.state);
+        end
+    endtask
+
+    initial begin
+        repeat (2) @(negedge clk);
+        rst = 1'b0;
+
+        // Note Off during ATTACK must release rather than pin its level.
+        step(1'b1, 1'b1);
+        step(1'b1, 1'b0);
+        if (env !== 16'd16000 || idle) $fatal(1, "attack setup failed");
+        step(1'b0, 1'b0);
+        if (dut.state !== 3'd4 || env !== 16'd16000)
+            $fatal(1, "early note-off did not enter release");
+        drain_release();
+
+        // Note Off during DECAY is also a valid release path.
+        step(1'b1, 1'b1);
+        for (n = 0; n < 5; n = n + 1) step(1'b1, 1'b0);
+        if (dut.state !== 3'd2) $fatal(1, "decay setup failed");
+        step(1'b0, 1'b0);
+        if (dut.state !== 3'd4) $fatal(1, "decay note-off did not enter release");
+        drain_release();
+
+        // Sustain, release, then rapidly retrigger before the old tail ends.
+        step(1'b1, 1'b1);
+        for (n = 0; n < 20 && dut.state != 3'd3; n = n + 1)
+            step(1'b1, 1'b0);
+        if (dut.state !== 3'd3 || env !== 16'd32767)
+            $fatal(1, "sustain setup failed: state=%0d env=%0d", dut.state, env);
+        step(1'b0, 1'b0);
+        previous = env;
+        step(1'b0, 1'b0);
+        if (env >= previous || idle) $fatal(1, "sustain release did not decrease");
+        step(1'b1, 1'b1);
+        if (dut.state !== 3'd1 || env !== 16'd0)
+            $fatal(1, "rapid retrigger did not start a fresh attack");
+        step(1'b1, 1'b0);
+        if (env !== 16'd16000) $fatal(1, "retrigger attack did not advance");
+        step(1'b0, 1'b0);
+        drain_release();
+
+        $display("PASS tb_adsr: attack/decay/sustain note-off, release and retrigger");
+        $finish;
+    end
+
+    initial begin
+        #100000;
+        $fatal(1, "tb_adsr timeout");
+    end
+endmodule
diff --git a/output/handoff_milestone2_20261008/source/sim/tb_event_fifo.v b/output/handoff_milestone2_20261008/source/sim/tb_event_fifo.v
new file mode 100644
index 0000000..77471d9
--- /dev/null
+++ b/output/handoff_milestone2_20261008/source/sim/tb_event_fifo.v
@@ -0,0 +1,44 @@
+`timescale 1ns/1ps
+module tb_event_fifo;
+    reg clk = 0, rst = 1, wr_en = 0, rd_en = 0;
+    reg [15:0] wr_data = 0;
+    wire [15:0] rd_data;
+    wire empty, full, wr_ready;
+    integer i;
+    event_fifo dut (.clk(clk), .rst(rst), .wr_en(wr_en), .wr_data(wr_data),
+                    .rd_en(rd_en), .rd_data(rd_data), .empty(empty),
+                    .full(full), .wr_ready(wr_ready));
+    always #5 clk = ~clk;
+
+    initial begin
+        @(negedge clk); rst = 0;
+        for (i = 0; i < 16; i = i + 1) begin
+            wr_en = 1; wr_data = i;
+            if (!wr_ready) $fatal(1, "FIFO ready dropped before full");
+            @(negedge clk);
+        end
+        if (!full || empty || wr_ready) $fatal(1, "FIFO did not reach full state");
+        wr_data = 16'hDEAD;
+        @(negedge clk);
+        if (rd_data !== 16'd0) $fatal(1, "Full FIFO overwrote first item");
+        rd_en = 1; wr_data = 16'd16;
+        #1; // allow combinational wr_ready to reflect the new rd_en
+        if (!wr_ready) $fatal(1, "Full FIFO rejected simultaneous read/write");
+        @(negedge clk);
+        wr_en = 0;
+        if (!full || rd_data !== 16'd1) $fatal(1, "Simultaneous transfer lost order");
+        for (i = 1; i <= 16; i = i + 1) begin
+            if (empty || rd_data !== i[15:0])
+                $fatal(1, "FIFO sequence mismatch at %0d got %0d", i, rd_data);
+            @(negedge clk);
+        end
+        rd_en = 0;
+        if (!empty || full) $fatal(1, "FIFO did not drain");
+        wr_en = 1; wr_data = 16'h1234;
+        @(negedge clk); wr_en = 0; rst = 1;
+        @(negedge clk); rst = 0;
+        if (!empty || full) $fatal(1, "FIFO reset kept stale event");
+        $display("PASS tb_event_fifo: full, simultaneous read/write, order and clear");
+        $finish;
+    end
+endmodule
diff --git a/output/handoff_milestone2_20261008/source/sim/tb_mcp3208_i2s_coexist.v b/output/handoff_milestone2_20261008/source/sim/tb_mcp3208_i2s_coexist.v
new file mode 100644
index 0000000..3c9d366
--- /dev/null
+++ b/output/handoff_milestone2_20261008/source/sim/tb_mcp3208_i2s_coexist.v
@@ -0,0 +1,150 @@
+`timescale 1ns/1ps
+// S4 criterion "the ADC must not stall I2S".
+//
+// The production PT8211 transmitter and the MCP3208 master run from the same
+// 27 MHz clock.  The transmitter owns the 46.875 kHz sample tick, so the test
+// checks that every tick is exactly 576 clocks after the previous one while
+// ADC frames are issued back to back, that every SCLK half period is the
+// expected 54 clocks (27 MHz / 250 kHz / 2), and that every frame still
+// delivers the requested code.
+module tb_mcp3208_i2s_coexist;
+    localparam integer TICK_CLOCKS = 576;
+    localparam integer HALF_CLOCKS = 54;
+    localparam integer REQUESTS    = 40;
+    localparam integer IDLE_CLOCKS = 400;   // >> tCSH = 500 ns = 14 clocks
+
+    reg clk = 1'b0;
+    always #18.5185 clk = ~clk;             // 27 MHz
+    reg rst = 1'b1;
+    reg signed [15:0] sample_in = 16'sd0;
+
+    wire bck, ws, din, sample_tick;
+
+    reg start = 1'b0;
+    reg [2:0] channel = 3'd0;
+    wire miso, cs_n, sclk, mosi, busy, done, data_valid;
+    wire [11:0] data, adc_data;
+
+    pt8211_tx i2s (
+        .clk(clk), .rst(rst), .sample_in(sample_in),
+        .bck(bck), .ws(ws), .din(din), .sample_tick(sample_tick)
+    );
+
+    mcp3208_spi #(.CLK_HZ(27_000_000), .SPI_HZ(250_000)) adc (
+        .clk(clk), .rst(rst), .start(start), .channel(channel), .miso(miso),
+        .cs_n(cs_n), .sclk(sclk), .mosi(mosi), .busy(busy), .done(done),
+        .data(data), .data_valid(data_valid), .adc_data(adc_data)
+    );
+
+    reg [11:0] chv [0:7];
+    mcp3208_model model (
+        .cs_n(cs_n), .sclk(sclk), .mosi(mosi), .miso(miso),
+        .ch0(chv[0]), .ch1(chv[1]), .ch2(chv[2]), .ch3(chv[3]),
+        .ch4(chv[4]), .ch5(chv[5]), .ch6(chv[6]), .ch7(chv[7])
+    );
+
+    integer failures, clkcnt, last_tick, ticks, checked_ticks, checked_halves;
+    integer adc_ok, adc_done, i, last_sclk_edge;
+    reg [2:0] chidx;
+
+    always @(posedge clk) begin
+        clkcnt = clkcnt + 1;
+        if (sample_tick) begin
+            ticks = ticks + 1;
+            if (ticks > 1) begin
+                checked_ticks = checked_ticks + 1;
+                if ((clkcnt - last_tick) != TICK_CLOCKS) begin
+                    $display("FAIL tick %0d period %0d clocks, expected %0d",
+                             ticks, clkcnt - last_tick, TICK_CLOCKS);
+                    failures = failures + 1;
+                end
+            end
+            last_tick = clkcnt;
+        end
+    end
+
+    always @(sclk) begin
+        if (!cs_n && (clkcnt > 0)) begin
+            if (last_sclk_edge > 0) begin
+                checked_halves = checked_halves + 1;
+                if ((clkcnt - last_sclk_edge) != HALF_CLOCKS) begin
+                    $display("FAIL sclk half period %0d clocks, expected %0d",
+                             clkcnt - last_sclk_edge, HALF_CLOCKS);
+                    failures = failures + 1;
+                end
+            end
+            last_sclk_edge = clkcnt;
+        end else begin
+            last_sclk_edge = 0;
+        end
+    end
+
+    task request;
+        input [2:0] ch;
+        input [11:0] value;
+        begin
+            chv[ch] = value;
+            @(negedge clk); channel <= ch; start <= 1'b1;
+            @(negedge clk); start <= 1'b0;
+            wait (done);
+            adc_done = adc_done + 1;
+            #1;
+            if (data_valid !== 1'b1 || data !== value || adc_data !== value) begin
+                $display("FAIL coexist ch=%0d value=%0d data=%0d valid=%b",
+                         ch, value, data, data_valid);
+                failures = failures + 1;
+            end else begin
+                adc_ok = adc_ok + 1;
+            end
+            repeat (IDLE_CLOCKS) @(posedge clk);
+        end
+    endtask
+
+    initial begin
+        failures = 0; clkcnt = 0; last_tick = 0; ticks = 0;
+        checked_ticks = 0; checked_halves = 0; adc_ok = 0; adc_done = 0;
+        last_sclk_edge = 0;
+        chv[0] = 12'h123; chv[1] = 12'h456; chv[2] = 12'h789; chv[3] = 12'hABC;
+        chv[4] = 12'hDEF; chv[5] = 12'h0F0; chv[6] = 12'h555; chv[7] = 12'hAAA;
+
+        // Waveform capture is opt in: run `vvp tb.vvp +dump` to write
+        // sim/tb_mcp3208_i2s_coexist.vcd.  The gate stays free of multi-megabyte dumps.
+        if ($test$plusargs("dump")) begin
+            $dumpfile("sim/tb_mcp3208_i2s_coexist.vcd");
+            $dumpvars(0, tb_mcp3208_i2s_coexist);
+        end
+
+        repeat (4) @(posedge clk);
+        rst = 1'b0;
+        sample_in = 16'sh2000;
+        repeat (10) @(posedge clk);
+
+        for (i = 0; i < REQUESTS; i = i + 1) begin
+            chidx = i[0] ? 3'd1 : 3'd0;
+            request(chidx, 12'h100 + i[11:0]);
+        end
+
+        if (checked_ticks < 20) begin
+            $display("FAIL coexist: only %0d tick periods observed", checked_ticks);
+            failures = failures + 1;
+        end
+        if (checked_halves < (REQUESTS * 19) - REQUESTS) begin
+            $display("FAIL coexist: only %0d SCLK half periods observed", checked_halves);
+            failures = failures + 1;
+        end
+        if (adc_ok != REQUESTS || adc_done != REQUESTS) begin
+            $display("FAIL coexist: %0d of %0d frames returned the requested code",
+                     adc_ok, REQUESTS);
+            failures = failures + 1;
+        end
+        if (failures != 0) $fatal(1, "tb_mcp3208_i2s_coexist failures=%0d", failures);
+        $display("tb_mcp3208_i2s_coexist PASS: %0d frames, %0d ticks, %0d SCLK half periods",
+                 adc_ok, checked_ticks, checked_halves);
+        $finish;
+    end
+
+    initial begin
+        #200_000_000;
+        $fatal(1, "FAIL tb_mcp3208_i2s_coexist: timeout");
+    end
+endmodule
\ No newline at end of file
diff --git a/output/handoff_milestone2_20261008/source/sim/tb_mcp3208_params.v b/output/handoff_milestone2_20261008/source/sim/tb_mcp3208_params.v
new file mode 100644
index 0000000..79e90c8
--- /dev/null
+++ b/output/handoff_milestone2_20261008/source/sim/tb_mcp3208_params.v
@@ -0,0 +1,181 @@
+`timescale 1ns/1ps
+// S4 parameter checks for mcp3208_spi.
+//
+//   1. production pair 27 MHz / 250 kHz: half period must be exactly 54
+//      clocks (2 us), i.e. SCLK = 250 kHz, the frame must use 19 rising
+//      edges, and CS fall to the first rising edge must satisfy
+//      tSUCS >= 100 ns (100 ns = 2.7 clocks at 27 MHz),
+//   2. SPI_HZ far above CLK_HZ / 2: the divider must clamp to one clock and
+//      the frame must still complete with the correct code (no hang, no lost
+//      bit),
+//   3. SPI_HZ below 1 Hz: the guard has to keep elaboration defined.  This
+//      instance is only elaborated, never started, because one frame would
+//      take 19 x 2 x 13.5 M clocks.
+module tb_mcp3208_params;
+    reg clk = 1'b0;
+    always #18.5185 clk = ~clk;             // 27 MHz
+    reg rst = 1'b1;
+
+    integer failures, clkcnt;
+
+    // ---- production configuration ---------------------------------------
+    reg p_start = 1'b0;
+    wire p_miso, p_cs_n, p_sclk, p_mosi, p_busy, p_done, p_valid;
+    wire [11:0] p_data, p_adc;
+    mcp3208_spi #(.CLK_HZ(27_000_000), .SPI_HZ(250_000)) u_prod (
+        .clk(clk), .rst(rst), .start(p_start), .channel(3'd2), .miso(p_miso),
+        .cs_n(p_cs_n), .sclk(p_sclk), .mosi(p_mosi), .busy(p_busy),
+        .done(p_done), .data(p_data), .data_valid(p_valid), .adc_data(p_adc)
+    );
+    wire [11:0] p_chv = 12'h345;
+    mcp3208_model m_prod (
+        .cs_n(p_cs_n), .sclk(p_sclk), .mosi(p_mosi), .miso(p_miso),
+        .ch0(p_chv), .ch1(p_chv), .ch2(p_chv), .ch3(p_chv),
+        .ch4(p_chv), .ch5(p_chv), .ch6(p_chv), .ch7(p_chv)
+    );
+    integer p_edges, p_last_edge, p_sucs, p_cs_fall_clk, p_first_rise;
+    integer p_half_bad;
+
+    // ---- clamped configuration ------------------------------------------
+    reg f_start = 1'b0;
+    wire f_miso, f_cs_n, f_sclk, f_mosi, f_busy, f_done, f_valid;
+    wire [11:0] f_data, f_adc;
+    mcp3208_spi #(.CLK_HZ(27_000_000), .SPI_HZ(20_000_000)) u_fast (
+        .clk(clk), .rst(rst), .start(f_start), .channel(3'd1), .miso(f_miso),
+        .cs_n(f_cs_n), .sclk(f_sclk), .mosi(f_mosi), .busy(f_busy),
+        .done(f_done), .data(f_data), .data_valid(f_valid), .adc_data(f_adc)
+    );
+    wire [11:0] f_chv = 12'h6A5;
+    mcp3208_model m_fast (
+        .cs_n(f_cs_n), .sclk(f_sclk), .mosi(f_mosi), .miso(f_miso),
+        .ch0(f_chv), .ch1(f_chv), .ch2(f_chv), .ch3(f_chv),
+        .ch4(f_chv), .ch5(f_chv), .ch6(f_chv), .ch7(f_chv)
+    );
+    integer f_edges, f_last_edge, f_sucs, f_cs_fall_clk, f_first_rise;
+    integer f_half_bad;
+
+    // ---- elaboration only ------------------------------------------------
+    wire z_miso, z_cs_n, z_sclk, z_mosi, z_busy, z_done;
+    mcp3208_spi #(.CLK_HZ(27_000_000), .SPI_HZ(0)) u_zero (
+        .clk(clk), .rst(rst), .start(1'b0), .channel(3'd0), .miso(z_miso),
+        .cs_n(z_cs_n), .sclk(z_sclk), .mosi(z_mosi), .busy(z_busy),
+        .done(z_done), .data(), .data_valid(), .adc_data()
+    );
+
+    always @(posedge clk) clkcnt = clkcnt + 1;
+
+    always @(negedge p_cs_n) p_cs_fall_clk = clkcnt;
+
+    always @(p_sclk) begin
+        if (!p_cs_n) begin
+            if (p_sclk === 1'b1) begin
+                p_edges = p_edges + 1;
+                if (p_edges == 1) begin
+                    p_first_rise = clkcnt;
+                    p_sucs       = clkcnt - p_cs_fall_clk;
+                end
+            end
+            if (p_last_edge > 0) begin
+                if ((clkcnt - p_last_edge) != 54) begin
+                    p_half_bad = p_half_bad + 1;
+                    $display("FAIL prod half period %0d clocks", clkcnt - p_last_edge);
+                end
+            end
+            p_last_edge = clkcnt;
+        end else begin
+            p_last_edge = 0;
+        end
+    end
+
+    always @(negedge f_cs_n) f_cs_fall_clk = clkcnt;
+
+    always @(f_sclk) begin
+        if (!f_cs_n) begin
+            if (f_sclk === 1'b1) begin
+                f_edges = f_edges + 1;
+                if (f_edges == 1) begin
+                    f_first_rise = clkcnt;
+                    f_sucs       = clkcnt - f_cs_fall_clk;
+                end
+            end
+            if (f_last_edge > 0) begin
+                if ((clkcnt - f_last_edge) != 1) begin
+                    f_half_bad = f_half_bad + 1;
+                    $display("FAIL clamped half period %0d clocks", clkcnt - f_last_edge);
+                end
+            end
+            f_last_edge = clkcnt;
+        end else begin
+            f_last_edge = 0;
+        end
+    end
+
+    initial begin
+        failures = 0; clkcnt = 0;
+        p_edges = 0; p_last_edge = 0; p_sucs = 0; p_cs_fall_clk = 0;
+        p_first_rise = 0; p_half_bad = 0;
+        f_edges = 0; f_last_edge = 0; f_sucs = 0; f_cs_fall_clk = 0;
+        f_first_rise = 0; f_half_bad = 0;
+
+        repeat (4) @(posedge clk);
+        rst = 1'b0;
+        repeat (4) @(posedge clk);
+
+        // production frame
+        @(negedge clk); p_start <= 1'b1;
+        @(negedge clk); p_start <= 1'b0;
+        wait (p_done);
+        #1;
+        if (p_valid !== 1'b1 || p_data !== p_chv) begin
+            $display("FAIL prod data=%h expected %h", p_data, p_chv);
+            failures = failures + 1;
+        end
+        if (p_edges != 19) begin
+            $display("FAIL prod frame used %0d rising SCLK edges", p_edges);
+            failures = failures + 1;
+        end
+        if (p_half_bad != 0) failures = failures + 1;
+        // tSUCS: 100 ns is 2.7 clocks at 27 MHz
+        if (p_sucs < 3) begin
+            $display("FAIL prod tSUCS interval %0d clocks", p_sucs);
+            failures = failures + 1;
+        end
+        $display("prod: %0d rising edges, half period 54 clocks, CS to first edge %0d clocks (%0.0f ns), data=%h",
+                 p_edges, p_sucs, p_sucs * 37.037, p_data);
+        repeat (20) @(posedge clk);
+
+        // clamped frame
+        @(negedge clk); f_start <= 1'b1;
+        @(negedge clk); f_start <= 1'b0;
+        wait (f_done);
+        #1;
+        if (f_valid !== 1'b1 || f_data !== f_chv) begin
+            $display("FAIL clamped data=%h expected %h", f_data, f_chv);
+            failures = failures + 1;
+        end
+        if (f_edges != 19) begin
+            $display("FAIL clamped frame used %0d rising SCLK edges", f_edges);
+            failures = failures + 1;
+        end
+        if (f_half_bad != 0) failures = failures + 1;
+        // The clamped pair is a deliberate misuse: SCLK 13.5 MHz and a 37 ns
+        // CS setup, both outside the device ratings, so only report it.
+        $display("clamped: %0d rising edges, half period 1 clock (SCLK 13.5 MHz), CS to first edge %0d clocks (%0.0f ns), data=%h",
+                 f_edges, f_sucs, f_sucs * 37.037, f_data);
+
+        if (z_cs_n !== 1'b1 || z_sclk !== 1'b0) begin
+            $display("FAIL guarded instance is not idle: cs_n=%b sclk=%b", z_cs_n, z_sclk);
+            failures = failures + 1;
+        end
+        $display("SPI_HZ=0 instance elaborated and idle (guard keeps the divider defined)");
+
+        if (failures != 0) $fatal(1, "tb_mcp3208_params failures=%0d", failures);
+        $display("tb_mcp3208_params PASS");
+        $finish;
+    end
+
+    initial begin
+        #200_000_000;
+        $fatal(1, "FAIL tb_mcp3208_params: timeout");
+    end
+endmodule
