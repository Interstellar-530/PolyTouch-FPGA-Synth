diff --git a/output/handoff_milestone2_20261008/source/sim/tb_mcp3208_spi.v b/output/handoff_milestone2_20261008/source/sim/tb_mcp3208_spi.v
new file mode 100644
index 0000000..8a2843a
--- /dev/null
+++ b/output/handoff_milestone2_20261008/source/sim/tb_mcp3208_spi.v
@@ -0,0 +1,299 @@
+`timescale 1ns/1ps
+// S4 MCP3208 master self-check, independent review revision (2026-10-15).
+//
+// The device side is mcp3208_model.v, which follows the Microchip DS21298E
+// frame (19 clocks: null bit on clock 7, B11..B0 on clocks 8..19).  Using a
+// model that encodes the real device timing instead of mirroring the master
+// is what makes a bit placement error visible: an 18-clock master reads the
+// null bit as B11 and returns every code shifted right by one bit.
+//
+// The audit block watches the pins and fails the run when a frame is not 19
+// SCLK pulses, when the DIN command does not match the requested channel,
+// when busy/CS/SCLK are wrong during the frame, or when a code is committed
+// while CS is still low.
+module tb_mcp3208_spi;
+    reg clk = 1'b0;
+    always #5 clk = ~clk;                    // 100 MHz core clock in this test
+    reg rst = 1'b1;
+    reg start = 1'b0;
+    reg [2:0] channel = 3'd0;
+
+    wire miso;
+    wire cs_n, sclk, mosi, busy, done, data_valid;
+    wire [11:0] data, adc_data;
+
+    mcp3208_spi #(.CLK_HZ(100_000_000), .SPI_HZ(1_000_000)) dut (
+        .clk(clk), .rst(rst), .start(start), .channel(channel), .miso(miso),
+        .cs_n(cs_n), .sclk(sclk), .mosi(mosi), .busy(busy), .done(done),
+        .data(data), .data_valid(data_valid), .adc_data(adc_data)
+    );
+
+    reg [11:0] chv [0:7];
+    mcp3208_model model (
+        .cs_n(cs_n), .sclk(sclk), .mosi(mosi), .miso(miso),
+        .ch0(chv[0]), .ch1(chv[1]), .ch2(chv[2]), .ch3(chv[3]),
+        .ch4(chv[4]), .ch5(chv[5]), .ch6(chv[6]), .ch7(chv[7])
+    );
+
+    integer failures;
+    integer i;
+    integer k;
+    integer n;
+    reg [31:0] rnd;
+    reg [2:0] chidx;
+
+    // ---- wire level audit ------------------------------------------------
+    integer rcount;         // SCLK rising edges in the current frame
+    integer adc_clk;        // device clock index, 1 = start bit, 0 = none yet
+    reg     seen_start;
+    reg [2:0] audit_ch;
+    reg     txn_ignore;     // set while a deliberately truncated frame runs
+    integer snap_rcount;
+    integer snap_adc_clk;
+    reg [2:0] snap_ch;
+    integer commits;
+    reg [11:0] held_data;
+
+    always @(posedge sclk) begin
+        if (!cs_n) begin
+            rcount = rcount + 1;
+            if (busy !== 1'b1) begin
+                $display("FAIL audit: busy low on SCLK edge %0d", rcount);
+                failures = failures + 1;
+            end
+            if (!seen_start) begin
+                if (mosi === 1'b1) begin
+                    seen_start = 1'b1;
+                    adc_clk    = 1;
+                    if (rcount != 1) begin
+                        $display("FAIL audit: %0d leading zero clocks before START", rcount - 1);
+                        failures = failures + 1;
+                    end
+                end
+            end else begin
+                adc_clk = adc_clk + 1;
+                case (adc_clk)
+                    2: if (mosi !== 1'b1) begin
+                           $display("FAIL audit: SGL/DIFF is not single ended");
+                           failures = failures + 1;
+                       end
+                    3: audit_ch[2] = mosi;
+                    4: audit_ch[1] = mosi;
+                    5: audit_ch[0] = mosi;
+                    default: ;
+                endcase
+            end
+        end
+    end
+
+    always @(posedge clk) begin
+        if (data_valid === 1'b1) commits = commits + 1;
+        if (!cs_n) begin
+            if (data_valid === 1'b1) begin
+                $display("FAIL audit: data_valid pulsed while CS is low");
+                failures = failures + 1;
+            end
+            if (data !== held_data) begin
+                $display("FAIL audit: code committed before CS returned high: data=%h held=%h",
+                         data, held_data);
+                failures = failures + 1;
+            end
+        end else begin
+            held_data = data;
+        end
+    end
+
+    always @(posedge cs_n) begin
+        if (rcount != 0) begin
+            if (txn_ignore) begin
+                txn_ignore = 1'b0;
+            end else begin
+                snap_rcount  = rcount;
+                snap_adc_clk = adc_clk;
+                snap_ch      = audit_ch;
+            end
+        end
+        rcount     = 0;
+        adc_clk    = 0;
+        seen_start = 1'b0;
+        commits    = 0;
+    end
+
+    function [31:0] xorshift;
+        input [31:0] x;
+        begin
+            x = x ^ (x << 13);
+            x = x ^ (x >> 17);
+            x = x ^ (x << 5);
+            xorshift = x;
+        end
+    endfunction
+
+    task set_channels;
+        begin
+            // Distinct non zero codes: a wrong channel decode cannot pass.
+            chv[0] = 12'h123; chv[1] = 12'h456;
+            chv[2] = 12'h789; chv[3] = 12'hABC;
+            chv[4] = 12'hDEF; chv[5] = 12'h0F0;
+            chv[6] = 12'h555; chv[7] = 12'hAAA;
+        end
+    endtask
+
+    task run_case;
+        input [2:0] ch;
+        input [11:0] value;
+        begin
+            chv[ch] = value;
+            @(negedge clk); channel <= ch; start <= 1'b1;
+            @(negedge clk); start <= 1'b0;
+            wait (done);
+            #1;
+            if (data_valid !== 1'b1 || data !== value || adc_data !== value) begin
+                $display("FAIL ch=%0d value=%0d: data=%0d adc_data=%0d valid=%b",
+                         ch, value, data, adc_data, data_valid);
+                failures = failures + 1;
+            end
+            @(posedge clk); #1;
+            if (commits != 1) begin
+                $display("FAIL ch=%0d value=%0d: %0d commit pulses in one frame", ch, value, commits);
+                failures = failures + 1;
+            end
+            if (snap_rcount != 19 || snap_adc_clk != 19) begin
+                $display("FAIL ch=%0d value=%0d: frame used %0d SCLK edges / %0d device clocks, expected 19",
+                         ch, value, snap_rcount, snap_adc_clk);
+                failures = failures + 1;
+            end
+            if (snap_ch !== ch) begin
+                $display("FAIL ch=%0d value=%0d: device decoded channel %0d", ch, value, snap_ch);
+                failures = failures + 1;
+            end
+            if (busy !== 1'b0 || cs_n !== 1'b1) begin
+                $display("FAIL ch=%0d value=%0d: busy=%b cs_n=%b after done", ch, value, busy, cs_n);
+                failures = failures + 1;
+            end
+            @(negedge clk);
+        end
+    endtask
+
+    task start_while_busy;
+        begin
+            chv[3] = 12'h321;
+            chv[6] = 12'h654;
+            @(negedge clk); channel <= 3'd3; start <= 1'b1;
+            @(negedge clk); start <= 1'b0;
+            repeat (6) @(posedge sclk);
+            @(negedge clk); channel <= 3'd6; start <= 1'b1;
+            @(negedge clk); start <= 1'b0;
+            wait (done);
+            #1;
+            if (data !== 12'h321) begin
+                $display("FAIL start-while-busy: data=%0d, expected %0d from the latched channel",
+                         data, 12'h321);
+                failures = failures + 1;
+            end
+            @(posedge clk); #1;
+            if (snap_ch !== 3'd3 || snap_rcount != 19) begin
+                $display("FAIL start-while-busy: decoded channel %0d, %0d SCLK edges",
+                         snap_ch, snap_rcount);
+                failures = failures + 1;
+            end
+            @(negedge clk);
+            // The ignored request is not queued; a fresh request is needed.
+            run_case(3'd6, 12'h654);
+        end
+    endtask
+
+    task abort_with_reset;
+        input integer nclk;
+        begin
+            txn_ignore = 1'b1;
+            @(negedge clk); channel <= 3'd5; start <= 1'b1;
+            @(negedge clk); start <= 1'b0;
+            for (k = 0; k < nclk; k = k + 1) @(posedge sclk);
+            @(negedge clk); rst <= 1'b1;
+            repeat (2) @(posedge clk);
+            rst <= 1'b0;
+            @(posedge clk); #1;
+            if (cs_n !== 1'b1 || busy !== 1'b0 || sclk !== 1'b0 || done !== 1'b0) begin
+                $display("FAIL reset after %0d clocks: cs_n=%b busy=%b sclk=%b done=%b",
+                         nclk, cs_n, busy, sclk, done);
+                failures = failures + 1;
+            end
+            if (commits != 0) begin
+                $display("FAIL reset after %0d clocks: %0d commits in the truncated frame", nclk, commits);
+                failures = failures + 1;
+            end
+            txn_ignore = 1'b0;
+            @(negedge clk);
+        end
+    endtask
+
+    initial begin
+        failures = 0; rcount = 0; adc_clk = 0; seen_start = 1'b0; audit_ch = 3'd0;
+        commits = 0; held_data = 12'd0; snap_rcount = 0; snap_adc_clk = 0; snap_ch = 3'd0;
+        txn_ignore = 1'b0; rnd = 32'h1234_5678;
+
+        // Waveform capture is opt in: run `vvp tb.vvp +dump` to write
+        // sim/tb_mcp3208_spi.vcd.  The gate stays free of multi-megabyte dumps.
+        if ($test$plusargs("dump")) begin
+            $dumpfile("sim/tb_mcp3208_spi.vcd");
+            $dumpvars(0, tb_mcp3208_spi);
+        end
+
+        set_channels;
+        repeat (4) @(posedge clk);
+        rst = 1'b0;
+        repeat (2) @(posedge clk);
+
+        // 1) boundary codes on CH0 and CH1 while every other channel holds a
+        //    different non zero code
+        run_case(3'd0, 12'd0);
+        run_case(3'd1, 12'd0);
+        run_case(3'd0, 12'd1);
+        run_case(3'd1, 12'd1);
+        run_case(3'd0, 12'd2047);
+        run_case(3'd1, 12'd2047);
+        run_case(3'd0, 12'd2048);
+        run_case(3'd1, 12'd2048);
+        run_case(3'd0, 12'd4095);
+        run_case(3'd1, 12'd4095);
+
+        // 2) two channel interleave, both codes live at the same time
+        chv[0] = 12'd1374;
+        chv[1] = 12'd2748;
+        for (i = 0; i < 4; i = i + 1) begin
+            run_case(3'd0, 12'd1374);
+            run_case(3'd1, 12'd2748);
+        end
+
+        // 3) every remaining channel
+        for (i = 2; i < 8; i = i + 1) begin
+            chidx = i[2:0];
+            run_case(chidx, 12'h100 + i[11:0]);
+        end
+
+        // 4) fixed seed pseudo random channel/code sweep (xorshift32)
+        for (i = 0; i < 256; i = i + 1) begin
+            rnd = xorshift(rnd);
+            run_case(rnd[2:0], rnd[27:16]);
+        end
+
+        // 5) a request while a conversion is in flight is ignored
+        start_while_busy;
+
+        // 6) reset in the middle of a frame, at three different positions
+        abort_with_reset(3);
+        abort_with_reset(8);
+        abort_with_reset(15);
+        run_case(3'd5, chv[5]);
+
+        if (failures != 0) $fatal(1, "tb_mcp3208_spi failures=%0d", failures);
+        $display("tb_mcp3208_spi PASS");
+        $finish;
+    end
+
+    initial begin
+        #200_000_000;                        // watchdog: frames are ~19 us each
+        $fatal(1, "FAIL tb_mcp3208_spi: timeout, no progress after 200 ms");
+    end
+endmodule
\ No newline at end of file
diff --git a/output/handoff_milestone2_20261008/source/sim/tb_mode_uart.v b/output/handoff_milestone2_20261008/source/sim/tb_mode_uart.v
new file mode 100644
index 0000000..85497dc
--- /dev/null
+++ b/output/handoff_milestone2_20261008/source/sim/tb_mode_uart.v
@@ -0,0 +1,88 @@
+`timescale 1ns/1ps
+module tb_mode_uart;
+    reg clk = 0, key_rst = 0, key_s1 = 1, key_s2 = 1, uart_rx = 1;
+    wire hp_bck, hp_ws, hp_din, pa_en, led, led_chord, led_t0, led_t1, uart_tx;
+    integer err_count = 0, accepted = 0, replies_dequeued = 0, i;
+    top dut (.clk_27m(clk), .key_rst(key_rst), .key_s1(key_s1), .key_s2(key_s2),
+             .uart_rx(uart_rx), .hp_bck(hp_bck), .hp_ws(hp_ws), .hp_din(hp_din),
+             .pa_en(pa_en), .led(led), .led_chord(led_chord),
+             .led_t0(led_t0), .led_t1(led_t1), .uart_tx(uart_tx));
+    always #18.5185 clk = ~clk;
+    always @(posedge clk) begin
+        if (dut.u_uart.reply_err) err_count = err_count + 1;
+        if (dut.u_uart.reply_ok) accepted = accepted + 1;
+        if (dut.u_uart.reply_pop) begin
+            if (dut.u_uart.reply_queue[dut.u_uart.reply_rd_ptr] !==
+                (replies_dequeued >= 6))
+                $fatal(1, "UART reply queue lost command order at %0d", replies_dequeued);
+            replies_dequeued = replies_dequeued + 1;
+        end
+    end
+
+    task send_byte;
+        input [7:0] data;
+        integer bitno;
+        begin
+            @(negedge clk); uart_rx = 0; #8680;
+            for (bitno = 0; bitno < 8; bitno = bitno + 1) begin
+                uart_rx = data[bitno]; #8680;
+            end
+            uart_rx = 1; #8680;
+        end
+    endtask
+    task settle;
+        begin repeat (12) @(negedge clk); end
+    endtask
+
+    initial begin
+        #100000; key_rst = 1;
+        wait (!dut.rst);
+        force dut.sample_tick = 1'b1; // speed up the sequencer, not the UART
+        wait (dut.v_gate != 4'b0000);
+        if (!dut.demo_mode) $fatal(1, "Power-on demo missing");
+
+        send_byte("N"); send_byte("6"); send_byte("9"); send_byte(8'h0D); settle();
+        if (dut.demo_mode || dut.v_gate == 0 || dut.fifo_empty !== 1'b1)
+            $fatal(1, "First manual note failed to clear demo and play");
+        if (!(dut.v_note[6:0] == 7'd69 || dut.v_note[13:7] == 7'd69 ||
+              dut.v_note[20:14] == 7'd69 || dut.v_note[27:21] == 7'd69))
+            $fatal(1, "First manual note was lost during mode switch");
+        for (i = 0; i < 40000; i = i + 1) begin
+            @(negedge clk);
+            if (dut.sp_ev_wr || !dut.fifo_empty)
+                $fatal(1, "Demo wrote events during manual mode");
+        end
+
+        send_byte("O"); send_byte("6"); send_byte("9"); send_byte(8'h0D); settle();
+        if (dut.v_gate != 0) $fatal(1, "Manual Note Off was lost");
+        send_byte("D"); send_byte("1"); send_byte(8'h0D); settle();
+        if (!dut.demo_mode) $fatal(1, "D1 did not enable demo");
+        wait (dut.v_gate != 0);
+        send_byte("X"); send_byte(8'h0D); settle();
+        if (dut.demo_mode || dut.v_gate != 0 || !dut.fifo_empty)
+            $fatal(1, "Panic did not stop demo and clear queue");
+
+        send_byte("D"); send_byte("1"); send_byte(8'h0D); settle();
+        wait (dut.v_gate != 0);
+        send_byte("D"); send_byte("0"); send_byte(8'h0D); settle();
+        if (dut.demo_mode || dut.v_gate != 0)
+            $fatal(1, "D0 did not stop demo");
+        send_byte("F"); send_byte("4"); send_byte("4"); send_byte("0"); send_byte(8'h0D);
+        send_byte("N"); send_byte("9"); send_byte("9"); send_byte("9"); send_byte(8'h0D);
+        send_byte("N"); send_byte("1"); send_byte("2"); send_byte("3"); send_byte("4"); send_byte(8'h0D);
+        send_byte("M"); send_byte("2"); send_byte(8'h0D);
+        send_byte("D"); send_byte("2"); send_byte(8'h0D); settle();
+        if (err_count != 5 || dut.demo_mode || dut.v_gate != 0)
+            $fatal(1, "Invalid commands: errors=%0d mode=%b gate=%b",
+                   err_count, dut.demo_mode, dut.v_gate);
+        if (accepted != 6)
+            $fatal(1, "Valid command replies missing: %0d", accepted);
+        wait (replies_dequeued == 11 && dut.u_uart.reply_count == 0 &&
+              dut.u_uart.msg_state == 0);
+        if (dut.u_uart.reply_drop_count != 0)
+            $fatal(1, "UART response queue overflowed");
+        $display("PASS tb_mode_uart: manual priority, demo restart, panic, invalid commands");
+        $finish;
+    end
+    initial begin #300000000; $fatal(1, "Mode/UART integration timeout"); end
+endmodule
diff --git a/output/handoff_milestone2_20261008/source/sim/tb_poly.v b/output/handoff_milestone2_20261008/source/sim/tb_poly.v
new file mode 100644
index 0000000..cbb904b
--- /dev/null
+++ b/output/handoff_milestone2_20261008/source/sim/tb_poly.v
@@ -0,0 +1,101 @@
+`timescale 1ns/1ps
+
+// Top level wiring check.
+//
+// This is deliberately short.  It checks that the design leaves reset, that
+// the default tempo preset is the one that was found correct on the bench, and
+// that the two user keys actually reach the sequencer through the debouncer.
+// Deep sequencer and audio timing are covered by tb_song_timing and
+// tb_tick_rate, which run much faster because they do not instantiate the
+// whole chip.
+module tb_poly;
+
+    parameter DEBOUNCE_HOLD = 50000000;   // 50 ms, longer than the 38.8 ms debounce
+
+    reg clk = 1'b0;
+    reg key_rst = 1'b0;      // active low: 0 holds the design in reset
+    reg key_s1 = 1'b1;
+    reg key_s2 = 1'b1;
+    reg uart_rx = 1'b1;
+
+    wire hp_bck, hp_ws, hp_din, pa_en, led, led_chord, led_t0, led_t1, uart_tx;
+
+    integer errors = 0;
+
+    always #18.5185 clk = ~clk;      // 27 MHz
+
+    top dut (
+        .clk_27m  (clk),
+        .key_rst  (key_rst),
+        .key_s1   (key_s1),
+        .key_s2   (key_s2),
+        .uart_rx  (uart_rx),
+        .hp_bck   (hp_bck),
+        .hp_ws    (hp_ws),
+        .hp_din   (hp_din),
+        .pa_en    (pa_en),
+        .led      (led),
+        .led_chord(led_chord),
+        .led_t0   (led_t0),
+        .led_t1   (led_t1),
+        .uart_tx  (uart_tx)
+    );
+
+    // Named check_equal rather than "expect": that word is a SystemVerilog
+    // keyword and the parser rejects it as a task name.
+    task check_equal;
+        input [255:0] what;
+        input         got;
+        input         want;
+        begin
+            if (got !== want) begin
+                $display("FAIL %0s: got %b want %b", what, got, want);
+                errors = errors + 1;
+            end else begin
+                $display("ok   %0s", what);
+            end
+        end
+    endtask
+
+    initial begin
+        // Hold the design in reset, then release it.
+        #100000;
+        key_rst = 1'b1;
+        // The power-on reset takes 65536 clocks, about 2.4 ms; wait well past
+        // it before reading any output.
+        #5000000;
+
+        // 默认档位 index 1（2x），tempo_sel=01。LED 引脚低电平亮：
+        // led_t0=~bit0=0 表示 bit0=1，led_t1=~bit1=1 表示 bit1=0。
+        check_equal("power-on reset released", pa_en, 1'b1);
+        check_equal("default preset index 1, bit0 lit", led_t0, 1'b0);
+        check_equal("default preset index 1, bit1 dark", led_t1, 1'b1);
+        check_equal("chord set A, indicator dark", led_chord, 1'b1);
+
+        // S1 switches to chord set B; its indicator lights.
+        key_s1 = 1'b0;
+        #(DEBOUNCE_HOLD);
+        key_s1 = 1'b1;
+        #1000000;
+        check_equal("S1 selected chord set B", led_chord, 1'b0);
+
+        // S2 从 index 1 到 index 2（3x），tempo_sel=10；bit0 灯灭、bit1 灯亮。
+        key_s2 = 1'b0;
+        #(DEBOUNCE_HOLD);
+        key_s2 = 1'b1;
+        #1000000;
+        check_equal("S2 stepped to preset index 2, bit0 dark", led_t0, 1'b1);
+        check_equal("S2 stepped to preset index 2, bit1 lit", led_t1, 1'b0);
+
+        if (errors == 0)
+            $display("PASS tb_poly");
+        else
+            $fatal(1, "FAIL tb_poly with %0d error(s)", errors);
+        $finish;
+    end
+
+    initial begin
+        #400000000;
+        $fatal(1, "FAIL tb_poly: timeout");
+    end
+endmodule
diff --git a/output/handoff_milestone2_20261008/source/sim/tb_pressure_bend.v b/output/handoff_milestone2_20261008/source/sim/tb_pressure_bend.v
new file mode 100644
index 0000000..1b2f273
--- /dev/null
+++ b/output/handoff_milestone2_20261008/source/sim/tb_pressure_bend.v
@@ -0,0 +1,244 @@
+`timescale 1ns/1ps
+// S5 pressure/bend self-check, independent review revision (2026-10-15).
+//
+// The DUT is driven by vectors generated from tools/pressure_bend_ref.py, so
+// every control tick of a step/ramp/spike/pseudo-random pressure sequence and
+// every one of the 4096 bend ADC codes is compared value by value instead of
+// against a handful of hand written expectations.  The qualitative checks of
+// the delivered test (median plus IIR step, 90 percent response, single sample
+// spike rejection, bend edges, pressure-off bypass, held note bend without an
+// ADSR retrigger) are kept, and pressure-off playability was added.
+//
+// Regenerate the vectors with:
+//   python source/tools/pressure_bend_ref.py --vectors source/sim/vectors
+module tb_pressure_bend;
+    localparam integer PRESSURE_VECTORS = 640;
+    localparam integer BEND_VECTORS     = 4096;
+    localparam [11:0]  MID              = 12'd2048;
+    localparam [31:0]  BASE_PHASE       = 32'd1000000;
+    localparam [11:0]  T90_TARGET       = 12'd3686;   // 90 percent of 4095
+
+    reg clk = 1'b0;
+    always #5 clk = ~clk;
+    reg rst = 1'b1;
+    reg control_tick = 1'b0;
+    reg sample_tick = 1'b0;
+    reg [11:0] pressure_adc = 12'd0;
+    reg [11:0] bend_adc = MID;
+    reg pressure_enable = 1'b1;
+    reg [31:0] base_phase_inc = BASE_PHASE;
+
+    wire [11:0] pressure_filtered;
+    wire [11:0] pressure_level;
+    wire signed [15:0] bend_q8;
+    wire [16:0] bend_ratio_q16;
+    wire [31:0] phase_inc_out;
+
+    reg gate = 1'b0;
+    reg retrigger = 1'b0;
+    wire [15:0] env;
+    wire env_idle;
+
+    pressure_bend dut (
+        .clk(clk), .rst(rst), .control_tick(control_tick),
+        .pressure_adc(pressure_adc), .bend_adc(bend_adc),
+        .pressure_enable(pressure_enable), .base_phase_inc(base_phase_inc),
+        .pressure_filtered(pressure_filtered), .pressure_level(pressure_level),
+        .bend_q8(bend_q8), .bend_ratio_q16(bend_ratio_q16),
+        .phase_inc_out(phase_inc_out)
+    );
+
+    adsr env_dut (
+        .clk(clk), .rst(rst), .sample_tick(sample_tick),
+        .gate(gate), .retrigger(retrigger), .env(env), .idle(env_idle)
+    );
+
+    // Vectors written by tools/pressure_bend_ref.py --vectors sim/vectors
+    reg [11:0] p_in  [0:PRESSURE_VECTORS-1];
+    reg [11:0] p_exp [0:PRESSURE_VECTORS-1];
+    reg [15:0] b_q8  [0:BEND_VECTORS-1];
+    reg [16:0] b_rat [0:BEND_VECTORS-1];
+    reg [31:0] b_ph  [0:BEND_VECTORS-1];
+
+    integer failures;
+    integer i, k;
+    integer t90_ticks;
+    reg [31:0] phase_ref;
+    reg [15:0] env_before;
+
+    task control_step;
+        input [11:0] next_pressure;
+        input [11:0] next_bend;
+        begin
+            @(negedge clk);
+            pressure_adc = next_pressure;
+            bend_adc = next_bend;
+            control_tick = 1'b1;
+            @(posedge clk);
+            #1 control_tick = 1'b0;
+        end
+    endtask
+
+    task audio_step;
+        begin
+            @(negedge clk);
+            sample_tick = 1'b1;
+            @(posedge clk);
+            #1 sample_tick = 1'b0;
+        end
+    endtask
+
+    initial begin
+        $readmemh("sim/vectors/pressure_inputs.hex", p_in);
+        $readmemh("sim/vectors/pressure_expected.hex", p_exp);
+        $readmemh("sim/vectors/bend_q8_expected.hex", b_q8);
+        $readmemh("sim/vectors/bend_ratio_expected.hex", b_rat);
+        $readmemh("sim/vectors/bend_phase_expected.hex", b_ph);
+    end
+
+    initial begin
+        failures = 0;
+        t90_ticks = 0;
+
+        repeat (2) @(negedge clk);
+        rst = 1'b0;
+
+        // ---- 1) pressure filter, value by value -------------------------
+        // The vector sequence is 8 zero ticks, a full scale step, a full
+        // scale step down, a 128 tick ramp, a settled mid value, isolated
+        // spikes and a fixed seed pseudo random tail.
+        for (i = 0; i < PRESSURE_VECTORS; i = i + 1) begin
+            control_step(p_in[i], MID);
+            if (pressure_filtered !== p_exp[i]) begin
+                $display("FAIL pressure tick %0d: adc=%0d dut=%0d ref=%0d",
+                         i, p_in[i], pressure_filtered, p_exp[i]);
+                failures = failures + 1;
+            end
+            if (pressure_level !== pressure_filtered) begin
+                $display("FAIL pressure level tick %0d: level=%0d filtered=%0d",
+                         i, pressure_level, pressure_filtered);
+                failures = failures + 1;
+            end
+            if (phase_inc_out !== BASE_PHASE) begin
+                $display("FAIL pressure tick %0d changed pitch: phase=%0d", i, phase_inc_out);
+                failures = failures + 1;
+            end
+            // 90 percent step metric, counted from the first high input tick
+            if ((t90_ticks == 0) && (p_in[i] == 12'd4095) && (pressure_filtered >= T90_TARGET))
+                t90_ticks = i - 8 + 1;
+        end
+        if (t90_ticks !== 5) begin
+            $display("FAIL 90 percent step response: %0d control ticks", t90_ticks);
+            failures = failures + 1;
+        end
+
+        // ---- 2) bend map and Q16 ratio, every ADC code -------------------
+        for (i = 0; i < BEND_VECTORS; i = i + 1) begin
+            control_step(12'd1000, i[11:0]);
+            if (bend_q8 !== $signed(b_q8[i])) begin
+                $display("FAIL bend q8 at adc=%0d: dut=%0d ref=%0d", i, bend_q8, $signed(b_q8[i]));
+                failures = failures + 1;
+            end
+            if (bend_ratio_q16 !== b_rat[i]) begin
+                $display("FAIL bend ratio at adc=%0d: dut=%0d ref=%0d", i, bend_ratio_q16, b_rat[i]);
+                failures = failures + 1;
+            end
+            if (phase_inc_out !== b_ph[i]) begin
+                $display("FAIL bend phase at adc=%0d: dut=%0d ref=%0d", i, phase_inc_out, b_ph[i]);
+                failures = failures + 1;
+            end
+        end
+        // Bend edges and centre, as required by the task list.
+        control_step(12'd1000, 12'd0);
+        if (bend_q8 !== -16'sd512) begin
+            $display("FAIL bend low edge: q8=%0d", bend_q8);
+            failures = failures + 1;
+        end
+        control_step(12'd1000, MID);
+        if (bend_q8 !== 16'sd0 || phase_inc_out !== BASE_PHASE) begin
+            $display("FAIL bend centre: q8=%0d phase=%0d", bend_q8, phase_inc_out);
+            failures = failures + 1;
+        end
+        control_step(12'd1000, 12'd4095);
+        if (bend_q8 !== 16'sd512) begin
+            $display("FAIL bend high edge: q8=%0d", bend_q8);
+            failures = failures + 1;
+        end
+
+        // A different base increment must scale the same ratio without
+        // truncation surprises.
+        for (k = 0; k < 3; k = k + 1) begin
+            case (k)
+                0: base_phase_inc = 32'd500000;
+                1: base_phase_inc = 32'd2000000;
+                default: base_phase_inc = 32'd4000000;
+            endcase
+            for (i = 0; i < BEND_VECTORS; i = i + 4095) begin
+                control_step(MID, i[11:0]);
+                phase_ref = ({32'd0, base_phase_inc} * {47'd0, b_rat[i]}) >> 16;
+                if (phase_inc_out !== phase_ref) begin
+                    $display("FAIL base=%0d adc=%0d: phase=%0d expected=%0d",
+                             base_phase_inc, i, phase_inc_out, phase_ref);
+                    failures = failures + 1;
+                end
+            end
+        end
+        base_phase_inc = BASE_PHASE;
+
+        // ---- 3) pressure is expression only, and off is still playable ----
+        control_step(MID, MID);
+        phase_ref = phase_inc_out;
+        for (i = 0; i < 4096; i = i + 7) begin
+            control_step(i[11:0], MID);
+            if (phase_inc_out !== phase_ref) begin
+                $display("FAIL pressure sweep changed pitch at adc=%0d: %0d", i, phase_inc_out);
+                failures = failures + 1;
+            end
+        end
+        pressure_enable = 1'b0;
+        control_step(12'd4095, MID);
+        if (pressure_level !== 12'd0 || phase_inc_out !== phase_ref) begin
+            $display("FAIL pressure disable: level=%0d phase=%0d", pressure_level, phase_inc_out);
+            failures = failures + 1;
+        end
+        // With pressure disabled a held note must still run.
+        gate = 1'b1;
+        retrigger = 1'b1;
+        audio_step();
+        retrigger = 1'b0;
+        env_before = env;
+        audio_step();
+        audio_step();
+        if (env_idle || (env <= env_before)) begin
+            $display("FAIL pressure disabled stopped the note: env=%0d idle=%b", env, env_idle);
+            failures = failures + 1;
+        end
+        gate = 1'b0;
+        pressure_enable = 1'b1;
+
+        // ---- 4) bend during a held note must not retrigger the ADSR ------
+        gate = 1'b1;
+        retrigger = 1'b1;
+        audio_step();
+        retrigger = 1'b0;
+        audio_step();
+        env_before = env;
+        control_step(12'd1000, 12'd0);
+        audio_step();
+        if (env <= env_before || env_idle) begin
+            $display("FAIL bend restarted or stopped the held ADSR: before=%0d after=%0d",
+                     env_before, env);
+            failures = failures + 1;
+        end
+
+        if (failures != 0) $fatal(1, "tb_pressure_bend failures=%0d", failures);
+        $display("PASS tb_pressure_bend: %0d pressure ticks and %0d ADC codes match the reference, t90=%0d control ticks",
+                 PRESSURE_VECTORS, BEND_VECTORS, t90_ticks);
+        $finish;
+    end
+
+    initial begin
+        #10_000_000;
+        $fatal(1, "FAIL tb_pressure_bend: timeout");
+    end
+endmodule
\ No newline at end of file
diff --git a/output/handoff_milestone2_20261008/source/sim/tb_s6_audio.v b/output/handoff_milestone2_20261008/source/sim/tb_s6_audio.v
new file mode 100644
index 0000000..45158ec
--- /dev/null
+++ b/output/handoff_milestone2_20261008/source/sim/tb_s6_audio.v
@@ -0,0 +1,341 @@
+`timescale 1ns/1ps
+// S6 self-checking testbench, independent review revision (2026-10-15).
+//
+// The delivered checks (synchronous ROM read, table select, 50/50 blend,
+// saturation without wrap, clip count/clear, FIR register boundary) are kept.
+// On top of them every datapath is now compared value by value against
+// tools/s6_reference.py vectors:
+//   * 2560 phases (all 512 addresses x 5 interpolation fractions, including
+//     the 511 -> 0 wrap seam) through the interpolating reader,
+//   * 1024 ROM cross-fade points (4 addresses x all 256 weights) and 256
+//     interpolated cross-fade points,
+//   * 510 mixer samples across VOLUME_SHIFT 0/1/2 and FIR on/off, checking the
+//     saturated output, the per-frame clip_event and the running clip count,
+//   * a 32-sample small-amplitude FIR sequence that pins unity DC gain (the
+//     delivered revision used a centre tap of 8, i.e. 18/16 gain, which the
+//     old full-scale-only check could not see).
+//
+// Regenerate the vectors with:
+//   python tools/s6_reference.py --vectors output/handoff_milestone2_20261008/source/sim/vectors
+module tb_s6_audio;
+    localparam integer OSC_VECTORS       = 3584;
+    localparam integer BLEND_VECTORS     = 768;
+    localparam integer ROM_BLEND_VECTORS = 1024;
+    localparam integer OSC_BLEND_VECTORS = 256;
+    localparam integer MIX_VECTORS       = 510;
+    localparam integer FIR_VECTORS       = 32;
+
+    reg clk = 1'b0;
+    always #5 clk = ~clk;
+    reg rst = 1'b1;
+
+    reg en = 1'b0;
+    reg [8:0] addr = 9'd0;
+    reg mix_enable = 1'b0;
+    reg [7:0] mix_weight = 8'd0;
+    wire signed [15:0] sine_q, bright_q, sample_q;
+
+    wavetable_rom_dual dut_rom (
+        .clk(clk), .en(en), .addr(addr), .mix_enable(mix_enable),
+        .mix_weight(mix_weight), .sine_q(sine_q), .bright_q(bright_q),
+        .sample_q(sample_q)
+    );
+
+    reg osc_en = 1'b0;
+    reg [31:0] phase = 32'd0;
+    reg osc_mix_enable = 1'b0;
+    reg [7:0] osc_mix_weight = 8'd0;
+    wire signed [15:0] osc_sample;
+    wavetable_osc_dual_s6 dut_osc (
+        .clk(clk), .rst(rst), .en(osc_en), .phase(phase),
+        .mix_enable(osc_mix_enable), .mix_weight(osc_mix_weight),
+        .sample_q(osc_sample)
+    );
+
+    reg sample_tick = 1'b0;
+    reg clear_clip = 1'b0;
+    reg signed [15:0] v0 = 0, v1 = 0, v2 = 0, v3 = 0;
+
+    wire signed [15:0] m_s0_off, m_s1_off, m_s2_off, m_s0_on, m_s1_on, m_s2_on;
+    wire [7:0] c_s0_off, c_s1_off, c_s2_off, c_s0_on, c_s1_on, c_s2_on;
+    wire e_s0_off, e_s1_off, e_s2_off, e_s0_on, e_s1_on, e_s2_on;
+
+    mixer_s6 #(.VOLUME_SHIFT(0), .FIR_ENABLE(0), .CLIP_COUNTER_WIDTH(8)) u_m_s0_off (
+        .clk(clk), .rst(rst), .sample_tick(sample_tick), .clear_clip(clear_clip),
+        .v0(v0), .v1(v1), .v2(v2), .v3(v3), .sample_out(m_s0_off),
+        .clip_count(c_s0_off), .clip_event(e_s0_off));
+    mixer_s6 #(.VOLUME_SHIFT(1), .FIR_ENABLE(0), .CLIP_COUNTER_WIDTH(8)) u_m_s1_off (
+        .clk(clk), .rst(rst), .sample_tick(sample_tick), .clear_clip(clear_clip),
+        .v0(v0), .v1(v1), .v2(v2), .v3(v3), .sample_out(m_s1_off),
+        .clip_count(c_s1_off), .clip_event(e_s1_off));
+    mixer_s6 #(.VOLUME_SHIFT(2), .FIR_ENABLE(0), .CLIP_COUNTER_WIDTH(8)) u_m_s2_off (
+        .clk(clk), .rst(rst), .sample_tick(sample_tick), .clear_clip(clear_clip),
+        .v0(v0), .v1(v1), .v2(v2), .v3(v3), .sample_out(m_s2_off),
+        .clip_count(c_s2_off), .clip_event(e_s2_off));
+    mixer_s6 #(.VOLUME_SHIFT(0), .FIR_ENABLE(1), .CLIP_COUNTER_WIDTH(8)) u_m_s0_on (
+        .clk(clk), .rst(rst), .sample_tick(sample_tick), .clear_clip(clear_clip),
+        .v0(v0), .v1(v1), .v2(v2), .v3(v3), .sample_out(m_s0_on),
+        .clip_count(c_s0_on), .clip_event(e_s0_on));
+    mixer_s6 #(.VOLUME_SHIFT(1), .FIR_ENABLE(1), .CLIP_COUNTER_WIDTH(8)) u_m_s1_on (
+        .clk(clk), .rst(rst), .sample_tick(sample_tick), .clear_clip(clear_clip),
+        .v0(v0), .v1(v1), .v2(v2), .v3(v3), .sample_out(m_s1_on),
+        .clip_count(c_s1_on), .clip_event(e_s1_on));
+    mixer_s6 #(.VOLUME_SHIFT(2), .FIR_ENABLE(1), .CLIP_COUNTER_WIDTH(8)) u_m_s2_on (
+        .clk(clk), .rst(rst), .sample_tick(sample_tick), .clear_clip(clear_clip),
+        .v0(v0), .v1(v1), .v2(v2), .v3(v3), .sample_out(m_s2_on),
+        .clip_count(c_s2_on), .clip_event(e_s2_on));
+
+    // ---- vectors ---------------------------------------------------------
+    reg [31:0] osc_phase [0:OSC_VECTORS-1];
+    reg [15:0] osc_sine_exp [0:OSC_VECTORS-1];
+    reg [15:0] osc_bright_exp [0:OSC_VECTORS-1];
+    reg [15:0] bl_a [0:BLEND_VECTORS-1];
+    reg [15:0] bl_b [0:BLEND_VECTORS-1];
+    reg [7:0]  bl_w [0:BLEND_VECTORS-1];
+    reg [15:0] bl_exp [0:BLEND_VECTORS-1];
+    reg [8:0]  rb_addr [0:ROM_BLEND_VECTORS-1];
+    reg [7:0]  rb_w [0:ROM_BLEND_VECTORS-1];
+    reg [15:0] rb_exp [0:ROM_BLEND_VECTORS-1];
+    reg [31:0] ob_phase [0:OSC_BLEND_VECTORS-1];
+    reg [7:0]  ob_w [0:OSC_BLEND_VECTORS-1];
+    reg [15:0] ob_exp [0:OSC_BLEND_VECTORS-1];
+    reg [15:0] mx_v0 [0:MIX_VECTORS-1], mx_v1 [0:MIX_VECTORS-1];
+    reg [15:0] mx_v2 [0:MIX_VECTORS-1], mx_v3 [0:MIX_VECTORS-1];
+    reg [3:0]  mx_shift [0:MIX_VECTORS-1];
+    reg [3:0]  mx_fir [0:MIX_VECTORS-1];
+    reg [15:0] mx_exp [0:MIX_VECTORS-1];
+    reg [3:0]  mx_rawclip [0:MIX_VECTORS-1];
+    reg [3:0]  mx_firclip [0:MIX_VECTORS-1];
+    reg [7:0]  mx_count [0:MIX_VECTORS-1];
+    reg [15:0] fir_in [0:FIR_VECTORS-1];
+    reg [15:0] fir_exp [0:FIR_VECTORS-1];
+
+    integer failures;
+    integer i, k, idx;
+    reg signed [15:0] cur_out;
+    reg cur_ev;
+    reg [7:0] cur_cnt;
+
+    task tick;
+        begin
+            sample_tick = 1'b1;
+            @(posedge clk);
+            #1 sample_tick = 1'b0;
+        end
+    endtask
+
+    initial begin
+        $readmemh("sim/vectors/osc_phase.hex", osc_phase);
+        $readmemh("sim/vectors/osc_sine_expected.hex", osc_sine_exp);
+        $readmemh("sim/vectors/osc_bright_expected.hex", osc_bright_exp);
+        $readmemh("sim/vectors/blend_a.hex", bl_a);
+        $readmemh("sim/vectors/blend_b.hex", bl_b);
+        $readmemh("sim/vectors/blend_weight.hex", bl_w);
+        $readmemh("sim/vectors/blend_expected.hex", bl_exp);
+        $readmemh("sim/vectors/rom_blend_addr.hex", rb_addr);
+        $readmemh("sim/vectors/rom_blend_weight.hex", rb_w);
+        $readmemh("sim/vectors/rom_blend_expected.hex", rb_exp);
+        $readmemh("sim/vectors/osc_blend_phase.hex", ob_phase);
+        $readmemh("sim/vectors/osc_blend_weight.hex", ob_w);
+        $readmemh("sim/vectors/osc_blend_expected.hex", ob_exp);
+        $readmemh("sim/vectors/mix_v0.hex", mx_v0);
+        $readmemh("sim/vectors/mix_v1.hex", mx_v1);
+        $readmemh("sim/vectors/mix_v2.hex", mx_v2);
+        $readmemh("sim/vectors/mix_v3.hex", mx_v3);
+        $readmemh("sim/vectors/mix_shift.hex", mx_shift);
+        $readmemh("sim/vectors/mix_fir.hex", mx_fir);
+        $readmemh("sim/vectors/mix_expected.hex", mx_exp);
+        $readmemh("sim/vectors/mix_rawclip.hex", mx_rawclip);
+        $readmemh("sim/vectors/mix_firclip.hex", mx_firclip);
+        $readmemh("sim/vectors/mix_count.hex", mx_count);
+        $readmemh("sim/vectors/fir_input.hex", fir_in);
+        $readmemh("sim/vectors/fir_expected.hex", fir_exp);
+    end
+
+    initial begin
+        failures = 0;
+        repeat (2) @(posedge clk);
+        rst = 1'b0;
+
+        // ---- delivered qualitative checks --------------------------------
+        en = 1'b1;
+        addr = 9'd0;
+        @(posedge clk); #1;
+        if (sine_q !== 16'sh0000 || bright_q !== 16'sh0000) begin
+            $display("FAIL ROM address 0 mismatch: sine=%h bright=%h", sine_q, bright_q);
+            failures = failures + 1;
+        end
+        addr = 9'd128;
+        if (sine_q !== 16'sh0000) begin
+            $display("FAIL ROM changed before synchronous edge");
+            failures = failures + 1;
+        end
+        @(posedge clk); #1;
+        if (sine_q !== 16'sh7fff || bright_q !== 16'sh36e6) begin
+            $display("FAIL ROM address 128 mismatch: sine=%h bright=%h", sine_q, bright_q);
+            failures = failures + 1;
+        end
+        mix_enable = 1'b0;
+        mix_weight = 8'hff;
+        #1;
+        if (sample_q !== bright_q) begin
+            $display("FAIL bright table selection mismatch sample=%h bright=%h", sample_q, bright_q);
+            failures = failures + 1;
+        end
+        mix_enable = 1'b1;
+        mix_weight = 8'd128;
+        #1;
+        if ((sample_q > 16'sh5af4) || (sample_q < 16'sh5af2)) begin
+            $display("FAIL 50/50 blend mismatch: %0d", sample_q);
+            failures = failures + 1;
+        end
+
+        // ---- ROM cross-fade: 4 addresses x all 256 weights ---------------
+        mix_enable = 1'b1;
+        for (i = 0; i < ROM_BLEND_VECTORS; i = i + 1) begin
+            if ((i == 0) || (rb_addr[i] !== rb_addr[i-1])) begin
+                addr = rb_addr[i];
+                @(posedge clk); #1;
+            end
+            mix_weight = rb_w[i];
+            #1;
+            if (sample_q !== $signed(rb_exp[i])) begin
+                $display("FAIL rom blend addr=%0d w=%0d: dut=%0d ref=%0d",
+                         rb_addr[i], rb_w[i], sample_q, $signed(rb_exp[i]));
+                failures = failures + 1;
+            end
+        end
+        mix_enable = 1'b0;
+        mix_weight = 8'd0;
+
+        // ---- interpolating reader: every address x five fractions --------
+        osc_en = 1'b1;
+        mix_enable = 1'b0;
+        for (i = 0; i < OSC_VECTORS; i = i + 1) begin
+            phase = osc_phase[i];
+            osc_mix_enable = 1'b0;
+            osc_mix_weight = 8'd0;
+            @(posedge clk);              // request the adjacent entries
+            @(posedge clk); #1;          // expose the interpolated sample
+            if (osc_sample !== $signed(osc_sine_exp[i])) begin
+                $display("FAIL osc sine phase=%h: dut=%0d ref=%0d",
+                         osc_phase[i], osc_sample, $signed(osc_sine_exp[i]));
+                failures = failures + 1;
+            end
+            osc_mix_weight = 8'hff;
+            @(posedge clk); #1;
+            if (osc_sample !== $signed(osc_bright_exp[i])) begin
+                $display("FAIL osc bright phase=%h: dut=%0d ref=%0d",
+                         osc_phase[i], osc_sample, $signed(osc_bright_exp[i]));
+                failures = failures + 1;
+            end
+            osc_mix_weight = 8'd0;
+        end
+
+        // ---- interpolated cross-fade: one phase, all 256 weights ---------
+        phase = ob_phase[0];
+        osc_mix_enable = 1'b1;
+        osc_mix_weight = 8'd0;
+        @(posedge clk);
+        @(posedge clk); #1;
+        for (i = 0; i < OSC_BLEND_VECTORS; i = i + 1) begin
+            osc_mix_weight = ob_w[i];
+            @(posedge clk); #1;
+            if (osc_sample !== $signed(ob_exp[i])) begin
+                $display("FAIL osc blend w=%0d: dut=%0d ref=%0d",
+                         ob_w[i], osc_sample, $signed(ob_exp[i]));
+                failures = failures + 1;
+            end
+        end
+        osc_mix_enable = 1'b0;
+
+        // ---- mixer: 510 vectors over volume shift and FIR path ------------
+        for (i = 0; i < MIX_VECTORS; i = i + 1) begin
+            v0 = mx_v0[i]; v1 = mx_v1[i]; v2 = mx_v2[i]; v3 = mx_v3[i];
+            tick();
+            // the registered output is only valid after the sample tick
+            idx = (mx_shift[i] * 2) + mx_fir[i];
+            case (idx)
+                0: begin cur_out = m_s0_off; cur_ev = e_s0_off; cur_cnt = c_s0_off; end
+                1: begin cur_out = m_s0_on;  cur_ev = e_s0_on;  cur_cnt = c_s0_on;  end
+                2: begin cur_out = m_s1_off; cur_ev = e_s1_off; cur_cnt = c_s1_off; end
+                3: begin cur_out = m_s1_on;  cur_ev = e_s1_on;  cur_cnt = c_s1_on;  end
+                4: begin cur_out = m_s2_off; cur_ev = e_s2_off; cur_cnt = c_s2_off; end
+                default: begin cur_out = m_s2_on; cur_ev = e_s2_on; cur_cnt = c_s2_on; end
+            endcase
+            if (cur_out !== $signed(mx_exp[i])) begin
+                $display("FAIL mixer vec %0d shift=%0d fir=%0d: dut=%0d ref=%0d",
+                         i, mx_shift[i], mx_fir[i], cur_out, $signed(mx_exp[i]));
+                failures = failures + 1;
+            end
+            if (cur_ev !== (mx_rawclip[i] != 0)) begin
+                $display("FAIL mixer vec %0d clip_event=%b raw_clip=%0d",
+                         i, cur_ev, mx_rawclip[i]);
+                failures = failures + 1;
+            end
+            if (cur_cnt !== mx_count[i]) begin
+                $display("FAIL mixer vec %0d clip_count=%0d expected=%0d", i, cur_cnt, mx_count[i]);
+                failures = failures + 1;
+            end
+        end
+
+        // ---- small amplitude FIR sequence: unity gain ---------------------
+        v0 = 0; v1 = 0; v2 = 0; v3 = 0;
+        repeat (4) tick();
+        for (i = 0; i < FIR_VECTORS; i = i + 1) begin
+            v0 = fir_in[i];
+            tick();
+            if (m_s0_on !== $signed(fir_exp[i])) begin
+                $display("FAIL fir vec %0d in=%0d: dut=%0d ref=%0d",
+                         i, $signed(fir_in[i]), m_s0_on, $signed(fir_exp[i]));
+                failures = failures + 1;
+            end
+        end
+        v0 = 0; v1 = 0; v2 = 0; v3 = 0;
+
+        // ---- delivered clip/extrema and FIR boundary checks ---------------
+        v0 = 16'sh7fff; v1 = 16'sh7fff; v2 = 16'sh7fff; v3 = 16'sh7fff;
+        tick();
+        if (m_s1_off !== 16'sh7fff || !e_s1_off) begin
+            $display("FAIL positive saturation sample=%h event=%b", m_s1_off, e_s1_off);
+            failures = failures + 1;
+        end
+        v0 = -16'sh8000; v1 = -16'sh8000; v2 = -16'sh8000; v3 = -16'sh8000;
+        tick();
+        if (m_s1_off !== -16'sh8000 || !e_s1_off) begin
+            $display("FAIL negative saturation sample=%h event=%b", m_s1_off, e_s1_off);
+            failures = failures + 1;
+        end
+        clear_clip = 1'b1;
+        tick();
+        clear_clip = 1'b0;
+        if (c_s1_off !== 8'd0 || c_s1_on !== 8'd0) begin
+            $display("FAIL clip counter did not clear: off=%0d on=%0d", c_s1_off, c_s1_on);
+            failures = failures + 1;
+        end
+
+        v0 = 16'sd0; v1 = 16'sd0; v2 = 16'sd0; v3 = 16'sd0;
+        repeat (4) tick();
+        v0 = 16'sh7fff; v1 = 16'sh7fff; v2 = 16'sh7fff; v3 = 16'sh7fff;
+        tick();
+        if (m_s1_on !== 16'sd2047) begin
+            $display("FAIL FIR first-sample latency/weight mismatch: %0d", m_s1_on);
+            failures = failures + 1;
+        end
+        repeat (4) tick();
+        if (m_s1_on !== 16'sh7fff) begin
+            $display("FAIL FIR steady-state saturation mismatch: %h", m_s1_on);
+            failures = failures + 1;
+        end
+
+        if (failures != 0) $fatal(1, "tb_s6_audio failures=%0d", failures);
+        $display("PASS tb_s6_audio: ROM sync/select, %0d osc vectors, %0d+%0d blend points, %0d mixer vectors, %0d FIR samples",
+                 OSC_VECTORS, ROM_BLEND_VECTORS, OSC_BLEND_VECTORS, MIX_VECTORS, FIR_VECTORS);
+        $finish;
+    end
+
+    initial begin
+        #2_000_000;
+        $fatal(1, "FAIL tb_s6_audio: timeout");
+    end
+endmodule
\ No newline at end of file
diff --git a/output/handoff_milestone2_20261008/source/sim/tb_song_backpressure.v b/output/handoff_milestone2_20261008/source/sim/tb_song_backpressure.v
new file mode 100644
index 0000000..e6ef963
--- /dev/null
+++ b/output/handoff_milestone2_20261008/source/sim/tb_song_backpressure.v
@@ -0,0 +1,32 @@
+`timescale 1ns/1ps
+module tb_song_backpressure;
+    reg clk = 0, rst = 1, ready = 0;
+    wire ev_wr;
+    wire [15:0] ev_data;
+    integer held_word, i, accepts = 0;
+    song_player #(.UNIT_SAMPLES(1)) dut (
+        .clk(clk), .rst(rst), .sample_tick(1'b1), .restart(1'b0),
+        .chord_set(1'b0), .tempo_sel(2'd0), .ev_ready(ready),
+        .ev_wr(ev_wr), .ev_data(ev_data), .mel_idx_dbg(), .chord_idx_dbg()
+    );
+    always #5 clk = ~clk;
+    initial begin
+        @(negedge clk); rst = 0;
+        wait (ev_wr);
+        held_word = ev_data;
+        for (i = 0; i < 24; i = i + 1) begin
+            @(negedge clk);
+            if (!ev_wr || ev_data !== held_word)
+                $fatal(1, "Song event changed under backpressure");
+        end
+        ready = 1;
+        repeat (20) begin
+            @(posedge clk);
+            if (ev_wr && ready) accepts = accepts + 1;
+        end
+        if (accepts < 4) $fatal(1, "Song did not drain its burst");
+        $display("PASS tb_song_backpressure: event held and burst drained");
+        $finish;
+    end
+    initial begin #100000; $fatal(1, "Song backpressure timeout"); end
+endmodule
diff --git a/output/handoff_milestone2_20261008/source/sim/tb_song_timing.v b/output/handoff_milestone2_20261008/source/sim/tb_song_timing.v
new file mode 100644
index 0000000..13a9eac
--- /dev/null
+++ b/output/handoff_milestone2_20261008/source/sim/tb_song_timing.v
@@ -0,0 +1,105 @@
+`timescale 1ns/1ps
+
+// Check that one pass through the tune really takes the length the song data
+// says it does, and that every note of the melody and every chord note is
+// emitted exactly once per pass.
+//
+// The expected numbers come from the same generated header the RTL uses, so a
+// change to the song data cannot silently stop being tested.
+module tb_song_timing;
+    parameter SAMPLE_DIV    = 4;
+    parameter TEMPO_SEL     = 2'd1;      // the shipped power-on default
+    parameter MAX_TICKS     = 40000000;
+
+    `include "rtl/audio/song_expect.vh"
+
+    reg clk = 1'b0;
+    reg rst = 1'b1;
+    reg sample_tick = 1'b0;
+    reg restart = 1'b0;
+    reg chord_set = 1'b0;
+    reg [1:0] tempo_sel = TEMPO_SEL;
+
+    wire        ev_wr;
+    wire [15:0] ev_data;
+    wire [5:0]  mel_idx_dbg;
+    wire [4:0]  chord_idx_dbg;
+
+    song_player dut (
+        .clk          (clk),
+        .rst          (rst),
+        .sample_tick  (sample_tick),
+        .restart      (restart),
+        .chord_set    (chord_set),
+        .tempo_sel    (tempo_sel),
+        .ev_ready     (1'b1),
+        .ev_wr        (ev_wr),
+        .ev_data      (ev_data),
+        .mel_idx_dbg  (mel_idx_dbg),
+        .chord_idx_dbg(chord_idx_dbg)
+    );
+
+    always #5 clk = ~clk;
+
+    reg [3:0] div = 4'd0;
+    always @(posedge clk) begin
+        if (div == SAMPLE_DIV - 1) begin
+            div <= 4'd0;
+            sample_tick <= 1'b1;
+        end else begin
+            div <= div + 4'd1;
+            sample_tick <= 1'b0;
+        end
+    end
+
+    localparam integer EXPECTED_PASS_TICKS =
+        SONG_TOTAL_UNITS * SONG_UNIT_SAMPLES * (TEMPO_SEL + 1);
+    localparam integer EXPECTED_NOTE_ONS =
+        SONG_MELODY_NOTES + SONG_CHORD_NOTES;
+
+    integer ticks = 0;
+    integer note_ons = 0;
+    integer last_wrap = 0;
+    integer last_wrap_notes = 0;
+    integer wraps = 0;
+    reg [5:0] mel_d = 6'd0;
+
+    always @(posedge clk) begin
+        if (sample_tick)
+            ticks = ticks + 1;
+
+        if (ev_wr && ev_data[15] && (ev_data[14:8] != 8'd0))
+            note_ons = note_ons + 1;
+
+        mel_d <= mel_idx_dbg;
+        if ((mel_idx_dbg == 6'd0) && (mel_d != 6'd0)) begin
+            wraps = wraps + 1;
+            $display("pass %0d complete at tick %0d, delta %0d, note ons %0d",
+                     wraps, ticks, ticks - last_wrap, note_ons - last_wrap_notes);
+            if (wraps >= 2) begin
+                if ((ticks - last_wrap) != EXPECTED_PASS_TICKS)
+                    $fatal(1, "FAIL tb_song_timing: pass is %0d ticks, expected %0d",
+                           ticks - last_wrap, EXPECTED_PASS_TICKS);
+                if ((note_ons - last_wrap_notes) != EXPECTED_NOTE_ONS)
+                    $fatal(1, "FAIL tb_song_timing: %0d note events, expected %0d",
+                           note_ons - last_wrap_notes, EXPECTED_NOTE_ONS);
+                $display("PASS tb_song_timing: pass = %0d ticks, %0d note events",
+                         EXPECTED_PASS_TICKS, EXPECTED_NOTE_ONS);
+                $finish;
+            end
+            last_wrap = ticks;
+            last_wrap_notes = note_ons;
+        end
+    end
+
+    initial begin
+        #200;
+        rst = 1'b0;
+        $display("expecting pass = %0d units x %0d samples x %0d = %0d ticks, %0d note events",
+                 SONG_TOTAL_UNITS, SONG_UNIT_SAMPLES, TEMPO_SEL + 1,
+                 EXPECTED_PASS_TICKS, EXPECTED_NOTE_ONS);
+        #(MAX_TICKS * SAMPLE_DIV * 10);
+        $fatal(1, "FAIL tb_song_timing: timeout after %0d ticks, %0d passes",
+               ticks, wraps);
+    end
+endmodule
diff --git a/output/handoff_milestone2_20261008/source/sim/tb_tick_rate.v b/output/handoff_milestone2_20261008/source/sim/tb_tick_rate.v
new file mode 100644
index 0000000..86dab8d
--- /dev/null
+++ b/output/handoff_milestone2_20261008/source/sim/tb_tick_rate.v
@@ -0,0 +1,69 @@
+`timescale 1ns/1ps
+
+// Check the PT8211 frame rate.
+//
+// Nominal: BCK = 27 MHz / 18 = 1.5 MHz and one frame is 32 BCK, so a new
+// sample_tick must arrive every 576 clocks.  If this test fails the pitch and
+// every timing derived from it are wrong, so it is the first gate.
+module tb_tick_rate;
+    parameter EXPECTED_CLOCKS = 576;
+    parameter TOLERANCE       = 1;
+
+    reg clk = 1'b0;
+    reg rst = 1'b1;
+    reg signed [15:0] sample_in = 16'sd0;
+
+    wire bck, ws, din, sample_tick;
+
+    always #18.5185 clk = ~clk;      // 27 MHz
+
+    pt8211_tx dut (
+        .clk         (clk),
+        .rst         (rst),
+        .sample_in   (sample_in),
+        .bck         (bck),
+        .ws          (ws),
+        .din         (din),
+        .sample_tick (sample_tick)
+    );
+
+    integer clocks = 0;
+    integer ticks = 0;
+    integer last_tick_clock = 0;
+    integer checked = 0;
+    integer bad = 0;
+
+    always @(posedge clk) begin
+        clocks = clocks + 1;
+        if (sample_tick) begin
+            ticks = ticks + 1;
+            if (ticks > 1) begin
+                checked = checked + 1;
+                if ((clocks - last_tick_clock) < EXPECTED_CLOCKS - TOLERANCE ||
+                    (clocks - last_tick_clock) > EXPECTED_CLOCKS + TOLERANCE) begin
+                    bad = bad + 1;
+                    $display("FAIL: sample_tick period %0d clocks, expected %0d",
+                             clocks - last_tick_clock, EXPECTED_CLOCKS);
+                end
+            end
+            last_tick_clock = clocks;
+        end
+    end
+
+    initial begin
+        #1000;
+        rst = 1'b0;
+        sample_in = 16'sh2000;
+        #4000000;
+        if (checked == 0)
+            $fatal(1, "FAIL tb_tick_rate: no sample_tick seen");
+        if (bad != 0)
+            $fatal(1, "FAIL tb_tick_rate: %0d of %0d periods wrong", bad, checked);
+        $display("PASS tb_tick_rate: %0d periods, all %0d clocks (%0.1f Hz)",
+                 checked, EXPECTED_CLOCKS,
+                 // #18.5185 是半周期；频率显示用完整的 37.037 ns。
+                 // 此显示公式不改变上面的时钟计数/容差断言。
+                 checked * 1.0e9 / (checked * EXPECTED_CLOCKS * 37.037));
+        $finish;
+    end
+endmodule
diff --git a/output/handoff_milestone2_20261008/source/sim/tb_voice_order.v b/output/handoff_milestone2_20261008/source/sim/tb_voice_order.v
new file mode 100644
index 0000000..dda8c98
--- /dev/null
+++ b/output/handoff_milestone2_20261008/source/sim/tb_voice_order.v
@@ -0,0 +1,62 @@
+`timescale 1ns/1ps
+
+// More than 65536 Note Ons must not corrupt the oldest-voice decision.
+module tb_voice_order;
+    reg clk = 1'b0;
+    reg rst = 1'b1;
+    reg ev_valid = 1'b0;
+    reg [6:0] ev_note = 7'd0;
+    wire [3:0] v_gate;
+    wire [27:0] v_note;
+    wire [31:0] v_vel;
+    wire [3:0] v_start;
+    integer n;
+
+    always #5 clk = ~clk;
+
+    voice_alloc dut (
+        .clk(clk), .rst(rst), .ev_valid(ev_valid), .ev_on(1'b1),
+        .ev_note(ev_note), .ev_vel(8'd100), .panic(1'b0),
+        .voice_idle(4'b1111), .v_gate(v_gate), .v_note(v_note),
+        .v_vel(v_vel), .v_start(v_start), .v_busy()
+    );
+
+    task note_on;
+        input [6:0] note;
+        begin
+            @(negedge clk);
+            ev_note = note;
+            ev_valid = 1'b1;
+            @(posedge clk);
+            #1;
+            @(negedge clk);
+            ev_valid = 1'b0;
+        end
+    endtask
+
+    initial begin
+        repeat (2) @(negedge clk);
+        rst = 1'b0;
+        note_on(7'd60);
+        for (n = 0; n < 65533; n = n + 1)
+            note_on(7'd60);
+        note_on(7'd62);
+        note_on(7'd64);
+        note_on(7'd65);
+        if (v_gate !== 4'b1111 || v_note[6:0] !== 7'd60 ||
+            v_note[13:7] !== 7'd62 || v_note[20:14] !== 7'd64 ||
+            v_note[27:21] !== 7'd65)
+            $fatal(1, "voice-order setup failed");
+        note_on(7'd67);
+        if (v_note[6:0] !== 7'd67 || v_note[27:21] !== 7'd65 ||
+            v_start !== 4'b0001)
+            $fatal(1, "oldest voice not stolen after 16-bit counter rollover");
+        $display("PASS tb_voice_order: oldest voice remains correct after 65538 Note Ons");
+        $finish;
+    end
+
+    initial begin
+        #3000000;
+        $fatal(1, "tb_voice_order timeout");
+    end
+endmodule
diff --git a/output/handoff_milestone2_20261008/source/sim/tb_voice_retrigger.v b/output/handoff_milestone2_20261008/source/sim/tb_voice_retrigger.v
new file mode 100644
index 0000000..607d430
--- /dev/null
+++ b/output/handoff_milestone2_20261008/source/sim/tb_voice_retrigger.v
@@ -0,0 +1,138 @@
+`timescale 1ns/1ps
+
+// Exercise the allocator together with real voice envelopes and oscillators.
+module tb_voice_retrigger;
+    reg clk = 1'b0;
+    reg rst = 1'b1;
+    reg sample_tick = 1'b0;
+    reg ev_valid = 1'b0;
+    reg ev_on = 1'b0;
+    reg [6:0] ev_note = 7'd0;
+    reg [7:0] ev_vel = 8'd100;
+    reg panic = 1'b0;
+    wire [3:0] voice_idle;
+    wire [3:0] v_gate;
+    wire [27:0] v_note;
+    wire [31:0] v_vel;
+    wire [3:0] v_start;
+    integer n;
+
+    always #5 clk = ~clk;
+
+    voice_alloc dut (
+        .clk(clk), .rst(rst), .ev_valid(ev_valid), .ev_on(ev_on),
+        .ev_note(ev_note), .ev_vel(ev_vel), .panic(panic),
+        .voice_idle(voice_idle), .v_gate(v_gate), .v_note(v_note),
+        .v_vel(v_vel), .v_start(v_start), .v_busy()
+    );
+
+    genvar g;
+    generate for (g = 0; g < 4; g = g + 1) begin: voices
+        wire [31:0] inc;
+        wire signed [15:0] audio;
+        note_phase_inc u_inc (.note(v_note[g*7 +: 7]), .inc(inc));
+        poly_voice u_voice (
+            .clk(clk), .rst(rst), .sample_tick(sample_tick),
+            .gate(v_gate[g]), .start(v_start[g]), .phase_inc(inc),
+            .velocity(v_vel[g*8 +: 8]), .sample(audio), .idle(voice_idle[g])
+        );
+    end endgenerate
+
+    task note_event;
+        input on;
+        input [6:0] note;
+        begin
+            @(negedge clk);
+            ev_valid = 1'b1;
+            ev_on = on;
+            ev_note = note;
+            @(posedge clk);
+            #1;
+            @(negedge clk);
+            ev_valid = 1'b0;
+        end
+    endtask
+
+    task audio_tick;
+        begin
+            @(negedge clk);
+            sample_tick = 1'b1;
+            @(posedge clk);
+            #1 sample_tick = 1'b0;
+        end
+    endtask
+
+    initial begin
+        repeat (2) @(negedge clk);
+        rst = 1'b0;
+
+        note_event(1'b1, 7'd60);
+        if (v_gate !== 4'b0001 || v_start !== 4'b0001 || v_note[6:0] !== 7'd60)
+            $fatal(1, "first note did not allocate voice 0");
+        audio_tick();
+        audio_tick();
+        if (voices[0].u_voice.u_adsr.env == 0 || voices[0].u_voice.u_dds.phase == 0)
+            $fatal(1, "first voice did not start");
+
+        // A held note reuses its own voice, even while three free voices exist.
+        note_event(1'b1, 7'd60);
+        if (v_gate !== 4'b0001 || v_start !== 4'b0001)
+            $fatal(1, "repeated note allocated a duplicate voice");
+        audio_tick();
+        if (voices[0].u_voice.u_adsr.env !== 16'd0 ||
+            voices[0].u_voice.u_adsr.state !== 3'd1 ||
+            voices[0].u_voice.u_dds.phase !== 32'd0 || v_start !== 4'b0000)
+            $fatal(1, "repeated note did not restart phase and attack");
+        audio_tick();
+
+        note_event(1'b1, 7'd62);
+        audio_tick();
+        note_event(1'b1, 7'd64);
+        audio_tick();
+        note_event(1'b1, 7'd65);
+        audio_tick();
+        if (v_gate !== 4'b1111 || voices[0].u_voice.u_adsr.env == 0)
+            $fatal(1, "four-voice setup failed");
+
+        // With every voice held, the oldest note (voice 0) is stolen.
+        note_event(1'b1, 7'd67);
+        if (v_note[6:0] !== 7'd67 || v_start !== 4'b0001 || v_gate !== 4'b1111)
+            $fatal(1, "full-polyphony steal did not choose the oldest voice");
+        audio_tick();
+        if (voices[0].u_voice.u_adsr.env !== 16'd0 ||
+            voices[0].u_voice.u_adsr.state !== 3'd1 ||
+            voices[0].u_voice.u_dds.phase !== 32'd0)
+            $fatal(1, "stolen voice retained its old envelope or phase");
+        audio_tick();
+        note_event(1'b0, 7'd60);
+        if (v_gate[0] !== 1'b1 || v_note[6:0] !== 7'd67)
+            $fatal(1, "old note-off silenced a stolen voice's new note");
+
+        // A note in release is reused before any still-held note is stolen.
+        note_event(1'b0, 7'd62);
+        audio_tick();
+        if (v_gate[1] !== 1'b0 || voice_idle[1] !== 1'b0)
+            $fatal(1, "released voice setup failed");
+        note_event(1'b1, 7'd69);
+        if (v_gate[1] !== 1'b1 || v_note[13:7] !== 7'd69 || v_start !== 4'b0010)
+            $fatal(1, "released voice was not reused first");
+        audio_tick();
+        if (voices[1].u_voice.u_adsr.env !== 16'd0 ||
+            voices[1].u_voice.u_adsr.state !== 3'd1)
+            $fatal(1, "reused released voice did not restart");
+        audio_tick();
+        note_event(1'b0, 7'd69);
+        audio_tick();
+        for (n = 0; n < 20 && !voice_idle[1]; n = n + 1) audio_tick();
+        if (!voice_idle[1] || voices[1].u_voice.u_adsr.env !== 16'd0)
+            $fatal(1, "reused voice did not finish release");
+
+        $display("PASS tb_voice_retrigger: repeat, held steal, release reuse and drain");
+        $finish;
+    end
+
+    initial begin
+        #1000000;
+        $fatal(1, "tb_voice_retrigger timeout");
+    end
+endmodule
