diff --git a/archive/FPGA-20261015-v0.9/source/rtl/README.md b/archive/FPGA-20261015-v0.9/source/rtl/README.md
new file mode 100644
index 0000000..bcbb7a8
--- /dev/null
+++ b/archive/FPGA-20261015-v0.9/source/rtl/README.md
@@ -0,0 +1,66 @@
+# Instrument RTL
+
+Current milestone: four-voice polyphony with a built-in test tune.
+
+v1.0.0 publishes the previously programmed SRAM 0x5633 functional baseline
+with clarified comments. See the repository-root README and
+`docs/releases/v1.0.0-code-guide.md` for the Chinese code guide and
+`docs/releases/v1.0.0-validation.json` for release verification.
+
+- `top.v`: wiring, reset tree, key handling, LED indicators.
+- `audio/note_phase_inc.v`: MIDI note to 32 bit phase increment.
+- `audio/dds_osc.v`: interpolating single-cycle wavetable oscillator.
+- `audio/adsr.v`: envelope with parameterised step sizes.
+- `audio/poly_voice.v`: one voice (oscillator, envelope, velocity).
+- `audio/event_fifo.v`: note event queue between the sequencer and the allocator.
+- `audio/voice_alloc.v`: four-voice allocator, the keyboard interface.
+- `audio/song_player.v`: test tune sequencer with two chord sets.
+- `audio/mixer.v`: sum, master level, saturation, smoothing.
+- `audio/uart_ctrl.v`: serial note control.
+- `audio/pt8211_tx.v`: on-board PT8211 debug DAC transmitter.
+- `audio/mcp3208_spi.v`: independent mode-0 MCP3208 master (19-clock DS21298E frame: start, single ended, channel, one don't care clock, null bit on clock 7, B11..B0 on clocks 8..19); `done/data_valid`
+  commits the complete 12-bit code on the last falling edge without stalling audio. Frame alignment review: `docs/evidence/s4-review-20261015/README.md`.
+- `audio/pressure_bend.v`: bounded FSR pressure filter (three-sample median
+  plus `y += (median-y) >>> 1`) and continuous +/-2 semitone bend mapping.
+  Pressure is expression-only; bend changes the DDS phase increment without
+  retriggering ADSR. `sim/tb_pressure_bend.v` compares 640 pressure ticks and
+  all 4096 bend ADC codes against `tools/pressure_bend_ref.py`; regenerate
+  `sim/vectors/` with `python tools/pressure_bend_ref.py --vectors sim/vectors`
+  whenever the reference changes. Review: `docs/evidence/s5-review-20261015/`.
+- `audio/wavetable_rom_dual.v`: two synchronous 512x16 table model with
+  selectable/cross-faded output; replace the arrays with Gowin BSRAM IP for
+  production hardware.
+- `audio/wavetable_osc_dual_s6.v`: adjacent-entry synchronous reader with
+  9-bit phase interpolation and wraparound.
+- `audio/mixer_s6.v`: four-voice saturated mixer with explicit FIR bypass and
+  master-gain clip counter.
+
+Pins:
+
+- `clk_27m`: H11, Dock 3714 27 MHz oscillator.
+- `hp_bck/hp_ws/hp_din`: N15/P16/P15, on-board PT8211 debug DAC.
+- `pa_en`: R16, headphone amplifier enable.
+- `led`: N16, run indicator. `led_chord`: N14, chord set indicator.
+- `key_rst` D7, `key_s1` T3, `key_s2` T2. `key_s4`/B10 is RECONFIG_N.
+- `uart_tx` M11, `uart_rx` T13, the BL702 USB-UART bridge on bank 2.
+
+On power-up the built-in tune runs. Sending `N1`..`N127`, `O1`..`O127`, or
+`X` enters manual mode and clears queued demo notes. `D0` selects manual mode
+explicitly; `D1` clears active voices and restarts the tune. `M0`/`M1` mute
+or unmute the DAC stream without changing mode. Commands use 115200 8N1,
+end with CR or LF, and receive `OK` or `ERR`. The old `F` command is rejected.
+The host should wait for each reply before sending the next command; a
+16-entry reply queue absorbs short bursts and counts overflow.
+
+Nothing here uses a soft CPU: every sample is generated by RTL. External GPIO
+keys, optional touch, ADC and standard I2S to PCM5102A are still to come.
+Continuous multi-key input needs its own buffering/handshake before joining
+the allocator; it must not be wired directly to the sparse UART event seam.
+
+Each accepted Note On also produces a one-clock `v_start` pulse for the chosen
+voice. `poly_voice` keeps that pulse until the next audio sample tick, then
+restarts its ADSR attack and oscillator phase together. A repeated held note
+uses its existing voice; otherwise the allocator prefers an idle voice, a
+releasing voice, then the oldest held voice. Relative age ranks avoid counter
+wrap during long performances. The fourteen self-checking testbenches in
+`../sim/run_simulation.ps1` must pass before any programming.
\ No newline at end of file
diff --git a/archive/FPGA-20261015-v0.9/source/rtl/audio/pressure_bend.v b/archive/FPGA-20261015-v0.9/source/rtl/audio/pressure_bend.v
new file mode 100644
index 0000000..a87197c
--- /dev/null
+++ b/archive/FPGA-20261015-v0.9/source/rtl/audio/pressure_bend.v
@@ -0,0 +1,149 @@
+// S5 control path: bounded pressure filtering and a continuous +/-2 semitone
+// pitch bend.  The control inputs are sampled only on control_tick (normally
+// a 2 kHz scheduler); the audio phase increment is combinational, so changing
+// the potentiometer does not retrigger a voice envelope.
+//
+// pressure_filtered is a three-sample median followed by the fixed-point IIR
+// y += (median - y) >>> 1.  pressure_level is zero when pressure_enable is
+// low, but the filter state is still updated so enabling it does not inject an
+// old stale sample.  Pressure is deliberately not part of phase_inc_out.
+//
+// bend_q8 is signed semitones in Q8: -512 .. +512 means -2 .. +2 semitones.
+// bend_ratio_q16 is a piecewise-linear interpolation between the five semitone
+// anchors at -2,-1,0,+1,+2 (within 0.8 cent of 2^(n/12), see the table below).
+// phase_inc_out = base_phase_inc * ratio.
+module pressure_bend #(
+    parameter [11:0] ADC_CENTER = 12'd2048
+) (
+    input  wire               clk,
+    input  wire               rst,
+    input  wire               control_tick,
+    input  wire [11:0]        pressure_adc,
+    input  wire [11:0]        bend_adc,
+    input  wire               pressure_enable,
+    input  wire [31:0]        base_phase_inc,
+    output reg  [11:0]        pressure_filtered,
+    output wire [11:0]        pressure_level,
+    output reg  signed [15:0] bend_q8,
+    output wire [16:0]        bend_ratio_q16,
+    output wire [31:0]        phase_inc_out
+);
+
+    reg [11:0] pressure_d0;
+    reg [11:0] pressure_d1;
+
+    // Median is combinational from the two delayed samples and the current
+    // sample.  The explicit comparisons avoid relying on a simulator's sort.
+    wire [11:0] pressure_median =
+        ((pressure_d0 <= pressure_d1) && (pressure_d1 <= pressure_adc)) ? pressure_d1 :
+        ((pressure_adc <= pressure_d1) && (pressure_d1 <= pressure_d0)) ? pressure_d1 :
+        ((pressure_d1 <= pressure_d0) && (pressure_d0 <= pressure_adc)) ? pressure_d0 :
+        ((pressure_adc <= pressure_d0) && (pressure_d0 <= pressure_d1)) ? pressure_d0 :
+        pressure_adc;
+
+    wire signed [12:0] pressure_diff =
+        $signed({1'b0, pressure_median}) - $signed({1'b0, pressure_filtered});
+    wire signed [12:0] pressure_step = pressure_diff >>> 1;
+    wire signed [13:0] pressure_next_ext =
+        $signed({1'b0, pressure_filtered}) + pressure_step;
+
+    // Half range denominators.  Deriving them from ADC_CENTER keeps the
+    // +/-2 semitone endpoints correct if the midpoint is ever changed, and the
+    // guards keep an out-of-range parameter from dividing by zero.  Both are
+    // elaboration time constants: 2048 is a shift and only the 2047 side
+    // below needs a real divider.
+    localparam [11:0] ADC_FULL = 12'hFFF;
+    localparam integer BEND_POS_DEN = (ADC_FULL > ADC_CENTER) ? (ADC_FULL - ADC_CENTER) : 1;
+    localparam integer BEND_NEG_DEN = (ADC_CENTER > 0) ? ADC_CENTER : 1;
+
+    // Use 32-bit operands so the multiply does not accidentally truncate in
+    // Verilog's self-determined expression width rules.
+    wire [31:0] bend_pos_num =
+        ({20'd0, bend_adc} - {20'd0, ADC_CENTER}) * 32'd512;
+    wire [31:0] bend_neg_num =
+        ({20'd0, ADC_CENTER} - {20'd0, bend_adc}) * 32'd512;
+    wire [31:0] bend_pos_q8 = bend_pos_num / BEND_POS_DEN;
+    wire [31:0] bend_neg_q8 = bend_neg_num / BEND_NEG_DEN;
+    wire signed [15:0] bend_mapped =
+        (bend_adc >= ADC_CENTER) ? $signed(bend_pos_q8[15:0]) :
+                                     -$signed(bend_neg_q8[15:0]);
+
+    always @(posedge clk) begin
+        if (rst) begin
+            pressure_d0      <= 12'd0;
+            pressure_d1      <= 12'd0;
+            pressure_filtered <= 12'd0;
+            bend_q8          <= 16'sd0;
+        end else if (control_tick) begin
+            pressure_d1 <= pressure_d0;
+            pressure_d0 <= pressure_adc;
+
+            // Inputs and state are non-negative.  Clamp explicitly so a
+            // future parameter change cannot create a signed wraparound.
+            if (pressure_next_ext < 0)
+                pressure_filtered <= 12'd0;
+            else if (pressure_next_ext > 14'sd4095)
+                pressure_filtered <= 12'd4095;
+            else
+                pressure_filtered <= pressure_next_ext[11:0];
+
+            bend_q8 <= bend_mapped;
+        end
+    end
+
+    assign pressure_level = pressure_enable ? pressure_filtered : 12'd0;
+
+    // Semitone ratios in Q16 for -2,-1,0,+1,+2 semitones.  -1 and 0 equal the
+    // rounded 2^(n/12) values; -2 is +0.42 cent and +1/+2 are -0.77/-0.75 cent
+    // away from 2^(n/12), so the whole bend range stays within 0.8 cent.  The
+    // deviation is reported per anchor by tools/pressure_bend_ref.py; use
+    // 58386/61858/65536/69433/73562 instead if the anchors must equal the
+    // rounded semitone ratios exactly.
+    function [16:0] ratio_at;
+        input [2:0] idx;
+        begin
+            case (idx)
+                3'd0: ratio_at = 17'd58400;
+                3'd1: ratio_at = 17'd61858;
+                3'd2: ratio_at = 17'd65536;
+                3'd3: ratio_at = 17'd69402;
+                default: ratio_at = 17'd73530;
+            endcase
+        end
+    endfunction
+
+    reg [10:0] bend_u;
+    reg [2:0]  ratio_seg;
+    reg [7:0]  ratio_frac;
+    reg [16:0] ratio_a;
+    reg [16:0] ratio_b;
+    reg [31:0] ratio_delta_frac;
+    reg [16:0] ratio_interp;
+
+    always @* begin
+        // bend_q8 is bounded to [-512,+512], therefore bend_u is 0..1024.
+        bend_u = $signed(bend_q8) + 11'd512;
+        if (bend_u >= 11'd1024) begin
+            ratio_seg  = 3'd4;
+            ratio_frac = 8'd0;
+        end else begin
+            ratio_seg  = bend_u[10:8];
+            ratio_frac = bend_u[7:0];
+        end
+        ratio_a = ratio_at(ratio_seg);
+        ratio_b = ratio_at(ratio_seg + 3'd1);
+        ratio_delta_frac = (ratio_b - ratio_a) * ratio_frac;
+        ratio_interp = ratio_a + (ratio_delta_frac >> 8);
+    end
+
+    assign bend_ratio_q16 = ratio_interp;
+
+    // 32x17 -> 49 bit product.  Both operands are widened explicitly: letting
+    // the assignment context extend a multiply is tool dependent, and a tool
+    // that keeps the self determined 32 bit result would drop the high half of
+    // the product (1_000_000 * 65536 would come back as 16960 instead of
+    // 1_000_000).  The Q16 truncation below matches the reference.
+    wire [48:0] phase_product = {17'd0, base_phase_inc} * {32'd0, bend_ratio_q16};
+    assign phase_inc_out = phase_product >> 16;
+
+endmodule
diff --git a/archive/FPGA-20261015-v0.9/source/sim/run_simulation.ps1 b/archive/FPGA-20261015-v0.9/source/sim/run_simulation.ps1
new file mode 100644
index 0000000..651442b
--- /dev/null
+++ b/archive/FPGA-20261015-v0.9/source/sim/run_simulation.ps1
@@ -0,0 +1,138 @@
+<#
+    RTL 仿真门禁。
+
+    编译并运行全部测试台，任何一个失败都以退出码 1 结束。烧录脚本在调用
+    programmer_cli 之前必须先跑这个脚本，仿真不过就拒绝烧录。
+
+    测试台各管一段：
+      tb_tick_rate    量 PT8211 的采样节拍周期，只有 576 个 27 MHz 时钟才算对
+      tb_song_timing  量一遍曲子实际占多少采样节拍、发了多少个音符事件
+      tb_poly         量顶层连线：复位、默认速度档位、两个按键
+      tb_adsr         覆盖各阶段松键、释放归零与快速重按
+      tb_voice_retrigger  覆盖同音重按、满声部窃取与释放声部复用
+      tb_voice_order  覆盖长时间演奏后的最老声部判断
+      tb_event_fifo   覆盖空满保护、满队列同拍读写和顺序
+      tb_song_backpressure 覆盖播放器保持未被接收的事件
+      tb_mode_uart   覆盖串口到顶层模式/事件路径；强制加速采样，非真实音频捕获
+      tb_mcp3208_spi 覆盖 MCP3208 完整 19 拍 DS21298E 事务、边界码、双通道、固定种子随机值和帧内复位恢复
+      tb_mcp3208_i2s_coexist 覆盖 ADC 事务与 PT8211 音频节拍并行、tick 仍为 576 拍
+      tb_mcp3208_params 覆盖 27 MHz/250 kHz 生产参数、分频钳位和 SPI_HZ=0 的守护
+      tb_pressure_bend 与 Python 参考逐值对照（640 个压力 tick、4096 个弯音 ADC 码）并覆盖 t90、弯音边界和持音不重启
+      tb_s6_audio    覆盖双同步 ROM、相位插值/环绕、交叉混音、FIR 和削波计数
+#>
+param(
+    [string]$Iverilog = '',
+    [string]$Vvp = ''
+)
+
+$ErrorActionPreference = 'Stop'
+$sourceRoot = (Resolve-Path -LiteralPath (Join-Path $PSScriptRoot '..')).Path
+
+function Find-Tool {
+    param([string]$Name, [string]$FromEnv, [string[]]$Candidates)
+    if ($FromEnv) { return $FromEnv }
+    foreach ($c in $Candidates) {
+        if (Test-Path -LiteralPath $c -PathType Leaf) { return $c }
+    }
+    $found = Get-Command $Name -ErrorAction SilentlyContinue
+    if ($found) { return $found.Source }
+    return ''
+}
+
+$iverilogCandidates = @('C:\iverilog\bin\iverilog.exe')
+$vvpCandidates = @('C:\iverilog\bin\vvp.exe')
+foreach ($pf in @($env:ProgramFiles, ${env:ProgramFiles(x86)})) {
+    if ($pf) {
+        $iverilogCandidates += (Join-Path $pf 'iverilog\bin\iverilog.exe')
+        $vvpCandidates += (Join-Path $pf 'iverilog\bin\vvp.exe')
+    }
+}
+
+if (-not $Iverilog) { $Iverilog = Find-Tool -Name 'iverilog' -FromEnv $env:IVERILOG -Candidates $iverilogCandidates }
+if (-not $Vvp)      { $Vvp      = Find-Tool -Name 'vvp'      -FromEnv $env:VVP      -Candidates $vvpCandidates }
+
+if (-not $Iverilog -or -not (Test-Path -LiteralPath $Iverilog -PathType Leaf)) {
+    Write-Error "找不到 iverilog。安装 Icarus Verilog，或用 -Iverilog 指定路径。仿真门禁无法跳过。"
+    exit 1
+}
+if (-not $Vvp -or -not (Test-Path -LiteralPath $Vvp -PathType Leaf)) {
+    Write-Error "找不到 vvp。安装 Icarus Verilog，或用 -Vvp 指定路径。仿真门禁无法跳过。"
+    exit 1
+}
+
+Push-Location $sourceRoot
+try {
+    $suite = @(
+        @{ Name = 'tb_tick_rate';   Top = 'sim\tb_tick_rate.v';   Src = @('rtl\audio\pt8211_tx.v') },
+        @{ Name = 'tb_song_timing'; Top = 'sim\tb_song_timing.v'; Src = @('rtl\audio\song_player.v') },
+        @{ Name = 'tb_adsr';        Top = 'sim\tb_adsr.v';        Src = @('rtl\audio\adsr.v') },
+        @{ Name = 'tb_voice_retrigger'; Top = 'sim\tb_voice_retrigger.v'; Src = @(
+                'rtl\audio\voice_alloc.v', 'rtl\audio\poly_voice.v',
+                'rtl\audio\adsr.v', 'rtl\audio\dds_osc.v', 'rtl\audio\note_phase_inc.v') },
+        @{ Name = 'tb_voice_order'; Top = 'sim\tb_voice_order.v'; Src = @('rtl\audio\voice_alloc.v') },
+        @{ Name = 'tb_event_fifo'; Top = 'sim\tb_event_fifo.v'; Src = @('rtl\audio\event_fifo.v') },
+        @{ Name = 'tb_song_backpressure'; Top = 'sim\tb_song_backpressure.v'; Src = @('rtl\audio\song_player.v') },
+        @{ Name = 'tb_mode_uart'; Top = 'sim\tb_mode_uart.v'; Src = @(
+                'rtl\top.v',
+                'rtl\audio\dds_osc.v', 'rtl\audio\adsr.v', 'rtl\audio\poly_voice.v',
+                'rtl\audio\note_phase_inc.v', 'rtl\audio\event_fifo.v',
+                'rtl\audio\voice_alloc.v', 'rtl\audio\song_player.v',
+                'rtl\audio\mixer.v', 'rtl\audio\pt8211_tx.v', 'rtl\audio\uart_ctrl.v') },
+        @{ Name = 'tb_poly';        Top = 'sim\tb_poly.v';        Src = @(
+                'rtl\top.v',
+                'rtl\audio\dds_osc.v', 'rtl\audio\adsr.v', 'rtl\audio\poly_voice.v',
+                'rtl\audio\note_phase_inc.v', 'rtl\audio\event_fifo.v',
+                'rtl\audio\voice_alloc.v', 'rtl\audio\song_player.v',
+                'rtl\audio\mixer.v', 'rtl\audio\pt8211_tx.v', 'rtl\audio\uart_ctrl.v') },
+        @{ Name = 'tb_mcp3208_spi'; Top = 'sim\tb_mcp3208_spi.v'; Src = @(
+                'rtl\audio\mcp3208_spi.v', 'sim\mcp3208_model.v') },
+        @{ Name = 'tb_mcp3208_i2s_coexist'; Top = 'sim\tb_mcp3208_i2s_coexist.v'; Src = @(
+                'rtl\audio\mcp3208_spi.v', 'rtl\audio\pt8211_tx.v',
+                'sim\mcp3208_model.v') },
+        @{ Name = 'tb_mcp3208_params'; Top = 'sim\tb_mcp3208_params.v'; Src = @(
+                'rtl\audio\mcp3208_spi.v', 'sim\mcp3208_model.v') },
+        @{ Name = 'tb_pressure_bend'; Top = 'sim\tb_pressure_bend.v'; Src = @(
+                'rtl\audio\pressure_bend.v', 'rtl\audio\adsr.v') },
+        @{ Name = 'tb_s6_audio'; Top = 'sim\tb_s6_audio.v'; Src = @(
+                'rtl\audio\wavetable_rom_dual.v', 'rtl\audio\wavetable_osc_dual_s6.v',
+                'rtl\audio\mixer_s6.v') }
+    )
+
+    $failed = 0
+    foreach ($test in $suite) {
+        $out = Join-Path $sourceRoot ("sim\{0}.vvp" -f $test.Name)
+        Write-Output ("=== {0} ===" -f $test.Name)
+
+        $compileArgs = @('-g2012', '-I', '.', '-o', $out, $test.Top) + $test.Src
+        & $Iverilog @compileArgs
+        if ($LASTEXITCODE -ne 0) {
+            Write-Output ("编译失败：{0}" -f $test.Name)
+            $failed++
+            Remove-Item -LiteralPath $out -Force -ErrorAction SilentlyContinue
+            continue
+        }
+
+        try {
+            & $Vvp $out
+            if ($LASTEXITCODE -ne 0) {
+                Write-Output ("仿真失败：{0}" -f $test.Name)
+                $failed++
+            }
+        }
+        finally {
+            # .vvp files are reproducible build temporaries; keep the source
+            # tree clean after both PASS and failure.
+            Remove-Item -LiteralPath $out -Force -ErrorAction SilentlyContinue
+        }
+    }
+
+    if ($failed -ne 0) {
+        Write-Output ("仿真门禁未通过，{0} 个测试台失败，禁止烧录。" -f $failed)
+        exit 1
+    }
+    Write-Output "全部测试台通过，允许烧录。"
+    exit 0
+}
+finally {
+    Pop-Location
+}
diff --git a/archive/FPGA-20261015-v0.9/source/sim/tb_pressure_bend.v b/archive/FPGA-20261015-v0.9/source/sim/tb_pressure_bend.v
new file mode 100644
index 0000000..1b2f273
--- /dev/null
+++ b/archive/FPGA-20261015-v0.9/source/sim/tb_pressure_bend.v
@@ -0,0 +1,244 @@
+`timescale 1ns/1ps
+// S5 pressure/bend self-check, independent review revision (2026-10-15).
+//
+// The DUT is driven by vectors generated from tools/pressure_bend_ref.py, so
+// every control tick of a step/ramp/spike/pseudo-random pressure sequence and
+// every one of the 4096 bend ADC codes is compared value by value instead of
+// against a handful of hand written expectations.  The qualitative checks of
+// the delivered test (median plus IIR step, 90 percent response, single sample
+// spike rejection, bend edges, pressure-off bypass, held note bend without an
+// ADSR retrigger) are kept, and pressure-off playability was added.
+//
+// Regenerate the vectors with:
+//   python source/tools/pressure_bend_ref.py --vectors source/sim/vectors
+module tb_pressure_bend;
+    localparam integer PRESSURE_VECTORS = 640;
+    localparam integer BEND_VECTORS     = 4096;
+    localparam [11:0]  MID              = 12'd2048;
+    localparam [31:0]  BASE_PHASE       = 32'd1000000;
+    localparam [11:0]  T90_TARGET       = 12'd3686;   // 90 percent of 4095
+
+    reg clk = 1'b0;
+    always #5 clk = ~clk;
+    reg rst = 1'b1;
+    reg control_tick = 1'b0;
+    reg sample_tick = 1'b0;
+    reg [11:0] pressure_adc = 12'd0;
+    reg [11:0] bend_adc = MID;
+    reg pressure_enable = 1'b1;
+    reg [31:0] base_phase_inc = BASE_PHASE;
+
+    wire [11:0] pressure_filtered;
+    wire [11:0] pressure_level;
+    wire signed [15:0] bend_q8;
+    wire [16:0] bend_ratio_q16;
+    wire [31:0] phase_inc_out;
+
+    reg gate = 1'b0;
+    reg retrigger = 1'b0;
+    wire [15:0] env;
+    wire env_idle;
+
+    pressure_bend dut (
+        .clk(clk), .rst(rst), .control_tick(control_tick),
+        .pressure_adc(pressure_adc), .bend_adc(bend_adc),
+        .pressure_enable(pressure_enable), .base_phase_inc(base_phase_inc),
+        .pressure_filtered(pressure_filtered), .pressure_level(pressure_level),
+        .bend_q8(bend_q8), .bend_ratio_q16(bend_ratio_q16),
+        .phase_inc_out(phase_inc_out)
+    );
+
+    adsr env_dut (
+        .clk(clk), .rst(rst), .sample_tick(sample_tick),
+        .gate(gate), .retrigger(retrigger), .env(env), .idle(env_idle)
+    );
+
+    // Vectors written by tools/pressure_bend_ref.py --vectors sim/vectors
+    reg [11:0] p_in  [0:PRESSURE_VECTORS-1];
+    reg [11:0] p_exp [0:PRESSURE_VECTORS-1];
+    reg [15:0] b_q8  [0:BEND_VECTORS-1];
+    reg [16:0] b_rat [0:BEND_VECTORS-1];
+    reg [31:0] b_ph  [0:BEND_VECTORS-1];
+
+    integer failures;
+    integer i, k;
+    integer t90_ticks;
+    reg [31:0] phase_ref;
+    reg [15:0] env_before;
+
+    task control_step;
+        input [11:0] next_pressure;
+        input [11:0] next_bend;
+        begin
+            @(negedge clk);
+            pressure_adc = next_pressure;
+            bend_adc = next_bend;
+            control_tick = 1'b1;
+            @(posedge clk);
+            #1 control_tick = 1'b0;
+        end
+    endtask
+
+    task audio_step;
+        begin
+            @(negedge clk);
+            sample_tick = 1'b1;
+            @(posedge clk);
+            #1 sample_tick = 1'b0;
+        end
+    endtask
+
+    initial begin
+        $readmemh("sim/vectors/pressure_inputs.hex", p_in);
+        $readmemh("sim/vectors/pressure_expected.hex", p_exp);
+        $readmemh("sim/vectors/bend_q8_expected.hex", b_q8);
+        $readmemh("sim/vectors/bend_ratio_expected.hex", b_rat);
+        $readmemh("sim/vectors/bend_phase_expected.hex", b_ph);
+    end
+
+    initial begin
+        failures = 0;
+        t90_ticks = 0;
+
+        repeat (2) @(negedge clk);
+        rst = 1'b0;
+
+        // ---- 1) pressure filter, value by value -------------------------
+        // The vector sequence is 8 zero ticks, a full scale step, a full
+        // scale step down, a 128 tick ramp, a settled mid value, isolated
+        // spikes and a fixed seed pseudo random tail.
+        for (i = 0; i < PRESSURE_VECTORS; i = i + 1) begin
+            control_step(p_in[i], MID);
+            if (pressure_filtered !== p_exp[i]) begin
+                $display("FAIL pressure tick %0d: adc=%0d dut=%0d ref=%0d",
+                         i, p_in[i], pressure_filtered, p_exp[i]);
+                failures = failures + 1;
+            end
+            if (pressure_level !== pressure_filtered) begin
+                $display("FAIL pressure level tick %0d: level=%0d filtered=%0d",
+                         i, pressure_level, pressure_filtered);
+                failures = failures + 1;
+            end
+            if (phase_inc_out !== BASE_PHASE) begin
+                $display("FAIL pressure tick %0d changed pitch: phase=%0d", i, phase_inc_out);
+                failures = failures + 1;
+            end
+            // 90 percent step metric, counted from the first high input tick
+            if ((t90_ticks == 0) && (p_in[i] == 12'd4095) && (pressure_filtered >= T90_TARGET))
+                t90_ticks = i - 8 + 1;
+        end
+        if (t90_ticks !== 5) begin
+            $display("FAIL 90 percent step response: %0d control ticks", t90_ticks);
+            failures = failures + 1;
+        end
+
+        // ---- 2) bend map and Q16 ratio, every ADC code -------------------
+        for (i = 0; i < BEND_VECTORS; i = i + 1) begin
+            control_step(12'd1000, i[11:0]);
+            if (bend_q8 !== $signed(b_q8[i])) begin
+                $display("FAIL bend q8 at adc=%0d: dut=%0d ref=%0d", i, bend_q8, $signed(b_q8[i]));
+                failures = failures + 1;
+            end
+            if (bend_ratio_q16 !== b_rat[i]) begin
+                $display("FAIL bend ratio at adc=%0d: dut=%0d ref=%0d", i, bend_ratio_q16, b_rat[i]);
+                failures = failures + 1;
+            end
+            if (phase_inc_out !== b_ph[i]) begin
+                $display("FAIL bend phase at adc=%0d: dut=%0d ref=%0d", i, phase_inc_out, b_ph[i]);
+                failures = failures + 1;
+            end
+        end
+        // Bend edges and centre, as required by the task list.
+        control_step(12'd1000, 12'd0);
+        if (bend_q8 !== -16'sd512) begin
+            $display("FAIL bend low edge: q8=%0d", bend_q8);
+            failures = failures + 1;
+        end
+        control_step(12'd1000, MID);
+        if (bend_q8 !== 16'sd0 || phase_inc_out !== BASE_PHASE) begin
+            $display("FAIL bend centre: q8=%0d phase=%0d", bend_q8, phase_inc_out);
+            failures = failures + 1;
+        end
+        control_step(12'd1000, 12'd4095);
+        if (bend_q8 !== 16'sd512) begin
+            $display("FAIL bend high edge: q8=%0d", bend_q8);
+            failures = failures + 1;
+        end
+
+        // A different base increment must scale the same ratio without
+        // truncation surprises.
+        for (k = 0; k < 3; k = k + 1) begin
+            case (k)
+                0: base_phase_inc = 32'd500000;
+                1: base_phase_inc = 32'd2000000;
+                default: base_phase_inc = 32'd4000000;
+            endcase
+            for (i = 0; i < BEND_VECTORS; i = i + 4095) begin
+                control_step(MID, i[11:0]);
+                phase_ref = ({32'd0, base_phase_inc} * {47'd0, b_rat[i]}) >> 16;
+                if (phase_inc_out !== phase_ref) begin
+                    $display("FAIL base=%0d adc=%0d: phase=%0d expected=%0d",
+                             base_phase_inc, i, phase_inc_out, phase_ref);
+                    failures = failures + 1;
+                end
+            end
+        end
+        base_phase_inc = BASE_PHASE;
+
+        // ---- 3) pressure is expression only, and off is still playable ----
+        control_step(MID, MID);
+        phase_ref = phase_inc_out;
+        for (i = 0; i < 4096; i = i + 7) begin
+            control_step(i[11:0], MID);
+            if (phase_inc_out !== phase_ref) begin
+                $display("FAIL pressure sweep changed pitch at adc=%0d: %0d", i, phase_inc_out);
+                failures = failures + 1;
+            end
+        end
+        pressure_enable = 1'b0;
+        control_step(12'd4095, MID);
+        if (pressure_level !== 12'd0 || phase_inc_out !== phase_ref) begin
+            $display("FAIL pressure disable: level=%0d phase=%0d", pressure_level, phase_inc_out);
+            failures = failures + 1;
+        end
+        // With pressure disabled a held note must still run.
+        gate = 1'b1;
+        retrigger = 1'b1;
+        audio_step();
+        retrigger = 1'b0;
+        env_before = env;
+        audio_step();
+        audio_step();
+        if (env_idle || (env <= env_before)) begin
+            $display("FAIL pressure disabled stopped the note: env=%0d idle=%b", env, env_idle);
+            failures = failures + 1;
+        end
+        gate = 1'b0;
+        pressure_enable = 1'b1;
+
+        // ---- 4) bend during a held note must not retrigger the ADSR ------
+        gate = 1'b1;
+        retrigger = 1'b1;
+        audio_step();
+        retrigger = 1'b0;
+        audio_step();
+        env_before = env;
+        control_step(12'd1000, 12'd0);
+        audio_step();
+        if (env <= env_before || env_idle) begin
+            $display("FAIL bend restarted or stopped the held ADSR: before=%0d after=%0d",
+                     env_before, env);
+            failures = failures + 1;
+        end
+
+        if (failures != 0) $fatal(1, "tb_pressure_bend failures=%0d", failures);
+        $display("PASS tb_pressure_bend: %0d pressure ticks and %0d ADC codes match the reference, t90=%0d control ticks",
+                 PRESSURE_VECTORS, BEND_VECTORS, t90_ticks);
+        $finish;
+    end
+
+    initial begin
+        #10_000_000;
+        $fatal(1, "FAIL tb_pressure_bend: timeout");
+    end
+endmodule
