+// 演示音符事件 FIFO，默认 16 项，事件为 {on, note[6:0], velocity[7:0]}。
+// 写入/读指针在 clk 上升沿更新，rd_data 是当前读指针的组合输出。
+// 只有 wr_en && wr_ready 才表示本拍接受写入；读出条件为 rd_en && !empty。
+// top 中仅 song_player 写入此队列，UART 事件另行仲裁，不经过这里。
+// 默认容量很小；资源以综合报告为准，本模块不实例化 BSRAM 原语。
+module event_fifo #(
+    parameter integer DEPTH = 16,
+    parameter integer WIDTH = 16
+)(
+    input  wire             clk,
+    input  wire             rst,
+    input  wire             wr_en,
+    input  wire [WIDTH-1:0] wr_data,
+    input  wire             rd_en,
+    output wire [WIDTH-1:0] rd_data,
+    output wire             empty,
+    output wire             full,
+    output wire             wr_ready
+);
+
+    localparam integer AW = 4;      // 本版固定地址宽度；DEPTH 参数只能按 16 项使用
+
+    reg [WIDTH-1:0] mem [0:DEPTH-1];
+    reg [AW:0]      wr_ptr;
+    reg [AW:0]      rd_ptr;
+
+    assign empty   = (wr_ptr == rd_ptr);
+    assign full    = (wr_ptr[AW] != rd_ptr[AW]) && (wr_ptr[AW-1:0] == rd_ptr[AW-1:0]);
+    // 满队列若本拍也读出旧队首，仍可接受新事件；两指针一起前进、占用数不变。
+    // 非阻塞写入在采样沿后生效，消费端在该沿取得的仍是原队首。
+    assign wr_ready = !full || (rd_en && !empty);
+    assign rd_data = mem[rd_ptr[AW-1:0]];
+
+    always @(posedge clk) begin
+        if (rst) begin
+            // 复位只清指针；旧 mem 内容不再有效，消费者必须遵守 empty。
+            wr_ptr <= {AW+1{1'b0}};
+            rd_ptr <= {AW+1{1'b0}};
+        end else begin
+            if (wr_en && wr_ready) begin
+                mem[wr_ptr[AW-1:0]] <= wr_data;
+                wr_ptr <= wr_ptr + 1'b1;
+            end
+            if (rd_en && !empty)
+                rd_ptr <= rd_ptr + 1'b1;
+        end
+    end
+
+endmodule
diff --git a/output/handoff_milestone2_20261008/source/rtl/audio/mcp3208_spi.v b/output/handoff_milestone2_20261008/source/rtl/audio/mcp3208_spi.v
new file mode 100644
index 0000000..175d71c
--- /dev/null
+++ b/output/handoff_milestone2_20261008/source/rtl/audio/mcp3208_spi.v
@@ -0,0 +1,137 @@
+// MCP3208 SPI mode-0 master, Microchip DS21298E frame.
+//
+// One start request transfers the complete 19-clock MCP3208 conversion frame:
+//   clock 1..5   DIN  START, SGL/DIFF=1, D2..D0   (channel latched at start)
+//   clock 6      DIN  "don't care"; the device ends its sample/hold period on
+//                    this falling edge and starts driving the null bit
+//   clock 7      DOUT null bit, ignored by this master
+//   clock 8..19  DOUT B11..B0, MSB first, latched here on the rising edges
+// The device drives DOUT on falling edges and the master latches on rising
+// edges, so the first data bit is the 8th rising edge after CS falls and the
+// last one is the 19th.  Reading only 18 clocks (as an earlier revision did)
+// returns every code shifted right by one bit with B0 lost.
+//
+// The engine runs from clk and owns an independent SPI clock; it never waits
+// for sample_tick or stretches the audio/I2S path.  `done`/`data_valid` are
+// one-clock pulses raised together with CS returning high, and `data` is
+// loaded at that same edge, so the held code only changes after the complete
+// frame.  `adc_data` is an alias of the same hold register.
+module mcp3208_spi #(
+    parameter integer CLK_HZ = 27_000_000,
+    parameter integer SPI_HZ = 250_000
+) (
+    input  wire        clk,
+    input  wire        rst,
+    input  wire        start,
+    input  wire [2:0]  channel,
+    input  wire        miso,
+    output reg         cs_n,
+    output reg         sclk,
+    output reg         mosi,
+    output reg         busy,
+    output reg         done,
+    output reg  [11:0] data,
+    output wire        data_valid,
+    output wire [11:0] adc_data
+);
+
+    // Round to the nearest integer and keep a legal minimum of one clk.
+    // SPI_HZ below 1 Hz would divide by zero during elaboration; the guard
+    // turns such a parameter set into the slowest legal divider instead.
+    localparam integer SPI_HZ_GUARD = (SPI_HZ < 1) ? 1 : SPI_HZ;
+    localparam integer HALF_DIV_CALC = (CLK_HZ + SPI_HZ_GUARD) /
+                                       (SPI_HZ_GUARD * 2);
+    localparam integer HALF_DIV = (HALF_DIV_CALC < 1) ? 1 : HALF_DIV_CALC;
+
+    localparam integer LAST_BIT = 18;       // 19 clocks, index 0..18
+    localparam integer FIRST_DATA_BIT = 7;  // clock 8 carries B11
+
+    reg [31:0] div_count;
+    reg [4:0]  bit_index;       // 0..18, current bit on the wire
+    reg [11:0] rx_shift;
+    reg [4:0]  tx_command;
+    reg        last_rise;
+
+    wire spi_half_tick = (div_count == HALF_DIV - 1);
+
+    assign data_valid = done;
+    assign adc_data   = data;
+
+    // Command bit order is MSB first.  Clocks 6..19 are the null/data portion
+    // and MOSI is held low there, which the device treats as "don't care".
+    function command_bit;
+        input [4:0] index;
+        begin
+            case (index)
+                5'd0: command_bit = 1'b1;              // START
+                5'd1: command_bit = 1'b1;              // single-ended
+                5'd2: command_bit = tx_command[2];
+                5'd3: command_bit = tx_command[1];
+                5'd4: command_bit = tx_command[0];
+                default: command_bit = 1'b0;
+            endcase
+        end
+    endfunction
+
+    always @(posedge clk) begin
+        if (rst) begin
+            cs_n       <= 1'b1;
+            sclk       <= 1'b0;
+            mosi       <= 1'b0;
+            busy       <= 1'b0;
+            done       <= 1'b0;
+            data       <= 12'd0;
+            div_count  <= 32'd0;
+            bit_index  <= 5'd0;
+            rx_shift   <= 12'd0;
+            tx_command <= 5'd0;
+            last_rise  <= 1'b0;
+        end else begin
+            done <= 1'b0;
+
+            if (!busy) begin
+                cs_n      <= 1'b1;
+                sclk      <= 1'b0;
+                mosi      <= 1'b0;
+                div_count <= 32'd0;
+                if (start) begin
+                    busy       <= 1'b1;
+                    cs_n       <= 1'b0;
+                    bit_index  <= 5'd0;
+                    rx_shift   <= 12'd0;
+                    tx_command <= channel;
+                    // Present START before the first rising edge.
+                    mosi       <= 1'b1;
+                end
+            end else if (spi_half_tick) begin
+                div_count <= 32'd0;
+
+                if (!sclk) begin
+                    // Rising edge: the device has driven its bit on the
+                    // previous falling edge, so latch MISO here.
+                    sclk <= 1'b1;
+                    if ((bit_index >= FIRST_DATA_BIT) && (bit_index <= LAST_BIT)) begin
+                        rx_shift <= {rx_shift[10:0], miso};
+                    end
+                    last_rise <= (bit_index == LAST_BIT);
+                end else begin
+                    // Falling edge: finish the frame or prepare the next bit.
+                    sclk <= 1'b0;
+                    if (last_rise) begin
+                        cs_n      <= 1'b1;
+                        busy      <= 1'b0;
+                        done      <= 1'b1;
+                        data      <= rx_shift;   // commit only after clock 19
+                        mosi      <= 1'b0;
+                        last_rise <= 1'b0;
+                    end else begin
+                        bit_index <= bit_index + 1'b1;
+                        mosi      <= command_bit(bit_index + 1'b1);
+                    end
+                end
+            end else begin
+                div_count <= div_count + 1'b1;
+            end
+        end
+    end
+endmodule
\ No newline at end of file
diff --git a/output/handoff_milestone2_20261008/source/rtl/audio/mixer.v b/output/handoff_milestone2_20261008/source/rtl/audio/mixer.v
new file mode 100644
index 0000000..6ac52d2
--- /dev/null
+++ b/output/handoff_milestone2_20261008/source/rtl/audio/mixer.v
@@ -0,0 +1,63 @@
+// 四声部混音：18 位有符号求和 -> 主音量右移 -> 饱和到 16 位 -> 五抽头 FIR。
+// FIR 系数为 (1,4,6,4,1)/16，历史样本和输出仅在单周期 sample_tick 更新。
+// 该平滑滤波改变频响，不能消除模拟链路的静音底噪，也不替代波表抗混叠。
+module mixer #(
+    parameter [3:0] VOLUME_SHIFT = 4'd1      // divide by 2, about -6 dB
+)(
+    input  wire               clk,
+    input  wire               rst,
+    input  wire               sample_tick,
+    input  wire signed [15:0] v0,
+    input  wire signed [15:0] v1,
+    input  wire signed [15:0] v2,
+    input  wire signed [15:0] v3,
+    output reg  signed [15:0] sample_out
+);
+
+    wire signed [17:0] sum = v0 + v1 + v2 + v3;
+
+    // 四个 signed 16 位输入需 18 位和；先降增益再饱和，可减少和弦削波。
+    // 默认右移 1 位（除 2）仍不能保证四个同相满幅声部不削波；完全覆盖这种
+    // 极端输入需至少除 4。当前保留默认音量，饱和器负责防止溢出翻转。
+    // 现有舍入表达式按 VOLUME_SHIFT>=1 编写，不应直接把该参数设为 0。
+    wire signed [19:0] sum_ext = {{2{sum[17]}}, sum};
+    wire signed [19:0] scaled  =
+        (sum_ext + (20'sd1 <<< (VOLUME_SHIFT - 1))) >>> VOLUME_SHIFT;
+
+    // 超界钳制为 +32767/-32768，避免截低位导致符号翻转。
+    wire signed [15:0] sat =
+        (scaled > 20'sd32767)  ? 16'sd32767 :
+        (scaled < -20'sd32768) ? -16'sd32768 :
+        scaled[15:0];
+
+    reg signed [15:0] d1, d2, d3, d4;
+
+    always @(posedge clk) begin
+        if (rst) begin
+            d1 <= 16'sd0;
+            d2 <= 16'sd0;
+            d3 <= 16'sd0;
+            d4 <= 16'sd0;
+        end else if (sample_tick) begin
+            d1 <= sat;
+            d2 <= d1;
+            d3 <= d2;
+            d4 <= d3;
+        end
+    end
+
+    // 权重和为 16，20 位 signed 中间结果覆盖 16 位饱和样本的累加范围。
+    // 非阻塞更新使用旧 d1..d4，smooth 是本采样点加前四点的加权平均。
+    wire signed [19:0] fir_sum =
+        sat + d4 + ((d1 + d3) <<< 2) + ((d2 <<< 2) + (d2 <<< 1));
+
+    wire signed [19:0] smooth = fir_sum >>> 4;
+
+    always @(posedge clk) begin
+        if (rst)
+            sample_out <= 16'sd0;
+        else if (sample_tick)
+            sample_out <= smooth[15:0];
+    end
+
+endmodule
diff --git a/output/handoff_milestone2_20261008/source/rtl/audio/mixer_s6.v b/output/handoff_milestone2_20261008/source/rtl/audio/mixer_s6.v
new file mode 100644
index 0000000..e3d24e2
--- /dev/null
+++ b/output/handoff_milestone2_20261008/source/rtl/audio/mixer_s6.v
@@ -0,0 +1,93 @@
+// S6 four-voice mixer with explicit saturation and clip accounting.
+//
+// The clip counter is defined at the master-gain boundary: one count is added
+// for each sample_tick whose four-voice sum, after VOLUME_SHIFT, lies outside
+// the signed 16-bit output range.  A sample is counted once even if the FIR is
+// enabled.  The counter saturates at all ones and is cleared synchronously by
+// clear_clip.  FIR_ENABLE selects the five-tap (1,4,6,4,1)/16 smoother; both
+// paths update sample_out only on sample_tick, giving an explicit sample-frame
+// register boundary for downstream I2S.
+module mixer_s6 #(
+    parameter integer VOLUME_SHIFT = 1,
+    parameter integer FIR_ENABLE = 1,
+    parameter integer CLIP_COUNTER_WIDTH = 32
+) (
+    input  wire                                  clk,
+    input  wire                                  rst,
+    input  wire                                  sample_tick,
+    input  wire                                  clear_clip,
+    input  wire signed [15:0]                    v0,
+    input  wire signed [15:0]                    v1,
+    input  wire signed [15:0]                    v2,
+    input  wire signed [15:0]                    v3,
+    output reg  signed [15:0]                    sample_out,
+    output reg  [CLIP_COUNTER_WIDTH-1:0]         clip_count,
+    output reg                                  clip_event
+);
+
+    localparam signed [19:0] ROUND_BIAS =
+        (VOLUME_SHIFT == 0) ? 20'sd0 : (20'sd1 <<< (VOLUME_SHIFT - 1));
+
+    // Sign-extend before every addition.  Extending only the final net would
+    // allow a 16-bit intermediate addition to wrap before it is assigned.
+    wire signed [19:0] sum_ext =
+        {{4{v0[15]}}, v0} + {{4{v1[15]}}, v1} +
+        {{4{v2[15]}}, v2} + {{4{v3[15]}}, v3};
+    wire signed [19:0] scaled = (sum_ext + ROUND_BIAS) >>> VOLUME_SHIFT;
+    wire raw_clip = (scaled > 20'sd32767) || (scaled < -20'sd32768);
+    wire signed [15:0] sat_raw =
+        (scaled > 20'sd32767)  ? 16'sd32767 :
+        (scaled < -20'sd32768) ? -16'sd32768 : scaled[15:0];
+
+    reg signed [15:0] d1, d2, d3, d4;
+    wire signed [21:0] sat_ext = {{6{sat_raw[15]}}, sat_raw};
+    wire signed [21:0] d1_ext = {{6{d1[15]}}, d1};
+    wire signed [21:0] d2_ext = {{6{d2[15]}}, d2};
+    wire signed [21:0] d3_ext = {{6{d3[15]}}, d3};
+    wire signed [21:0] d4_ext = {{6{d4[15]}}, d4};
+    // Binomial (1,4,6,4,1)/16: the centre weight is 6, so the filter has
+    // unity DC gain and no overshoot.  Using 8 here (as an earlier revision
+    // did) gives 18/16 gain, a low-frequency boost and a 6 percent overshoot.
+    wire signed [21:0] fir_centre6 = (d2_ext <<< 2) + (d2_ext <<< 1);
+    wire signed [21:0] fir_sum = sat_ext + d4_ext +
+                                  ((d1_ext + d3_ext) <<< 2) +
+                                  fir_centre6;
+    wire signed [21:0] fir_value = fir_sum >>> 4;
+    wire fir_clip = (fir_value > 22'sd32767) || (fir_value < -22'sd32768);
+    wire signed [15:0] sat_fir =
+        (fir_value > 22'sd32767)  ? 16'sd32767 :
+        (fir_value < -22'sd32768) ? -16'sd32768 : fir_value[15:0];
+    wire signed [15:0] next_sample = FIR_ENABLE ? sat_fir : sat_raw;
+    // The declared statistic is taken at the master-gain boundary.  FIR
+    // saturation is observable in sample_out but does not double-count a
+    // frame (and can never hide an upstream raw clip).
+    wire count_clip = raw_clip;
+
+    always @(posedge clk) begin
+        if (rst) begin
+            d1         <= 16'sd0;
+            d2         <= 16'sd0;
+            d3         <= 16'sd0;
+            d4         <= 16'sd0;
+            sample_out <= 16'sd0;
+            clip_count <= {CLIP_COUNTER_WIDTH{1'b0}};
+            clip_event <= 1'b0;
+        end else begin
+            clip_event <= 1'b0;
+            if (clear_clip)
+                clip_count <= {CLIP_COUNTER_WIDTH{1'b0}};
+            if (sample_tick) begin
+                d1         <= sat_raw;
+                d2         <= d1;
+                d3         <= d2;
+                d4         <= d3;
+                sample_out <= next_sample;
+                clip_event <= count_clip;
+                if (count_clip && !clear_clip &&
+                    (clip_count != {CLIP_COUNTER_WIDTH{1'b1}}))
+                    clip_count <= clip_count + {{(CLIP_COUNTER_WIDTH-1){1'b0}}, 1'b1};
+            end
+        end
+    end
+
+endmodule
diff --git a/output/handoff_milestone2_20261008/source/rtl/audio/note_phase_inc.v b/output/handoff_milestone2_20261008/source/rtl/audio/note_phase_inc.v
new file mode 100644
index 0000000..16c75c0
--- /dev/null
+++ b/output/handoff_milestone2_20261008/source/rtl/audio/note_phase_inc.v
@@ -0,0 +1,36 @@
+// 7 位 MIDI 音高 -> 32 位 DDS 相位增量，组合逻辑，无额外寄存延迟。
+// 当前 PT8211 调试路径 Fs=46875 Hz（27 MHz / 18 / 32），
+// phase_inc = round(f * 2^32 / Fs)。未来标准 I2S 的 48 kHz 必须重生成这些常数。
+// 仅存 MIDI 0 起始的十二个半音常数，按八度左移即倍频；基础常数舍入误差
+// 也随左移放大。只有 12 项频率常数，因此 case 合理，不能类推为大型波表。
+// 现有常数由 tools/gen_song_rom.py 生成；改采样率时同时核对生成器设置。
+// 本模块不检查可播放音域/奈奎斯特界限；更换波形后需由上层限制高音或带限。
+module note_phase_inc (
+    input  wire [6:0]  note,
+    output reg  [31:0] inc
+);
+
+    reg  [31:0] base;
+    wire [6:0]  semi     = note % 7'd12;
+    wire [6:0]  oct_full = note / 7'd12;
+    wire [3:0]  oct      = oct_full[3:0];
+
+    always @(*) begin
+        case (semi)
+            7'd0:  base = 32'd749115;    // C
+            7'd1:  base = 32'd793660;    // C#
+            7'd2:  base = 32'd840854;    // D
+            7'd3:  base = 32'd890853;    // D#
+            7'd4:  base = 32'd943826;    // E
+            7'd5:  base = 32'd999949;    // F
+            7'd6:  base = 32'd1059409;   // F#
+            7'd7:  base = 32'd1122405;   // G
+            7'd8:  base = 32'd1189147;   // G#
+            7'd9:  base = 32'd1259857;   // A
+            7'd10: base = 32'd1334772;   // A#
+            default: base = 32'd1414142; // B
+        endcase
+        inc = base << oct;
+    end
+
+endmodule
diff --git a/output/handoff_milestone2_20261008/source/rtl/audio/poly_voice.v b/output/handoff_milestone2_20261008/source/rtl/audio/poly_voice.v
new file mode 100644
index 0000000..633ff37
--- /dev/null
+++ b/output/handoff_milestone2_20261008/source/rtl/audio/poly_voice.v
@@ -0,0 +1,66 @@
+// 一个独立声部：DDS 相位/波表、ADSR 包络和力度缩放；四声部由顶层并行实例化。
+// 当前每声部有插值、包络、力度三处乘法，四声部综合为 12 个 MULT18X18；
+// 增加声部前须重新核对 BSRAM、乘法器和时序，不能只修改顶层声部数量。
+// gate 表示键仍按下，idle 表示释音已结束，两者含义不同。
+module poly_voice (
+    input  wire               clk,
+    input  wire               rst,
+    input  wire               sample_tick,
+    input  wire               gate,
+    input  wire               start,         // one clk pulse from the allocator
+    input  wire        [31:0] phase_inc,
+    input  wire        [7:0]  velocity,     // 0 .. 127
+    output wire signed [15:0] sample,
+    output wire               idle          // envelope is back at zero
+);
+
+    wire signed [15:0] osc_sample;
+    wire        [15:0] env;
+    reg                start_pending;
+    wire               restart_sample = gate & (start | start_pending);
+
+    // 分配器 start 只有一个 clk，事件未必对齐音频采样点，因此暂存到 sample_tick。
+    // 相位和包络在同一采样点重启；此前已松键时 gate 会阻止迟到的重启。
+    // 同一采样点前的多次重按合并为一次重启；最新音高/力度由分配器寄存值提供。
+    always @(posedge clk) begin
+        if (rst)
+            start_pending <= 1'b0;
+        else if (sample_tick)
+            start_pending <= 1'b0;
+        else if (start)
+            start_pending <= 1'b1;
+    end
+
+    dds_osc u_dds (
+        .clk         (clk),
+        .rst         (rst),
+        .sample_tick (sample_tick),
+        .retrigger   (restart_sample),
+        .phase_inc   (phase_inc),
+        .sample      (osc_sample)
+    );
+
+    adsr u_adsr (
+        .clk         (clk),
+        .rst         (rst),
+        .sample_tick (sample_tick),
+        .gate        (gate),
+        .retrigger   (restart_sample),
+        .env         (env),
+        .idle        (idle)
+    );
+
+    // osc 为 signed 16 位、env 为 unsigned 16 位（0..65535）；先分别符号/零扩展。
+    // 32 位 signed 乘积可容纳全范围，取 [31:16] 相当于算术除以 65536。
+    wire signed [31:0] osc_ext = {{16{osc_sample[15]}}, osc_sample};
+    wire signed [31:0] env_ext = {16'd0, env};
+    wire signed [31:0] env_mul = osc_ext * env_ext;
+    wire signed [15:0] voiced  = env_mul[31:16];
+
+    // 上游约定 velocity=0..127；此处除以 128，最大力度为 127/128，无四舍五入。
+    // 本模块未钳制 128..255，输入边界须由命令解析器/未来外设适配器负责。
+    wire signed [31:0] vel_mul = voiced * $signed({1'b0, velocity});
+
+    assign sample = vel_mul[22:7];
+
+endmodule
diff --git a/output/handoff_milestone2_20261008/source/rtl/audio/pressure_bend.v b/output/handoff_milestone2_20261008/source/rtl/audio/pressure_bend.v
new file mode 100644
index 0000000..a87197c
--- /dev/null
+++ b/output/handoff_milestone2_20261008/source/rtl/audio/pressure_bend.v
@@ -0,0 +1,149 @@
+// S5 control path: bounded pressure filtering and a continuous +/-2 semitone
+// pitch bend.  The control inputs are sampled only on control_tick (normally
+// a 2 kHz scheduler); the audio phase increment is combinational, so changing
+// the potentiometer does not retrigger a voice envelope.
+//
+// pressure_filtered is a three-sample median followed by the fixed-point IIR
+// y += (median - y) >>> 1.  pressure_level is zero when pressure_enable is
+// low, but the filter state is still updated so enabling it does not inject an
+// old stale sample.  Pressure is deliberately not part of phase_inc_out.
+//
+// bend_q8 is signed semitones in Q8: -512 .. +512 means -2 .. +2 semitones.
+// bend_ratio_q16 is a piecewise-linear interpolation between the five semitone
+// anchors at -2,-1,0,+1,+2 (within 0.8 cent of 2^(n/12), see the table below).
+// phase_inc_out = base_phase_inc * ratio.
+module pressure_bend #(
+    parameter [11:0] ADC_CENTER = 12'd2048
+) (
+    input  wire               clk,
+    input  wire               rst,
+    input  wire               control_tick,
+    input  wire [11:0]        pressure_adc,
+    input  wire [11:0]        bend_adc,
+    input  wire               pressure_enable,
+    input  wire [31:0]        base_phase_inc,
+    output reg  [11:0]        pressure_filtered,
+    output wire [11:0]        pressure_level,
+    output reg  signed [15:0] bend_q8,
+    output wire [16:0]        bend_ratio_q16,
+    output wire [31:0]        phase_inc_out
+);
+
+    reg [11:0] pressure_d0;
+    reg [11:0] pressure_d1;
+
+    // Median is combinational from the two delayed samples and the current
+    // sample.  The explicit comparisons avoid relying on a simulator's sort.
+    wire [11:0] pressure_median =
+        ((pressure_d0 <= pressure_d1) && (pressure_d1 <= pressure_adc)) ? pressure_d1 :
+        ((pressure_adc <= pressure_d1) && (pressure_d1 <= pressure_d0)) ? pressure_d1 :
+        ((pressure_d1 <= pressure_d0) && (pressure_d0 <= pressure_adc)) ? pressure_d0 :
+        ((pressure_adc <= pressure_d0) && (pressure_d0 <= pressure_d1)) ? pressure_d0 :
+        pressure_adc;
+
+    wire signed [12:0] pressure_diff =
+        $signed({1'b0, pressure_median}) - $signed({1'b0, pressure_filtered});
+    wire signed [12:0] pressure_step = pressure_diff >>> 1;
+    wire signed [13:0] pressure_next_ext =
+        $signed({1'b0, pressure_filtered}) + pressure_step;
+
+    // Half range denominators.  Deriving them from ADC_CENTER keeps the
+    // +/-2 semitone endpoints correct if the midpoint is ever changed, and the
+    // guards keep an out-of-range parameter from dividing by zero.  Both are
+    // elaboration time constants: 2048 is a shift and only the 2047 side
+    // below needs a real divider.
+    localparam [11:0] ADC_FULL = 12'hFFF;
+    localparam integer BEND_POS_DEN = (ADC_FULL > ADC_CENTER) ? (ADC_FULL - ADC_CENTER) : 1;
+    localparam integer BEND_NEG_DEN = (ADC_CENTER > 0) ? ADC_CENTER : 1;
+
+    // Use 32-bit operands so the multiply does not accidentally truncate in
+    // Verilog's self-determined expression width rules.
+    wire [31:0] bend_pos_num =
+        ({20'd0, bend_adc} - {20'd0, ADC_CENTER}) * 32'd512;
+    wire [31:0] bend_neg_num =
+        ({20'd0, ADC_CENTER} - {20'd0, bend_adc}) * 32'd512;
+    wire [31:0] bend_pos_q8 = bend_pos_num / BEND_POS_DEN;
+    wire [31:0] bend_neg_q8 = bend_neg_num / BEND_NEG_DEN;
+    wire signed [15:0] bend_mapped =
+        (bend_adc >= ADC_CENTER) ? $signed(bend_pos_q8[15:0]) :
+                                     -$signed(bend_neg_q8[15:0]);
+
+    always @(posedge clk) begin
+        if (rst) begin
+            pressure_d0      <= 12'd0;
+            pressure_d1      <= 12'd0;
+            pressure_filtered <= 12'd0;
+            bend_q8          <= 16'sd0;
+        end else if (control_tick) begin
+            pressure_d1 <= pressure_d0;
+            pressure_d0 <= pressure_adc;
+
+            // Inputs and state are non-negative.  Clamp explicitly so a
+            // future parameter change cannot create a signed wraparound.
+            if (pressure_next_ext < 0)
+                pressure_filtered <= 12'd0;
+            else if (pressure_next_ext > 14'sd4095)
+                pressure_filtered <= 12'd4095;
+            else
+                pressure_filtered <= pressure_next_ext[11:0];
+
+            bend_q8 <= bend_mapped;
+        end
+    end
+
+    assign pressure_level = pressure_enable ? pressure_filtered : 12'd0;
+
+    // Semitone ratios in Q16 for -2,-1,0,+1,+2 semitones.  -1 and 0 equal the
+    // rounded 2^(n/12) values; -2 is +0.42 cent and +1/+2 are -0.77/-0.75 cent
+    // away from 2^(n/12), so the whole bend range stays within 0.8 cent.  The
+    // deviation is reported per anchor by tools/pressure_bend_ref.py; use
+    // 58386/61858/65536/69433/73562 instead if the anchors must equal the
+    // rounded semitone ratios exactly.
+    function [16:0] ratio_at;
+        input [2:0] idx;
+        begin
+            case (idx)
+                3'd0: ratio_at = 17'd58400;
+                3'd1: ratio_at = 17'd61858;
+                3'd2: ratio_at = 17'd65536;
+                3'd3: ratio_at = 17'd69402;
+                default: ratio_at = 17'd73530;
+            endcase
+        end
+    endfunction
+
+    reg [10:0] bend_u;
+    reg [2:0]  ratio_seg;
+    reg [7:0]  ratio_frac;
+    reg [16:0] ratio_a;
+    reg [16:0] ratio_b;
+    reg [31:0] ratio_delta_frac;
+    reg [16:0] ratio_interp;
+
+    always @* begin
+        // bend_q8 is bounded to [-512,+512], therefore bend_u is 0..1024.
+        bend_u = $signed(bend_q8) + 11'd512;
+        if (bend_u >= 11'd1024) begin
+            ratio_seg  = 3'd4;
+            ratio_frac = 8'd0;
+        end else begin
+            ratio_seg  = bend_u[10:8];
+            ratio_frac = bend_u[7:0];
+        end
+        ratio_a = ratio_at(ratio_seg);
+        ratio_b = ratio_at(ratio_seg + 3'd1);
+        ratio_delta_frac = (ratio_b - ratio_a) * ratio_frac;
+        ratio_interp = ratio_a + (ratio_delta_frac >> 8);
+    end
+
+    assign bend_ratio_q16 = ratio_interp;
+
+    // 32x17 -> 49 bit product.  Both operands are widened explicitly: letting
+    // the assignment context extend a multiply is tool dependent, and a tool
+    // that keeps the self determined 32 bit result would drop the high half of
+    // the product (1_000_000 * 65536 would come back as 16960 instead of
+    // 1_000_000).  The Q16 truncation below matches the reference.
+    wire [48:0] phase_product = {17'd0, base_phase_inc} * {32'd0, bend_ratio_q16};
+    assign phase_inc_out = phase_product >> 16;
+
+endmodule
