+  checked=checked+1;
+  if(a%127==0)begin
+   @(negedge clk);ce=0;bank=(b+13)%48;addr=511-a;
+   @(posedge clk);#1;
+   if(data!==want)$fatal(1,"ROM_CE_hold_selected_wrong_group bank=%0d addr=%0d",b,a);
+   stalls=stalls+1;
+  end
