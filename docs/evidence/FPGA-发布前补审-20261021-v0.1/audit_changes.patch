+     end
+     state<=INTERP_S;
+    end
+    INTERP_S:begin interp_s<=($signed(a_sine) <<<8)+interp_delta;state<=INTERP_B;end
+    INTERP_B:begin interp_b<=($signed(a_bright) <<<8)+interp_delta;state<=BANK_ADDR_A;end
