diff --git a/tools/verify_build_profiles.py b/tools/verify_build_profiles.py
index 993e5bb..15a429e 100644
--- a/tools/verify_build_profiles.py
+++ b/tools/verify_build_profiles.py
@@ -85,9 +85,19 @@ close $fh
     fake = work/'mock-gw.ps1'
     fake.write_text('''param([string]$Entry)
 if ($env:FPGA_TEST_BUILD_FAIL -eq '1') { exit 9 }
+# Optional in-place mutation during a build: same length, original timestamp.
+if ($env:FPGA_TEST_MUTATE_FILE) {
+    $path = $env:FPGA_TEST_MUTATE_FILE
+    $bytes = [System.IO.File]::ReadAllBytes($path)
+    $stamp = (Get-Item -LiteralPath $path).LastWriteTimeUtc
+    $bytes[$bytes.Length - 2] = $bytes[$bytes.Length - 2] -bxor 0x01
+    [System.IO.File]::WriteAllBytes($path, $bytes)
+    (Get-Item -LiteralPath $path).LastWriteTimeUtc = $stamp
+}
 $pnr = Join-Path $env:FPGA_BUILD_RUN_DIR 'instrument/impl/pnr'
 New-Item -ItemType Directory -Path $pnr -Force | Out-Null
 Set-Content -LiteralPath (Join-Path $pnr 'instrument.fs') -Value 'MOCK BITSTREAM - NOT FOR HARDWARE'
+Set-Content -LiteralPath (Join-Path $pnr 'instrument.rpt.txt') -Value '<Tool Version>: MOCK 1.9.99'
 exit 0
 ''')
     programmer = work/'mock-programmer.ps1'
@@ -99,6 +109,11 @@ exit 0
     for profile in ['debug','standard']:
         execute(profile+'-wrapper-build', [*base,build/'build.ps1','-Profile',profile,'-GwSh',fake],env=env)
         receipt = json.loads((build/'receipts'/f'{profile}.json').read_text(encoding='utf-8-sig'))
+        # The receipt must bind inputs, tool version and bitstream content.
+        assert len(receipt['BitstreamSha256']) == 64, 'receipt missing bitstream SHA256'
+        assert len(receipt['InputsDigest']) == 64, 'receipt missing input digest'
+        assert all(len(i['Sha256']) == 64 for i in receipt['Inputs']), 'input without SHA256'
+        assert receipt['Tool']['Version'] == 'MOCK 1.9.99', 'tool version not bound'
         execute(profile+'-program-selection', [*base,build/'program_sram.ps1','-Profile',profile,
             '-Programmer',programmer],env=env)
         assert receipt['Bitstream'] in (work/'program-args.txt').read_text()
@@ -108,11 +123,47 @@ exit 0
     legacy.parent.mkdir(parents=True,exist_ok=True)
     legacy.write_text('OLD BITSTREAM')
     changed = fixture/'rtl/top.v'
-    changed.write_bytes(changed.read_bytes()+b'\n// changed after build\n')
+    original = changed.read_bytes()
+    stamp = changed.stat()
+    if (work/'program-args.txt').exists():
+        (work/'program-args.txt').unlink()
+    program = lambda profile: [*base,build/'program_sram.ps1','-Profile',profile,'-Programmer',programmer]
+    restore = lambda: (changed.write_bytes(original),
+                       os.utime(changed, ns=(stamp.st_atime_ns, stamp.st_mtime_ns)))
+
+    # 1) A size-changing edit invalidates the successful build.
+    changed.write_bytes(original+b'\n// changed after build\n')
+    execute('changed-source-rejected', program('standard'), env=env, expect=None)
+    assert not (work/'program-args.txt').exists()
+    restore()
+
+    # 2) Touch-only: new timestamp, identical bytes. Content binding keeps the
+    #    receipt usable, so the build is not invalidated by metadata alone.
+    os.utime(changed, ns=(stamp.st_atime_ns+10**9, stamp.st_mtime_ns+10**9))
+    execute('touch-only-accepted', program('standard'), env=env)
+    assert (work/'program-args.txt').exists()
     (work/'program-args.txt').unlink()
-    execute('changed-source-rejected', [*base,build/'program_sram.ps1','-Profile','standard',
-        '-Programmer',programmer],env=env,expect=None)
+    restore()
+
+    # 3) Same length and the original timestamp, different bytes: the case the
+    #    old size+mtime fingerprint silently missed.
+    mutated = bytearray(original)
+    mutated[len(mutated)-2] ^= 0x01
+    changed.write_bytes(bytes(mutated))
+    os.utime(changed, ns=(stamp.st_atime_ns, stamp.st_mtime_ns))
+    now = changed.stat()
+    assert now.st_size == len(original), 'mutation changed the length'
+    assert now.st_mtime_ns == stamp.st_mtime_ns, 'mutation changed the timestamp'
+    execute('same-size-same-mtime-source-rejected', program('standard'), env=env, expect=None)
     assert not (work/'program-args.txt').exists()
+    restore()
+
+    # 4) The same edit happening during a build must abort the receipt, so a
+    #    mixed build can never be programmed.
+    execute('same-size-same-mtime-build-guard', [*base,build/'build.ps1','-Profile','debug',
+        '-GwSh',fake], env=dict(env, FPGA_TEST_MUTATE_FILE=str(changed)), expect=None)
+    assert not (build/'receipts/debug.json').exists(), 'guard accepted mutated inputs'
+    restore()
     execute('failed-build-reported', [*base,build/'build.ps1','-Profile','debug','-GwSh',fake],
         env=dict(env,FPGA_TEST_BUILD_FAIL='1'),expect=None)
     assert not (build/'receipts/debug.json').exists()
